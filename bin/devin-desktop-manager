info() {
  printf 'devin-desktop-manager: %s\n' "$*" >&2
}

warn() {
  printf 'devin-desktop-manager: warning: %s\n' "$*" >&2
}

die() {
  printf 'devin-desktop-manager: error: %s\n' "$*" >&2
  exit 1
}

usage_die() {
  printf 'devin-desktop-manager: error: %s\n' "$*" >&2
  exit 2
}

preflight_reset() {
  PREFLIGHT_SEVERITIES=()
  PREFLIGHT_CATEGORIES=()
  PREFLIGHT_KEYS=()
  PREFLIGHT_PURPOSES=()
  PREFLIGHT_OBSERVED=()
  PREFLIGHT_REMEDIATIONS=()
  PREFLIGHT_LIMIT_EXCEEDED=false
}

preflight_add() {
  local severity="$1"
  local category="$2"
  local key="$3"
  local purpose="$4"
  local observed="$5"
  local remediation="$6"
  local existing
  local LC_ALL=C

  for existing in "${PREFLIGHT_KEYS[@]}"; do
    [[ "${existing}" != "${key}" ]] || return 0
  done
  if ((${#PREFLIGHT_KEYS[@]} >= 64)); then
    PREFLIGHT_LIMIT_EXCEEDED=true
    return 0
  fi
  PREFLIGHT_SEVERITIES+=("${severity}")
  PREFLIGHT_CATEGORIES+=("${category}")
  PREFLIGHT_KEYS+=("${key}")
  PREFLIGHT_PURPOSES+=("${purpose:0:512}")
  PREFLIGHT_OBSERVED+=("${observed:0:512}")
  PREFLIGHT_REMEDIATIONS+=("${remediation:0:512}")
}

preflight_enforce_aggregate_limit() {
  local count=${#PREFLIGHT_KEYS[@]}
  local total index
  local LC_ALL=C

  total=$((17 + ${#count}))
  for ((index = 0; index < count; index++)); do
    total=$((total +
      ${#PREFLIGHT_SEVERITIES[index]} +
      ${#PREFLIGHT_CATEGORIES[index]} +
      ${#PREFLIGHT_KEYS[index]} +
      ${#PREFLIGHT_PURPOSES[index]} +
      ${#PREFLIGHT_OBSERVED[index]} +
      ${#PREFLIGHT_REMEDIATIONS[index]} + 6))
  done
  if [[ "${PREFLIGHT_LIMIT_EXCEEDED}" != true ]] && ((total <= 32768)); then
    return 0
  fi

  PREFLIGHT_SEVERITIES=(blocker)
  PREFLIGHT_CATEGORIES=(environment)
  PREFLIGHT_KEYS=(diagnostic.output-limit)
  PREFLIGHT_PURPOSES=("diagnostic output exceeded safe limit")
  PREFLIGHT_OBSERVED=("")
  PREFLIGHT_REMEDIATIONS=("Correct the reported environment and retry.")
  PREFLIGHT_LIMIT_EXCEEDED=true
}

preflight_command_missing() {
  local key="$1"
  local purpose="$2"

  preflight_add blocker command "command.${key}" \
    "${purpose}" "missing command: ${key}" \
    "Install a compatible ${key} command using your distribution documentation."
}

preflight_command_incompatible() {
  local key="$1"
  local purpose="$2"

  preflight_add blocker command "command.${key}" \
    "${purpose}" "incompatible command: ${key}" \
    "Install a compatible ${key} command using your distribution documentation."
}

preflight_probe_command() {
  local command_name="$1"
  local purpose="$2"
  local output=""

  if ! command -v "${command_name}" >/dev/null 2>&1; then
    preflight_command_missing "${command_name}" "${purpose}"
    return
  fi

  case "${command_name}" in
    readlink)
      output="$(LC_ALL=C readlink -m -- / 2>/dev/null || true)"
      [[ "${output}" == "/" ]] ||
        preflight_command_incompatible readlink "${purpose}"
      ;;
    stat)
      output="$(LC_ALL=C stat -c '%h' -- /dev/null 2>/dev/null || true)"
      [[ "${output}" =~ ^[0-9]+$ ]] ||
        preflight_command_incompatible stat "${purpose}"
      ;;
    mv)
      output="$(LC_ALL=C mv --help 2>/dev/null || true)"
      [[ "${output}" == *"--no-target-directory"* ]] ||
        preflight_command_incompatible mv "${purpose}"
      ;;
    timeout)
      LC_ALL=C timeout --signal=TERM --kill-after=1s 1s \
        bash -c 'exit 0' </dev/null >/dev/null 2>&1 ||
        preflight_command_incompatible timeout "${purpose}"
      ;;
    find)
      LC_ALL=C find /dev/null -mindepth 0 -maxdepth 0 -print0 \
        </dev/null >/dev/null 2>&1 ||
        preflight_command_incompatible find "${purpose}"
      ;;
    curl)
      output="$(LC_ALL=C curl --disable --version </dev/null 2>/dev/null || true)"
      [[ "${output}" == *"Protocols:"* && "${output}" == *"https"* ]] ||
        preflight_command_incompatible curl "${purpose}"
      ;;
    jq)
      LC_ALL=C jq -n -e '([1, 2] | length) == 2' \
        </dev/null >/dev/null 2>&1 ||
        preflight_command_incompatible jq "${purpose}"
      ;;
    bsdtar)
      output="$(LC_ALL=C bsdtar --version </dev/null 2>/dev/null || true)"
      [[ "${output,,}" == *"bsdtar"* || "${output,,}" == *"libarchive"* ]] ||
        preflight_command_incompatible bsdtar "${purpose}"
      ;;
    flock)
      output="$(LC_ALL=C flock --version </dev/null 2>/dev/null || true)"
      [[ "${output,,}" == *"flock"* ]] ||
        preflight_command_incompatible flock "${purpose}"
      ;;
  esac
}

preflight_check_commands() {
  local command_name

  for command_name in "$@"; do
    preflight_probe_command "${command_name}" "required by this runtime operation"
  done
}

preflight_capabilities_baseline() {
  preflight_check_commands uname ldd readlink
}

preflight_capabilities_status() {
  preflight_check_commands jq basename
}

preflight_capabilities_manifest_check() {
  preflight_check_commands curl jq awk cat basename stat mktemp cp chmod rm mv timeout
}

preflight_capabilities_download() {
  preflight_check_commands curl jq bsdtar sha256sum awk grep
}

preflight_capabilities_release_state() {
  preflight_check_commands jq sha256sum grep awk
}

preflight_capabilities_timed_mutation() {
  preflight_check_commands flock stat find timeout mv mktemp unshare cp chmod rm \
    mkdir ln rmdir cat cmp true
}

preflight_capabilities_untimed_mutation() {
  preflight_check_commands flock stat find mv mktemp cp chmod rm mkdir ln rmdir \
    cat cmp
}

preflight_capabilities_release_paths() {
  preflight_check_commands dirname basename
}

preflight_capabilities_desktop_integration() {
  preflight_check_commands desktop-file-validate update-desktop-database \
    update-mime-database xdg-mime
}

preflight_capabilities_doctor() {
  preflight_check_commands jq sha256sum grep awk stat find timeout unshare cat \
    true dirname basename
}

preflight_check_environment() {
  local name value

  for name in HOME XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME; do
    case "${name}" in
      HOME) value="${HOME_DIR}" ;;
      XDG_CACHE_HOME) value="${XDG_CACHE_HOME:-${HOME_DIR}/.cache}" ;;
      XDG_CONFIG_HOME) value="${CONFIG_HOME}" ;;
      XDG_DATA_HOME) value="${DATA_HOME}" ;;
      XDG_STATE_HOME) value="${STATE_HOME}" ;;
    esac
    if [[ -z "${value}" || "${value}" != /* ||
      "${value}" == *$'\n'* || "${value}" == *$'\r'* ||
      "${value}" == *$'\t'* || "${value}" == *$'\e'* ]]; then
      preflight_add blocker path "path.${name,,}" \
        "${name} must be set to an absolute path without control bytes" "${value}" \
        "Set ${name} to a safe absolute directory and retry."
    fi
  done
  if ((EUID == 0)); then
    preflight_add blocker environment environment.unprivileged \
      "the manager requires an unprivileged desktop user" "effective UID is 0" \
      "Run the command as an unprivileged desktop user."
  fi
}

preflight_check_network_environment() {
  if [[ -v HTTPS_PROXY && -v https_proxy &&
    "${HTTPS_PROXY}" != "${https_proxy}" ]]; then
    preflight_add blocker environment environment.https-proxy \
      "HTTPS proxy case variants must agree" "conflicting proxy settings" \
      "Set only HTTPS_PROXY or https_proxy, or give both the same value."
  fi
  if [[ -v NO_PROXY && -v no_proxy && "${NO_PROXY}" != "${no_proxy}" ]]; then
    preflight_add blocker environment environment.no-proxy \
      "proxy exclusion case variants must agree" "conflicting proxy exclusion settings" \
      "Set only NO_PROXY or no_proxy, or give both the same value."
  fi
}

preflight_mode_is_safe() {
  local mode="$1"

  [[ "${mode}" =~ ^[0-7]{3,4}$ ]] || return 1
  mode="${mode: -3}"
  [[ "${mode:1:1}" != [2367] && "${mode:2:1}" != [2367] ]]
}

preflight_check_ca_bundle() {
  local path="${CURL_CA_BUNDLE:-}"
  local owner links mode parent

  [[ -n "${path}" ]] || return 0
  if [[ "${path}" != /* || ! -f "${path}" || -L "${path}" || ! -r "${path}" ]]; then
    preflight_add blocker path path.curl-ca-bundle \
      "CURL_CA_BUNDLE must name a safe absolute CA file" "unsafe CA bundle setting" \
      "Use the system trust store or a protected absolute regular CA file."
    return
  fi
  owner="$(stat -c '%u' -- "${path}" 2>/dev/null || true)"
  links="$(stat -c '%h' -- "${path}" 2>/dev/null || true)"
  mode="$(stat -c '%a' -- "${path}" 2>/dev/null || true)"
  if { [[ "${owner}" != 0 && "${owner}" != "${EUID}" ]]; } ||
    [[ "${links}" != 1 ]] || ! preflight_mode_is_safe "${mode}"; then
    preflight_add blocker path path.curl-ca-bundle \
      "CURL_CA_BUNDLE must be protected from replacement" "unsafe CA bundle metadata" \
      "Use the system trust store or a protected root/current-user CA file."
    return
  fi
  parent="${path%/*}"
  [[ -n "${parent}" ]] || parent=/
  while :; do
    owner="$(stat -c '%u' -- "${parent}" 2>/dev/null || true)"
    mode="$(stat -c '%a' -- "${parent}" 2>/dev/null || true)"
    if [[ -L "${parent}" || ! -d "${parent}" ]] ||
      { [[ "${owner}" != 0 && "${owner}" != "${EUID}" ]]; } ||
      ! preflight_mode_is_safe "${mode}"; then
      preflight_add blocker path path.curl-ca-bundle \
        "CURL_CA_BUNDLE ancestors must be protected" "unsafe CA bundle ancestor" \
        "Move the CA file beneath protected root/current-user directories."
      return
    fi
    [[ "${parent}" != / ]] || break
    parent="${parent%/*}"
    [[ -n "${parent}" ]] || parent=/
  done
}

preflight_check_platform() {
  local kernel="" architecture="" libc=""

  if command -v uname >/dev/null 2>&1; then
    kernel="$(LC_ALL=C uname -s 2>/dev/null || true)"
    architecture="$(LC_ALL=C uname -m 2>/dev/null || true)"
    [[ "${kernel}" == "Linux" ]] ||
      preflight_add blocker platform platform.linux \
        "the manager supports native Linux" "${kernel:-unknown kernel}" \
        "Use a supported native glibc Linux x86_64 host."
    [[ "${architecture}" == "x86_64" ]] ||
      preflight_add blocker platform platform.x86-64 \
        "the official release requires x86_64" "${architecture:-unknown architecture}" \
        "Use a supported native glibc Linux x86_64 host."
  fi
  if command -v ldd >/dev/null 2>&1; then
    libc="$(LC_ALL=C ldd --version </dev/null 2>&1 | { IFS= read -r line; printf '%s' "${line}"; } || true)"
    [[ "${libc}" == *"GLIBC"* || "${libc}" == *"GNU libc"* ]] ||
      preflight_add blocker platform platform.glibc \
        "the manager requires glibc" "${libc:-unrecognized libc evidence}" \
        "Use a supported native glibc Linux x86_64 host."
  fi
}

preflight_collect() {
  local profile="$1"

  preflight_reset
  preflight_check_environment
  preflight_capabilities_baseline
  preflight_check_platform
  case "${profile}" in
    status)
      preflight_capabilities_status
      ;;
    check)
      preflight_capabilities_manifest_check
      preflight_check_network_environment
      preflight_check_ca_bundle
      ;;
    update)
      preflight_capabilities_download
      preflight_capabilities_timed_mutation
      preflight_check_commands date
      preflight_capabilities_release_paths
      preflight_capabilities_desktop_integration
      preflight_check_network_environment
      preflight_check_ca_bundle
      ;;
    rollback)
      preflight_capabilities_release_state
      preflight_capabilities_timed_mutation
      preflight_capabilities_release_paths
      preflight_capabilities_desktop_integration
      ;;
    set-defaults)
      preflight_capabilities_release_state
      preflight_capabilities_untimed_mutation
      preflight_capabilities_release_paths
      preflight_capabilities_desktop_integration
      ;;
    doctor)
      preflight_capabilities_doctor
      preflight_capabilities_desktop_integration
      if ! command -v kbuildsycoca6 >/dev/null 2>&1; then
        preflight_add warning optional optional.kde-cache \
          "KDE launcher cache refresh is optional" "kbuildsycoca6 is not installed" \
          "No action is needed outside KDE; KDE users can refresh their launcher cache manually."
      fi
      ;;
    uninstall|uninstall-yes)
      preflight_capabilities_release_state
      preflight_capabilities_untimed_mutation
      preflight_capabilities_release_paths
      preflight_capabilities_desktop_integration
      if [[ "${profile}" == "uninstall" && ! -t 0 ]]; then
        preflight_add blocker interaction interaction.terminal \
          "interactive uninstall requires a terminal" "standard input is not a terminal" \
          "Use make uninstall-yes for prompt-free automation."
      fi
      ;;
    *) return 2 ;;
  esac
}

preflight_emit_protocol() {
  local index count

  preflight_enforce_aggregate_limit
  count=${#PREFLIGHT_KEYS[@]}
  printf 'DDM-PREFLIGHT\0%s\0%s\0' 1 "${count}"
  for ((index = 0; index < count; index++)); do
    printf '%s\0%s\0%s\0%s\0%s\0%s\0' \
      "${PREFLIGHT_SEVERITIES[index]}" \
      "${PREFLIGHT_CATEGORIES[index]}" \
      "${PREFLIGHT_KEYS[index]}" \
      "${PREFLIGHT_PURPOSES[index]}" \
      "${PREFLIGHT_OBSERVED[index]}" \
      "${PREFLIGHT_REMEDIATIONS[index]}"
  done
}

preflight_escape() {
  local value="$1" output="" byte hex index

  LC_ALL=C
  for ((index = 0; index < ${#value} && index < 512; index++)); do
    byte="${value:index:1}"
    case "${byte}" in
      $'\t') output+='\t' ;;
      $'\n') output+='\n' ;;
      $'\r') output+='\r' ;;
      $'\\') output+=$'\\\\' ;;
      [\ -~]) output+="${byte}" ;;
      *)
        printf -v hex '%02x' "'${byte}"
        output+="\\x${hex}"
        ;;
    esac
  done
  ((${#value} <= 512)) || output+='...[truncated]'
  printf '%s' "${output}"
}

preflight_render() {
  local profile="$1" index label observed remediation

  preflight_enforce_aggregate_limit
  for ((index = 0; index < ${#PREFLIGHT_KEYS[@]}; index++)); do
    if [[ "${PREFLIGHT_SEVERITIES[index]}" == blocker ]]; then
      label=error
    else
      label=warning
    fi
    observed="$(preflight_escape "${PREFLIGHT_OBSERVED[index]}")"
    remediation="$(preflight_escape "${PREFLIGHT_REMEDIATIONS[index]}")"
    printf 'devin-desktop-manager: %s: %s: %s (%s). %s\n' \
      "${profile}" "${label}" "${PREFLIGHT_PURPOSES[index]}" \
      "${observed}" "${remediation}" >&2
  done
}

preflight_has_blockers() {
  local severity

  for severity in "${PREFLIGHT_SEVERITIES[@]}"; do
    [[ "${severity}" != blocker ]] || return 0
  done
  return 1
}

run_public_preflight() {
  local profile="$1"

  preflight_collect "${profile}" || return 2
  preflight_render "${profile}"
  ! preflight_has_blockers
}

sanitize_network_environment() {
  unset ALL_PROXY all_proxy HTTP_PROXY http_proxy CURL_HOME NETRC \
    SSL_CERT_FILE SSL_CERT_DIR SSLKEYLOGFILE CURL_CA_BUNDLE
}

prepare_network_environment() {
  local bundle="${CURL_CA_BUNDLE:-}"
  local path_identity fd_identity

  CURL_CA_OPTIONS=()
  if [[ -n "${bundle}" ]]; then
    path_identity="$(stat -c '%d %i' -- "${bundle}")" || return 1
    exec 6<"${bundle}" || return 1
    fd_identity="$(stat -Lc '%d %i' -- /proc/self/fd/6)" || return 1
    [[ "${path_identity}" == "${fd_identity}" ]] || return 1
    CURL_CA_SNAPSHOT="$(mktemp "${TMPDIR:-/tmp}/devin-desktop-manager.ca.XXXXXXXX")" ||
      return 1
    chmod 0600 "${CURL_CA_SNAPSHOT}" || return 1
    cp -- /proc/self/fd/6 "${CURL_CA_SNAPSHOT}" || return 1
    [[ "$(stat -c '%d %i' -- "${bundle}")" == "${path_identity}" ]] || return 1
    exec 6<&-
    CURL_CA_OPTIONS=(--cacert "${CURL_CA_SNAPSHOT}")
  fi
  sanitize_network_environment
}

network_url_is_allowed() {
  local url="$1"

  [[ "${url}" == https://windsurf-stable.codeium.com/* ||
    "${url}" == https://windsurf-stable.codeiumdata.com/* ]]
}

curl_fetch_file() {
  local url="$1"
  local destination="$2"
  local maximum_bytes="$3"
  local maximum_time="$4"
  local resume="${5:-false}"
  local keep_partial="${6:-false}"
  local header response status location offset=0 remaining response_size final_size hop
  local curl_status remaining_time started_at="${SECONDS}"
  local -a resume_options=()

  network_url_is_allowed "${url}" || return 1
  if [[ "${resume}" == true && -f "${destination}" ]]; then
    offset="$(stat -c '%s' -- "${destination}")" || return 1
    ((offset < maximum_bytes)) || return 1
    ((offset == 0)) || resume_options=(--continue-at "${offset}")
  fi
  remaining=$((maximum_bytes - offset))
  for ((hop = 0; hop <= 5; hop++)); do
    remaining_time=$((maximum_time - (SECONDS - started_at)))
    ((remaining_time > 0)) || return 1
    header="$(mktemp "${TMPDIR:-/tmp}/devin-desktop-manager.header.XXXXXXXX")" ||
      return 1
    NETWORK_HEADER_TEMP="${header}"
    response="$(mktemp "${destination}.response.XXXXXXXX")" || {
      rm -f -- "${header}"
      NETWORK_HEADER_TEMP=""
      return 1
    }
    NETWORK_RESPONSE_TEMP="${response}"
    if timeout --signal=TERM --kill-after=1s "${remaining_time}s" \
      curl "${CURL_SECURITY_OPTIONS[@]}" "${CURL_CA_OPTIONS[@]}" \
      --silent --show-error --max-time "${remaining_time}" \
      --retry-max-time "${remaining_time}" \
      --max-filesize "${remaining}" --dump-header "${header}" \
      "${resume_options[@]}" --output "${response}" "${url}"; then
      :
    else
      curl_status=$?
      rm -f -- "${header}"
      NETWORK_HEADER_TEMP=""
      if ((curl_status == 63)); then
        rm -f -- "${response}"
        NETWORK_RESPONSE_TEMP=""
        return "${CURL_FETCH_SIZE_LIMIT_STATUS}"
      fi
      if [[ "${keep_partial}" == true ]]; then
        response_size="$(stat -c '%s' -- "${response}" 2>/dev/null || printf 0)"
        if ((response_size > 0 && response_size <= remaining &&
          offset + response_size <= maximum_bytes)); then
          if ((offset > 0)); then
            if [[ "$(stat -c '%s' -- "${destination}" 2>/dev/null || true)" == "${offset}" ]] &&
              cat -- "${response}" >>"${destination}"; then
              final_size="$(stat -c '%s' -- "${destination}" 2>/dev/null || printf 0)"
              if ((final_size != offset + response_size || final_size > maximum_bytes)); then
                rm -f -- "${response}"
                NETWORK_RESPONSE_TEMP=""
                return 1
              fi
            fi
          else
            if mv -Tf -- "${response}" "${destination}"; then
              NETWORK_RESPONSE_TEMP=""
            fi
          fi
        fi
      fi
      rm -f -- "${response}"
      NETWORK_RESPONSE_TEMP=""
      return 1
    fi
    status="$(awk '/^HTTP\/[0-9.]+ [0-9][0-9][0-9]/ { code=$2 } END { print code }' \
      "${header}")"
    case "${status}" in
      2??)
        response_size="$(stat -c '%s' -- "${response}")" || return 1
        ((response_size <= remaining && offset + response_size <= maximum_bytes)) || {
          rm -f -- "${header}" "${response}"
          NETWORK_HEADER_TEMP=""
          NETWORK_RESPONSE_TEMP=""
          return "${CURL_FETCH_SIZE_LIMIT_STATUS}"
        }
        if ((offset > 0)); then
          [[ "$(stat -c '%s' -- "${destination}")" == "${offset}" ]] || return 1
          cat -- "${response}" >>"${destination}" || {
            rm -f -- "${header}" "${response}"
            NETWORK_HEADER_TEMP=""
            NETWORK_RESPONSE_TEMP=""
            return 1
          }
          rm -f -- "${response}"
          NETWORK_RESPONSE_TEMP=""
          final_size="$(stat -c '%s' -- "${destination}")" || return 1
          ((final_size == offset + response_size && final_size <= maximum_bytes)) || return 1
        else
          mv -Tf -- "${response}" "${destination}" || {
            rm -f -- "${header}" "${response}"
            NETWORK_HEADER_TEMP=""
            NETWORK_RESPONSE_TEMP=""
            return 1
          }
          NETWORK_RESPONSE_TEMP=""
        fi
        rm -f -- "${header}"
        NETWORK_HEADER_TEMP=""
        return 0
        ;;
      3??)
        location="$(awk '
          {
            separator=index($0, ":")
            if (separator > 0 &&
              tolower(substr($0, 1, separator - 1)) == "location") {
              value=substr($0, separator + 1)
              sub(/^[[:space:]]*/, "", value)
              sub(/\r$/, "", value)
            }
          }
          END { print value }
        ' "${header}")"
        rm -f -- "${header}" "${response}"
        NETWORK_HEADER_TEMP=""
        NETWORK_RESPONSE_TEMP=""
        ((hop < 5)) || return 1
        network_url_is_allowed "${location}" || return 1
        url="${location}"
        ;;
      *)
        rm -f -- "${header}" "${response}"
        NETWORK_HEADER_TEMP=""
        NETWORK_RESPONSE_TEMP=""
        return 1
        ;;
    esac
  done
  return 1
}

cleanup() {
  local path

  for path in "${STAGING_PATH}" "${INTEGRATION_STAGE}"; do
    [[ -n "${path}" && -e "${path}" ]] || continue
    case "${path}" in
      "${INSTALL_ROOT}"/.staging-*|"${INSTALL_ROOT}"/.integration-*)
        rm -rf -- "${path}"
        ;;
      *)
        warn "refusing to clean unexpected temporary path: ${path}"
        ;;
    esac
  done
  case "${TRANSACTION_BACKUP}" in
    "${TRANSACTION_JOURNAL}".new.*)
      rm -rf -- "${TRANSACTION_BACKUP}"
      TRANSACTION_BACKUP=""
      TRANSACTION_BACKUP_READY=false
      ;;
  esac
  case "${CLEANUP_PROOF_TEMP}" in
    "${UNINSTALL_CLEANUP_PROOF}.new.$$"|\
      "${RELEASE_PRUNE_CLEANUP_PROOF}.new.$$")
      rm -f -- "${CLEANUP_PROOF_TEMP}"
      CLEANUP_PROOF_TEMP=""
      ;;
  esac
  if [[ -n "${RESTORE_TEMP_ROOT}" ]]; then
    case "$(basename "${RESTORE_TEMP_ROOT}")" in
      .devin-desktop-manager-restore.*)
        if [[ -d "${RESTORE_TEMP_ROOT}" && ! -L "${RESTORE_TEMP_ROOT}" && "$(stat -c '%u' -- "${RESTORE_TEMP_ROOT}" 2>/dev/null)" == "${EUID}" ]]; then
          rm -rf -- "${RESTORE_TEMP_ROOT}"
        else
          warn "refusing to clean unsafe restore temporary: ${RESTORE_TEMP_ROOT}"
        fi
        ;;
      *)
        warn "refusing to clean unexpected restore temporary: ${RESTORE_TEMP_ROOT}"
        ;;
    esac
    RESTORE_TEMP_ROOT=""
  fi
  if [[ -n "${CURL_CA_SNAPSHOT}" ]]; then
    rm -f -- "${CURL_CA_SNAPSHOT}" 2>/dev/null || true
    CURL_CA_SNAPSHOT=""
  fi
  if [[ -n "${NETWORK_HEADER_TEMP}" ]]; then
    rm -f -- "${NETWORK_HEADER_TEMP}" 2>/dev/null || true
    NETWORK_HEADER_TEMP=""
  fi
  if [[ -n "${NETWORK_RESPONSE_TEMP}" ]]; then
    rm -f -- "${NETWORK_RESPONSE_TEMP}" 2>/dev/null || true
    NETWORK_RESPONSE_TEMP=""
  fi
}

trap cleanup EXIT

handle_transaction_signal() {
  local status="$1"

  trap - INT TERM HUP
  if [[ -n "${TRANSACTION_BACKUP}" &&
    "${TRANSACTION_BACKUP_READY}" == "true" &&
    "${TRANSACTION_RESTORING}" != "true" &&
    "${TRANSACTION_DISCARDING}" != "true" ]]; then
    warn "operation interrupted; restoring the previous managed state"
    restore_transaction ||
      warn "automatic recovery failed; the next manager mutation will retry it"
  fi
  exit "${status}"
}

trap 'handle_transaction_signal 130' INT
trap 'handle_transaction_signal 143' TERM
trap 'handle_transaction_signal 129' HUP

usage() {
  cat <<'EOF'
Usage: devin-desktop-manager <command>

Manage the official stable Devin Desktop release without AUR or sudo.

Commands:
  install        Install the current official stable release (idempotent)
  status         Show locally installed current and rollback releases
  check          Check the official stable channel without changing files
  update         Install and activate the current official stable release
  rollback       Swap the current and previous releases
  set-defaults   Make Devin Desktop the default for its URL schemes/workspaces
  doctor         Validate the installation and desktop integration
  uninstall      Remove manager-owned files after confirmation
  uninstall-yes  Remove manager-owned files without prompting
  version        Show the manager version
  help           Show this help
EOF
}

dependency_hint() {
  cat >&2 <<'EOF'
Install the missing tools with your distribution package manager.
Debian/Ubuntu: curl jq libarchive-tools util-linux desktop-file-utils shared-mime-info xdg-utils
Arch Linux:    curl jq libarchive util-linux desktop-file-utils shared-mime-info xdg-utils
Fedora:        curl jq bsdtar util-linux desktop-file-utils shared-mime-info xdg-utils
See docs/INSTALL.md for details.
EOF
}

require_commands() {
  local command_name
  local -a missing=()

  for command_name in "$@"; do
    command -v "${command_name}" >/dev/null 2>&1 || missing+=("${command_name}")
  done

  if ((${#missing[@]} > 0)); then
    printf 'devin-desktop-manager: error: missing required commands: %s\n' \
      "${missing[*]}" >&2
    dependency_hint
    exit 1
  fi
}

require_manifest_commands() {
  require_commands curl jq
}

require_download_commands() {
  require_manifest_commands
  require_commands bsdtar sha256sum awk grep
}

require_release_commands() {
  require_commands jq sha256sum ldd readlink find timeout dirname stat awk
}

require_mutation_commands() {
  require_download_commands
  require_commands flock ldd readlink find mktemp timeout unshare
}

require_integration_commands() {
  require_commands desktop-file-validate update-desktop-database \
    update-mime-database xdg-mime
}

validate_absolute_directory() {
  local name="$1"
  local value="$2"

  [[ -n "${value}" && "${value}" == /* ]] ||
    die "${name} must be set to an absolute path"
  [[ "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] ||
    die "${name} contains an unsupported control character"
}

path_is_at_or_below() {
  local candidate="$1"
  local root="$2"
  local resolved_candidate resolved_root

  resolved_candidate="$(readlink -m -- "${candidate}")" || return 1
  resolved_root="$(readlink -m -- "${root}")" || return 1
  [[ "${resolved_candidate}" == "${resolved_root}" ||
    "${resolved_candidate}" == "${resolved_root}/"* ]]
}

validate_environment() {
  local xdg_name xdg_path resolved_xdg resolved_transaction_journal
  local resolved_install_root removed_root state_artifact

  validate_absolute_directory HOME "${HOME_DIR}"
  validate_absolute_directory XDG_CACHE_HOME \
    "${XDG_CACHE_HOME:-${HOME_DIR}/.cache}"
  validate_absolute_directory XDG_DATA_HOME \
    "${XDG_DATA_HOME:-${HOME_DIR}/.local/share}"
  validate_absolute_directory XDG_STATE_HOME \
    "${XDG_STATE_HOME:-${HOME_DIR}/.local/state}"
  validate_absolute_directory XDG_CONFIG_HOME \
    "${XDG_CONFIG_HOME:-${HOME_DIR}/.config}"
  resolved_transaction_journal="$(readlink -m -- "${TRANSACTION_JOURNAL}")" ||
    die "could not resolve the transaction journal path"
  resolved_install_root="$(readlink -m -- "${INSTALL_ROOT}")" ||
    die "could not resolve the installation root"
  for xdg_name in \
    XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CONFIG_HOME; do
    case "${xdg_name}" in
      XDG_CACHE_HOME) xdg_path="${XDG_CACHE_HOME:-${HOME_DIR}/.cache}" ;;
      XDG_DATA_HOME) xdg_path="${DATA_HOME}" ;;
      XDG_STATE_HOME) xdg_path="${STATE_HOME}" ;;
      XDG_CONFIG_HOME) xdg_path="${CONFIG_HOME}" ;;
    esac
    resolved_xdg="$(readlink -m -- "${xdg_path}")" ||
      die "could not resolve ${xdg_name}"
    case "${resolved_xdg}" in
      "${resolved_transaction_journal}.new."*|"${resolved_install_root}.uninstall-"*)
        die "${xdg_name} must not be a manager temporary cleanup root or a directory beneath it"
        ;;
    esac
    if path_is_at_or_below "${xdg_path}" "${INSTALL_ROOT}"; then
      die "${xdg_name} must not be the installation root or a directory beneath it"
    fi
    for removed_root in "${CACHE_ROOT}" "${STATE_DIR}"; do
      if path_is_at_or_below "${xdg_path}" "${removed_root}"; then
        die "${xdg_name} must not be a manager root removed by uninstall or a directory beneath it"
      fi
    done
    for state_artifact in \
      "${LOCK_FILE}" \
      "${TRANSACTION_JOURNAL}" \
      "${TRANSACTION_DISCARD}" \
      "${UNINSTALL_CLEANUP_RECORD}" \
      "${UNINSTALL_CLEANUP_PROOF}" \
      "${RELEASE_PRUNE_CLEANUP_RECORD}" \
      "${RELEASE_PRUNE_CLEANUP_PROOF}"; do
      if path_is_at_or_below "${xdg_path}" "${state_artifact}"; then
        die "${xdg_name} must not be a removable manager state artifact or a directory beneath it"
      fi
    done
  done
  if path_is_at_or_below "${STATE_DIR}" "${CACHE_ROOT}" ||
    path_is_at_or_below "${CACHE_ROOT}" "${STATE_DIR}"; then
    die "manager cache and state roots must not overlap"
  fi
}

validate_state_home_security() {
  local owner permissions group_mode other_mode

  [[ -d "${STATE_HOME}" && ! -L "${STATE_HOME}" ]] ||
    die "XDG_STATE_HOME must be a non-symbolic directory: ${STATE_HOME}"
  owner="$(stat -c '%u' -- "${STATE_HOME}")" ||
    die "could not inspect XDG_STATE_HOME ownership: ${STATE_HOME}"
  [[ "${owner}" == "${EUID}" ]] ||
    die "XDG_STATE_HOME must be owned by the current user: ${STATE_HOME}"
  permissions="$(stat -c '%a' -- "${STATE_HOME}")" ||
    die "could not inspect XDG_STATE_HOME permissions: ${STATE_HOME}"
  [[ "${permissions}" =~ ^[0-7]{3,4}$ ]] ||
    die "XDG_STATE_HOME has unsupported permissions: ${STATE_HOME}"
  permissions="${permissions: -3}"
  group_mode="${permissions:1:1}"
  other_mode="${permissions:2:1}"
  (((group_mode & 2) == 0 && (other_mode & 2) == 0)) ||
    die "XDG_STATE_HOME must not be writable by other users: ${STATE_HOME}"
}

validate_lock_parent_security() {
  local path="$1" label="$2" owner permissions group_mode other_mode

  [[ -d "${path}" && ! -L "${path}" ]] ||
    die "${label} parent must be a non-symbolic directory: ${path}"
  owner="$(stat -c '%u' -- "${path}")" || die "could not inspect ${label} parent: ${path}"
  [[ "${owner}" == "${EUID}" ]] ||
    die "${label} parent must be owned by the current user: ${path}"
  permissions="$(stat -c '%a' -- "${path}")" || die "could not inspect ${label} parent permissions: ${path}"
  permissions="${permissions: -3}"
  group_mode="${permissions:1:1}"
  other_mode="${permissions:2:1}"
  (((group_mode & 2) == 0 && (other_mode & 2) == 0)) ||
    die "${label} parent must not be writable by other users: ${path}"
}

validate_lock_descriptor_identity() {
  local fd="$1" expected="$2" label="$3"
  local path_identity descriptor_identity device inode owner file_type links

  [[ "${fd}" =~ ^[0-9]+$ && -e "/proc/self/fd/${fd}" ]] ||
    die "${label} lock descriptor ${fd} is not open"
  [[ -f "${expected}" && ! -L "${expected}" ]] ||
    die "${label} lock must be a non-symbolic regular file: ${expected}"
  path_identity="$(LC_ALL=C stat -Lc '%d:%i:%u:%F:%h' -- "${expected}")" ||
    die "could not inspect ${label} lock: ${expected}"
  descriptor_identity="$(LC_ALL=C stat -Lc '%d:%i:%u:%F:%h' -- "/proc/self/fd/${fd}")" ||
    die "could not inspect ${label} lock descriptor ${fd}"
  IFS=: read -r device inode owner file_type links <<<"${path_identity}"
  [[ "${path_identity}" == "${descriptor_identity}" && "${owner}" == "${EUID}" &&
    ( "${file_type}" == "regular file" || "${file_type}" == "regular empty file" ) &&
    ( "${links}" == 1 || ( "${label}" == "legacy manager lifecycle" && "${links}" == 2 ) ) ]] ||
    die "${label} lock descriptor ${fd} does not match its safe lock path: ${expected}"
}

validate_inherited_lock_descriptor() {
  local fd="$1" expected="$2" label="$3"

  [[ "${fd}" =~ ^[0-9]+$ && -e "/proc/self/fd/${fd}" ]] ||
    die "${label} lock descriptor ${fd} is not open"
  flock -n "${fd}" ||
    die "${ACTIVE_COMMAND}: another ${label} operation is active; do not delete the lock file; rerun the same command after it exits"
  validate_lock_descriptor_identity "${fd}" "${expected}" "${label}"
}

acquire_publication_lock() {
  local owner links

  require_commands flock stat
  mkdir -p -- "${BIN_DIR}"
  validate_lock_parent_security "${BIN_DIR}" "manager publication"
  if [[ ! -e "${PUBLICATION_LOCK}" && ! -L "${PUBLICATION_LOCK}" ]]; then
    (set -o noclobber; : >"${PUBLICATION_LOCK}") 2>/dev/null ||
      [[ -e "${PUBLICATION_LOCK}" || -L "${PUBLICATION_LOCK}" ]] ||
      die "could not create the manager publication lock: ${PUBLICATION_LOCK}"
  fi
  [[ -f "${PUBLICATION_LOCK}" && ! -L "${PUBLICATION_LOCK}" ]] ||
    die "manager publication lock must be a non-symbolic regular file: ${PUBLICATION_LOCK}"
  owner="$(stat -c '%u' -- "${PUBLICATION_LOCK}")" ||
    die "could not inspect the manager publication lock: ${PUBLICATION_LOCK}"
  links="$(stat -c '%h' -- "${PUBLICATION_LOCK}")" ||
    die "could not inspect the manager publication lock: ${PUBLICATION_LOCK}"
  [[ "${owner}" == "${EUID}" && "${links}" == 1 ]] ||
    die "manager publication lock must be current-user owned and have one link: ${PUBLICATION_LOCK}"
  exec 9<>"${PUBLICATION_LOCK}" ||
    die "could not open the manager publication lock: ${PUBLICATION_LOCK}"
  validate_lock_descriptor_identity 9 "${PUBLICATION_LOCK}" "manager publication"
  validate_inherited_lock_descriptor 9 "${PUBLICATION_LOCK}" "manager publication"
  PUBLICATION_LOCK_FD=9
}

ensure_not_root() {
  ((EUID != 0)) ||
    die "refusing to run as root; use an unprivileged desktop user"
}

ensure_supported_architecture() {
  [[ "$(uname -s)" == "Linux" ]] ||
    die "only Linux is supported"
  [[ "$(uname -m)" == "x86_64" ]] ||
    die "only the official Linux x86_64 stable build is supported"
}

ensure_user_namespaces() {
  require_commands unshare
  unshare --user --map-root-user true >/dev/null 2>&1 ||
    die "unprivileged user namespaces are unavailable; refusing to use --no-sandbox"
}

ownership_sentinel_content() {
  printf '%s schema=%s\n' "${MANAGER_ID}" "${OWNERSHIP_SCHEMA_VERSION}"
}

directory_is_empty() {
  local path="$1"
  local first_entry

  first_entry="$(find "${path}" -mindepth 1 -maxdepth 1 -print -quit)" ||
    return 1
  [[ -z "${first_entry}" ]]
}

directory_can_be_listed() {
  local path="$1"

  find "${path}" -mindepth 1 -maxdepth 1 -print -quit >/dev/null
}

owned_root_is_valid() {
  local root="$1"
  local sentinel="${root}/${OWNERSHIP_SENTINEL_NAME}"

  [[ -d "${root}" && ! -L "${root}" &&
    -f "${sentinel}" && ! -L "${sentinel}" ]] || return 1
  [[ "$(cat "${sentinel}")" == "$(ownership_sentinel_content)" ]]
}

directory_contains_only_entry() {
  local root="$1"
  local retained="$2"
  local entry
  local -a entries=()

  directory_can_be_listed "${root}" || return 1
  mapfile -d '' entries < <(
    find "${root}" -mindepth 1 -maxdepth 1 -print0
  )
  for entry in "${entries[@]}"; do
    [[ "${entry}" == "${retained}" ]] || return 1
  done
  [[ -e "${retained}" || -L "${retained}" ]]
}

remove_directory_entries_except() {
  local root="$1"
  local retained="$2"
  local entry
  local -a entries=()

  directory_can_be_listed "${root}" || return 1
  mapfile -d '' entries < <(
    find "${root}" -mindepth 1 -maxdepth 1 -print0
  )
  for entry in "${entries[@]}"; do
    [[ "${entry}" == "${retained}" ]] && continue
    rm -rf -- "${entry}" || return 1
  done
  directory_contains_only_entry "${root}" "${retained}"
}

publish_cleanup_proof() {
  local source="$1"
  local proof="$2"
  local temporary="${proof}.new.$$"

  [[ -f "${source}" && ! -L "${source}" ]] || return 1
  recover_cleanup_proof_temporaries "${source}" "${proof}" || return 1
  [[ ! -e "${proof}" && ! -L "${proof}" &&
    ! -e "${temporary}" && ! -L "${temporary}" ]] || return 1
  CLEANUP_PROOF_TEMP="${temporary}"
  if ! cp -- "${source}" "${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${proof}"; then
    rm -f -- "${temporary}" || true
    CLEANUP_PROOF_TEMP=""
    return 1
  fi
  CLEANUP_PROOF_TEMP=""
}

recover_cleanup_proof_temporaries() {
  local source="$1"
  local proof="$2"
  local temporary suffix

  for temporary in "${proof}.new."*; do
    [[ -e "${temporary}" || -L "${temporary}" ]] || continue
    suffix="${temporary##*.new.}"
    if ! [[ "${suffix}" =~ ^[0-9]+$ &&
      -f "${temporary}" && ! -L "${temporary}" &&
      "$(stat -c '%u' -- "${temporary}" 2>/dev/null)" == "${EUID}" ]] ||
      ! cmp -s -- "${source}" "${temporary}"; then
      return 1
    fi
    rm -f -- "${temporary}" || return 1
  done
}

write_ownership_sentinel() {
  local root="$1"
  local sentinel="${root}/${OWNERSHIP_SENTINEL_NAME}"
  local temporary="${sentinel}.new.$$"

  if [[ -e "${sentinel}" || -L "${sentinel}" ]]; then
    owned_root_is_valid "${root}" || return 1
    return
  fi
  [[ ! -e "${temporary}" && ! -L "${temporary}" ]] || return 1
  if ! printf '%s' "$(ownership_sentinel_content)" >"${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${sentinel}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
}

ensure_owned_root() {
  local root="$1"
  local label="$2"

  [[ ! -L "${root}" ]] || die "${label} must not be a symbolic link: ${root}"
  if [[ -e "${root}" ]]; then
    [[ -d "${root}" ]] || die "${label} is not a directory: ${root}"
    if owned_root_is_valid "${root}" ||
      root_contains_only_ownership_sentinel_temporaries "${root}"; then
      cleanup_ownership_sentinel_temporaries "${root}" ||
        die "could not safely recover an interrupted ${label} ownership marker: ${root}"
    fi
    if ! owned_root_is_valid "${root}"; then
      directory_is_empty "${root}" ||
        die "${label} is not owned by Devin Desktop Manager: ${root}"
      write_ownership_sentinel "${root}" ||
        die "could not mark ${label} as manager-owned: ${root}"
    fi
  else
    mkdir -p -- "${root}"
    write_ownership_sentinel "${root}" ||
      die "could not mark ${label} as manager-owned: ${root}"
  fi
  chmod 0700 "${root}"
}

legacy_root_marker_is_compatible() {
  local root="$1"
  local sentinel="${root}/${OWNERSHIP_SENTINEL_NAME}"

  if [[ -e "${sentinel}" || -L "${sentinel}" ]]; then
    owned_root_is_valid "${root}"
  fi
}

migration_temporary_is_valid() {
  local path="$1"
  local prefix="$2"
  local name="${path##*/}"
  local expected_prefix="${prefix}."
  local suffix

  [[ "${name}" == "${expected_prefix}"* ]] || return 1
  suffix="${name#"${expected_prefix}"}"
  [[ "${suffix}" =~ ^[0-9]+$ && -f "${path}" && ! -L "${path}" ]]
}

ownership_sentinel_temporary_is_valid() {
  local path="$1"

  migration_temporary_is_valid \
    "${path}" "${OWNERSHIP_SENTINEL_NAME}.new" || return 1
  [[ "$(cat "${path}")" == "$(ownership_sentinel_content)" ]]
}

cleanup_ownership_sentinel_temporaries() {
  local root="$1"
  local path

  for path in "${root}/${OWNERSHIP_SENTINEL_NAME}.new."*; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    ownership_sentinel_temporary_is_valid "${path}" || return 1
    rm -f -- "${path}" || return 1
  done
}

root_contains_only_ownership_sentinel_temporaries() {
  local root="$1"
  local path
  local saw_temporary=false

  directory_can_be_listed "${root}" || return 1
  while IFS= read -r -d '' path; do
    ownership_sentinel_temporary_is_valid "${path}" || return 1
    saw_temporary=true
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -print0)
  [[ "${saw_temporary}" == "true" ]]
}

legacy_staging_temporary_is_valid() {
  local path="$1"
  local name="${path##*/}"
  local remainder release_name pid

  [[ "${name}" == .staging-* ]] || return 1
  remainder="${name#.staging-}"
  [[ "${remainder}" == *-* ]] || return 1
  pid="${remainder##*-}"
  release_name="${remainder%-*}"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  is_safe_release_identifier "${release_name}" || return 1
  [[ -d "${path}" && ! -L "${path}" ]]
}

legacy_integration_temporary_is_valid() {
  local path="$1"
  local name="${path##*/}"
  local pid

  [[ "${name}" == .integration-* ]] || return 1
  pid="${name#.integration-}"
  [[ "${pid}" =~ ^[0-9]+$ && -d "${path}" && ! -L "${path}" ]]
}

legacy_release_link_temporary_is_valid() {
  local path="$1"
  local prefix="$2"
  local name="${path##*/}"
  local expected_prefix="${prefix}."
  local pid

  [[ "${name}" == "${expected_prefix}"* ]] || return 1
  pid="${name#"${expected_prefix}"}"
  [[ "${pid}" =~ ^[0-9]+$ && -L "${path}" ]] || return 1
  release_target "${path}" >/dev/null
}

legacy_release_metadata_is_valid() {
  local release_dir="$1"
  local expected_release_name="${2:-$(basename "${release_dir}")}"
  local metadata="${release_dir}/release.json"
  local entry name
  local version build product_version sha256 artifact_url expected_id
  local url_prefix="https://windsurf-stable.codeiumdata.com/linux-x64-deb/stable/"

  legacy_release_tree_is_user_owned "${release_dir}" || return 1
  directory_can_be_listed "${release_dir}" || return 1
  [[ -f "${metadata}" && ! -L "${metadata}" ]] || return 1
  jq -e \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${RELEASE_METADATA_SCHEMA_VERSION}" '
    type == "object" and
    (
      del(.schemaVersion, .managerId) | keys | sort
    ) == [
      "artifactUrl",
      "build",
      "installedAt",
      "productVersion",
      "releaseTimestamp",
      "sha256",
      "windsurfVersion"
    ] and
    (
      (
        (has("schemaVersion") | not) and
        (has("managerId") | not)
      ) or (
        .schemaVersion == $schema_version and
        .managerId == $manager_id
      )
    ) and
    (.windsurfVersion | type == "string") and
    (.productVersion | type == "string") and
    (.build | type == "string") and
    (.artifactUrl | type == "string") and
    (.sha256 | type == "string") and
    (.releaseTimestamp | type == "number") and
    (.installedAt | type == "string")
  ' "${metadata}" >/dev/null 2>&1 || return 1

  version="$(jq -r '.windsurfVersion' "${metadata}")"
  product_version="$(jq -r '.productVersion' "${metadata}")"
  build="$(jq -r '.build' "${metadata}")"
  sha256="$(jq -r '.sha256' "${metadata}")"
  artifact_url="$(jq -r '.artifactUrl' "${metadata}")"
  is_safe_release_identifier "${version}" || return 1
  is_safe_release_identifier "${product_version}" || return 1
  is_safe_release_identifier "${build}" || return 1
  [[ "${sha256}" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "${artifact_url}" == \
    "${url_prefix}${build}/Devin-linux-x64-${version}.deb" ]] || return 1
  expected_id="$(release_identifier "${version}" "${build}" "${sha256}")" ||
    return 1
  [[ "${expected_release_name}" == "${expected_id}" ]] || return 1

  [[ -d "${release_dir}/app" && ! -L "${release_dir}/app" ]] || return 1
  [[ -d "${release_dir}/integration" &&
    ! -L "${release_dir}/integration" ]] || return 1
  [[ -f "${release_dir}/app/devin-desktop" &&
    -x "${release_dir}/app/devin-desktop" &&
    ! -L "${release_dir}/app/devin-desktop" ]] || return 1
  [[ -f "${release_dir}/app/bin/devin-desktop" &&
    -x "${release_dir}/app/bin/devin-desktop" &&
    ! -L "${release_dir}/app/bin/devin-desktop" ]] || return 1
  [[ -f "${release_dir}/integration/devin-desktop.png" &&
    ! -L "${release_dir}/integration/devin-desktop.png" ]] || return 1
  [[ -f "${release_dir}/integration/devin-desktop-workspace.xml" &&
    ! -L "${release_dir}/integration/devin-desktop-workspace.xml" ]] || return 1

  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      app|integration)
        [[ -d "${entry}" && ! -L "${entry}" ]] || return 1
        ;;
      release.json)
        [[ -f "${entry}" && ! -L "${entry}" ]] || return 1
        ;;
      release.json.new.*)
        migration_temporary_is_valid "${entry}" "release.json.new" || return 1
        ;;
      *)
        return 1
        ;;
    esac
  done < <(find "${release_dir}" -mindepth 1 -maxdepth 1 -print0)
}

legacy_release_inventory_is_valid() {
  local require_current="${1:-true}"
  local release_entry
  local saw_release=false

  legacy_directory_is_user_owned "${RELEASES_DIR}" || return 1
  directory_can_be_listed "${RELEASES_DIR}" || return 1
  if [[ -e "${CURRENT_LINK}" || -L "${CURRENT_LINK}" ]]; then
    release_target "${CURRENT_LINK}" >/dev/null || return 1
  else
    [[ "${require_current}" == "false" ]] || return 1
    [[ ! -e "${PREVIOUS_LINK}" && ! -L "${PREVIOUS_LINK}" ]] || return 1
  fi
  if [[ -e "${PREVIOUS_LINK}" || -L "${PREVIOUS_LINK}" ]]; then
    release_target "${PREVIOUS_LINK}" >/dev/null || return 1
  fi

  while IFS= read -r -d '' release_entry; do
    [[ -d "${release_entry}" && ! -L "${release_entry}" ]] || return 1
    legacy_release_metadata_is_valid "${release_entry}" || return 1
    saw_release=true
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -print0)
  [[ "${saw_release}" == "true" || "${require_current}" == "false" ]]
}

legacy_state_is_valid() {
  local original

  state_is_valid || return 1
  jq -e \
    --arg manager_version "${LEGACY_MANAGER_VERSION}" \
    --argjson schema_version "${STATE_SCHEMA_VERSION}" \
    --arg mime_devin "${MIME_DEVIN}" \
    --arg mime_windsurf "${MIME_WINDSURF}" \
    --arg mime_workspace "${MIME_WORKSPACE}" \
    --arg main_path "${MAIN_DESKTOP}" \
    --arg url_path "${URL_DESKTOP}" \
    --arg icon_path "${ICON_FILE}" \
    --arg mime_path "${MIME_FILE}" \
    --arg command_path "${APP_COMMAND}" \
    --arg command_target "${CURRENT_LINK}/app/bin/devin-desktop" '
      (keys | sort) == [
        "appCommand",
        "managedFiles",
        "managerVersion",
        "originalDefaults",
        "schemaVersion"
      ] and
      .schemaVersion == $schema_version and
      .managerVersion == $manager_version and
      (.originalDefaults | keys | sort) ==
        ([$mime_devin, $mime_windsurf, $mime_workspace] | sort) and
      ([.originalDefaults[] | type] | all(. == "string")) and
      (.managedFiles | keys | sort) ==
        ["icon", "mainDesktop", "mime", "urlDesktop"] and
      .managedFiles.mainDesktop.path == $main_path and
      .managedFiles.urlDesktop.path == $url_path and
      .managedFiles.icon.path == $icon_path and
      .managedFiles.mime.path == $mime_path and
      .appCommand == {
        path: $command_path,
        target: $command_target
      }
    ' "${STATE_FILE}" >/dev/null 2>&1 || return 1

  for original in \
    "$(jq -r --arg mime "${MIME_DEVIN}" '.originalDefaults[$mime]' "${STATE_FILE}")" \
    "$(jq -r --arg mime "${MIME_WINDSURF}" '.originalDefaults[$mime]' "${STATE_FILE}")" \
    "$(jq -r --arg mime "${MIME_WORKSPACE}" '.originalDefaults[$mime]' "${STATE_FILE}")"; do
    is_safe_desktop_id "${original}" || return 1
  done
  managed_file_matches_state mainDesktop "${MAIN_DESKTOP}" || return 1
  managed_file_matches_state urlDesktop "${URL_DESKTOP}" || return 1
  managed_file_matches_state icon "${ICON_FILE}" || return 1
  managed_file_matches_state mime "${MIME_FILE}" || return 1
  [[ -L "${APP_COMMAND}" &&
    "$(readlink "${APP_COMMAND}")" == \
      "${CURRENT_LINK}/app/bin/devin-desktop" ]]
}

legacy_install_root_is_valid() {
  local require_current="${1:-true}"
  local require_lock="${2:-true}"
  local entry name
  local saw_lock=false saw_releases=false

  legacy_tree_is_user_owned_and_unmounted "${INSTALL_ROOT}" || return 1
  directory_can_be_listed "${INSTALL_ROOT}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      releases)
        legacy_directory_is_user_owned "${entry}" || return 1
        saw_releases=true
        ;;
      current|previous)
        [[ -L "${entry}" ]] || return 1
        ;;
      .manager.lock)
        [[ -f "${entry}" && ! -L "${entry}" ]] || return 1
        saw_lock=true
        ;;
      "${OWNERSHIP_SENTINEL_NAME}")
        owned_root_is_valid "${INSTALL_ROOT}" || return 1
        ;;
      "${OWNERSHIP_SENTINEL_NAME}".new.*)
        ownership_sentinel_temporary_is_valid "${entry}" || return 1
        ;;
      .staging-*)
        legacy_staging_temporary_is_valid "${entry}" || return 1
        ;;
      .integration-*)
        legacy_integration_temporary_is_valid "${entry}" || return 1
        ;;
      .current.new.*)
        legacy_release_link_temporary_is_valid \
          "${entry}" ".current.new" || return 1
        ;;
      .previous.new.*)
        legacy_release_link_temporary_is_valid \
          "${entry}" ".previous.new" || return 1
        ;;
      *)
        return 1
        ;;
    esac
  done < <(find "${INSTALL_ROOT}" -mindepth 1 -maxdepth 1 -print0)
  [[ "${saw_releases}" == "true" ]] || return 1
  [[ "${saw_lock}" == "true" || "${require_lock}" == "false" ]] || return 1
  legacy_release_inventory_is_valid "${require_current}"
}

legacy_cache_root_is_valid() {
  local entry name release_id

  if [[ ! -e "${CACHE_ROOT}" && ! -L "${CACHE_ROOT}" ]]; then
    return 0
  fi
  legacy_tree_is_user_owned_and_unmounted "${CACHE_ROOT}" || return 1
  directory_can_be_listed "${CACHE_ROOT}" || return 1
  legacy_root_marker_is_compatible "${CACHE_ROOT}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      "${OWNERSHIP_SENTINEL_NAME}")
        ;;
      "${OWNERSHIP_SENTINEL_NAME}".new.*)
        ownership_sentinel_temporary_is_valid "${entry}" || return 1
        ;;
      Devin-linux-x64-*.deb|Devin-linux-x64-*.deb.part)
        [[ -f "${entry}" && ! -L "${entry}" ]] || return 1
        release_id="${name#Devin-linux-x64-}"
        release_id="${release_id%.part}"
        release_id="${release_id%.deb}"
        is_safe_release_identifier "${release_id}" || return 1
        ;;
      *)
        return 1
        ;;
    esac
  done < <(find "${CACHE_ROOT}" -mindepth 1 -maxdepth 1 -print0)
}

legacy_state_root_is_valid() {
  local entry name

  legacy_tree_is_user_owned_and_unmounted "${STATE_DIR}" || return 1
  directory_can_be_listed "${STATE_DIR}" || return 1
  legacy_root_marker_is_compatible "${STATE_DIR}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      state.json|"${OWNERSHIP_SENTINEL_NAME}") ;;
      state.json.new.*)
        migration_temporary_is_valid "${entry}" "state.json.new" || return 1
        ;;
      "${OWNERSHIP_SENTINEL_NAME}".new.*)
        ownership_sentinel_temporary_is_valid "${entry}" || return 1
        ;;
      *) return 1 ;;
    esac
  done < <(find "${STATE_DIR}" -mindepth 1 -maxdepth 1 -print0)
  legacy_state_is_valid
}

legacy_pre_activation_state_root_is_valid() {
  local entry name

  if [[ ! -e "${STATE_DIR}" && ! -L "${STATE_DIR}" ]]; then
    return 0
  fi
  legacy_tree_is_user_owned_and_unmounted "${STATE_DIR}" || return 1
  directory_can_be_listed "${STATE_DIR}" || return 1
  legacy_root_marker_is_compatible "${STATE_DIR}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      "${OWNERSHIP_SENTINEL_NAME}") ;;
      state.json.new.*)
        migration_temporary_is_valid "${entry}" "state.json.new" || return 1
        ;;
      "${OWNERSHIP_SENTINEL_NAME}".new.*)
        ownership_sentinel_temporary_is_valid "${entry}" || return 1
        ;;
      *) return 1 ;;
    esac
  done < <(find "${STATE_DIR}" -mindepth 1 -maxdepth 1 -print0)
}

legacy_pre_activation_integration_is_absent() {
  local path

  for path in \
    "${APP_COMMAND}" \
    "${MAIN_DESKTOP}" \
    "${URL_DESKTOP}" \
    "${ICON_FILE}" \
    "${MIME_FILE}" \
    "${LEGACY_MAIN_DESKTOP}" \
    "${LEGACY_URL_DESKTOP}" \
    "${LEGACY_ICON_FILE}" \
    "${LEGACY_MIME_FILE}"; do
    [[ ! -e "${path}" && ! -L "${path}" ]] || return 1
  done
}

legacy_post_link_integration_is_recoverable() {
  local path

  if [[ -e "${APP_COMMAND}" || -L "${APP_COMMAND}" ]]; then
    [[ -L "${APP_COMMAND}" &&
      "$(readlink "${APP_COMMAND}")" == \
        "${CURRENT_LINK}/app/bin/devin-desktop" ]] || return 1
  fi
  for path in \
    "${MAIN_DESKTOP}" \
    "${URL_DESKTOP}" \
    "${LEGACY_MAIN_DESKTOP}" \
    "${LEGACY_URL_DESKTOP}"; do
    if [[ -e "${path}" || -L "${path}" ]]; then
      legacy_desktop_owned "${path}" || return 1
    fi
  done
  if [[ -e "${ICON_FILE}" || -L "${ICON_FILE}" ]]; then
    asset_matches_release "${ICON_FILE}" devin-desktop.png || return 1
  fi
  if [[ -e "${MIME_FILE}" || -L "${MIME_FILE}" ]]; then
    asset_matches_release \
      "${MIME_FILE}" devin-desktop-workspace.xml || return 1
  fi
  if [[ -e "${LEGACY_ICON_FILE}" || -L "${LEGACY_ICON_FILE}" ]]; then
    asset_matches_release "${LEGACY_ICON_FILE}" devin-desktop.png || return 1
  fi
  if [[ -e "${LEGACY_MIME_FILE}" || -L "${LEGACY_MIME_FILE}" ]]; then
    asset_matches_release \
      "${LEGACY_MIME_FILE}" devin-desktop-workspace.xml || return 1
  fi
}

legacy_post_link_defaults_are_unclaimed() {
  local mime_type current

  for mime_type in \
    "${MIME_DEVIN}" \
    "${MIME_WINDSURF}" \
    "${MIME_WORKSPACE}"; do
    current="$(query_default "${mime_type}")" || return 1
    case "${current}" in
      "${MAIN_DESKTOP_ID}"|"${URL_DESKTOP_ID}"|\
        "${LEGACY_MAIN_DESKTOP_ID}"|"${LEGACY_URL_DESKTOP_ID}")
        return 1
        ;;
    esac
  done
}

classify_legacy_refusal() {
  LEGACY_CLASSIFICATION="refused"
  LEGACY_REASON="$1"
  LEGACY_OBSERVED="${2:-}"
  LEGACY_REQUIRES_APP_STOP=false
  return 1
}

reset_legacy_classification() {
  LEGACY_CLASSIFICATION="refused"
  LEGACY_REASON=""
  LEGACY_OBSERVED=""
  LEGACY_REQUIRES_APP_STOP=false
  LEGACY_ORIGINAL_DEVIN=""
  LEGACY_ORIGINAL_WINDSURF=""
  LEGACY_ORIGINAL_WORKSPACE=""
  LEGACY_FALLBACK_DEVIN=""
  LEGACY_FALLBACK_WINDSURF=""
  LEGACY_FALLBACK_WORKSPACE=""
  LEGACY_CURRENT_DEVIN_OWNED=false
  LEGACY_CURRENT_WINDSURF_OWNED=false
  LEGACY_CURRENT_WORKSPACE_OWNED=false
}

desktop_escape_command() {
  local escaped_command="$1"

  escaped_command="${escaped_command//\\/\\\\}"
  escaped_command="${escaped_command//\"/\\\"}"
  escaped_command="${escaped_command//\`/\\\`}"
  escaped_command="${escaped_command//\$/\\\$}"
  printf '%s' "${escaped_command}"
}

legacy_file_is_user_regular() {
  local path="$1"
  local owner mode

  [[ -f "${path}" && ! -L "${path}" ]] || return 1
  owner="$(stat -c '%u' -- "${path}" 2>/dev/null)" || return 1
  mode="$(stat -c '%a' -- "${path}" 2>/dev/null)" || return 1
  [[ "${owner}" == "${EUID}" ]] && preflight_mode_is_safe "${mode}"
}

legacy_directory_is_user_owned() {
  local path="$1"

  [[ -d "${path}" && ! -L "${path}" &&
    "$(stat -c '%u' -- "${path}" 2>/dev/null)" == "${EUID}" ]]
}

legacy_symlink_is_user_owned() {
  local path="$1"

  [[ -L "${path}" &&
    "$(stat -c '%u' -- "${path}" 2>/dev/null)" == "${EUID}" ]]
}

legacy_mountinfo_path() {
  printf '/proc/self/mountinfo\n'
}

legacy_mount_table_has_no_targets_at_or_below() {
  local root="$1"
  local mountinfo

  mountinfo="$(legacy_mountinfo_path)" || return 1
  [[ -r "${mountinfo}" ]] || return 1
  DEVIN_DESKTOP_MANAGER_MOUNT_ROOT="${root}" awk '
    function decode_mount_path(value, encoded) {
      encoded = value
      gsub(/\\(040|011|012|134)/, "", encoded)
      if (encoded ~ /\\/) {
        invalid_escape = 1
        return value
      }
      gsub(/\\040/, " ", value)
      gsub(/\\011/, "\t", value)
      gsub(/\\012/, "\n", value)
      gsub(/\\134/, sprintf("%c", 92), value)
      return value
    }
    BEGIN { root = ENVIRON["DEVIN_DESKTOP_MANAGER_MOUNT_ROOT"] }
    {
      separator = 0
      for (field_index = 7; field_index <= NF; field_index++) {
        if ($field_index == "-") {
          separator = field_index
          break
        }
      }
      if ($1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ ||
          $3 !~ /^[0-9]+:[0-9]+$/ ||
          substr($5, 1, 1) != "/" ||
          separator == 0 || separator > NF - 3) {
        invalid = 1
        next
      }
      target = decode_mount_path($5)
      if (target == root || index(target, root "/") == 1) mounted = 1
      saw_mount = 1
    }
    END {
      exit saw_mount && !invalid && !invalid_escape && !mounted ? 0 : 1
    }
  ' "${mountinfo}"
}

legacy_tree_is_user_owned_and_unmounted() {
  local root="$1"
  local canonical_root

  legacy_directory_is_user_owned "${root}" || return 1
  user_directory_ancestry_is_safe "${root}" || return 1
  find "${root}" -xdev -exec stat -c '%u' -- {} + |
    awk -v expected_owner="${EUID}" '
      $0 != expected_owner { invalid = 1 }
      END { exit invalid ? 1 : 0 }
    ' || return 1
  find "${root}" -xdev ! -type l -exec stat -c '%u %a' -- {} + |
    awk -v expected_owner="${EUID}" '
      {
        mode = $2
        group_mode = substr(mode, length(mode) - 1, 1)
        other_mode = substr(mode, length(mode), 1)
        if ($1 != expected_owner || mode !~ /^[0-7]+$/ ||
            (length(mode) != 3 && length(mode) != 4) ||
            group_mode ~ /[2367]/ || other_mode ~ /[2367]/) {
          invalid = 1
        }
      }
      END { exit invalid ? 1 : 0 }
    ' || return 1
  canonical_root="$(readlink -f -- "${root}")" || return 1
  legacy_mount_table_has_no_targets_at_or_below "${canonical_root}"
}

legacy_release_tree_is_user_owned() {
  local release_dir="$1"

  legacy_tree_is_user_owned_and_unmounted "${release_dir}"
}

legacy_desktop_is_user_regular() {
  legacy_file_is_user_regular "$1"
}

legacy_desktop_semantics_are_valid() {
  local path="$1"
  local role="$2"
  local escaped_command

  escaped_command="$(desktop_escape_command "${APP_COMMAND}")"
  legacy_desktop_is_user_regular "${path}" || return 1
  desktop-file-validate "${path}" >/dev/null 2>&1 || return 1
  DEVIN_DESKTOP_MANAGER_AWK_QUOTED_COMMAND="\"${escaped_command}\"" \
    awk \
    -v role="${role}" \
    -v command="${APP_COMMAND}" \
    -v mime_devin="${MIME_DEVIN}" \
    -v mime_windsurf="${MIME_WINDSURF}" \
    -v mime_workspace="${MIME_WORKSPACE}" '
    function list_matches(value, expected, actual, wanted, count, needed, i, item, old) {
      count = split(value, actual, ";")
      if (count > 0 && actual[count] == "") count--
      needed = split(expected, wanted, ";")
      if (count != needed) return 0
      for (old in present) delete present[old]
      for (i = 1; i <= count; i++) {
        item = actual[i]
        if (item == "" || present[item]++) return 0
      }
      for (i = 1; i <= needed; i++) {
        if (!(wanted[i] in present)) return 0
      }
      return 1
    }
    function localized_display_key(key) {
      return key ~ /^(Name|GenericName|Comment)(\[[^][]+\])?$/
    }
    function reject() { invalid = 1 }
    BEGIN {
      section = ""
      desktop_sections = 0
      action_sections = 0
      quoted_command = ENVIRON["DEVIN_DESKTOP_MANAGER_AWK_QUOTED_COMMAND"]
    }
    /\r$/ { reject(); next }
    /^[[:space:]]*($|#)/ { next }
    /^\[/ {
      if ($0 == "[Desktop Entry]") {
        desktop_sections++
        section = "desktop"
      } else if ($0 == "[Desktop Action new-empty-window]") {
        action_sections++
        section = "action"
      } else {
        reject()
      }
      next
    }
    {
      separator = index($0, "=")
      if (separator < 2 || section == "") {
        reject()
        next
      }
      key = substr($0, 1, separator - 1)
      value = substr($0, separator + 1)
      identity = section SUBSEP key
      if (seen[identity]++) {
        reject()
        next
      }
      values[identity] = value
      if (section == "desktop") {
        if (localized_display_key(key)) next
        if (key !~ /^(Exec|TryExec|Icon|Type|StartupNotify|StartupWMClass|Categories|MimeType|Actions|Keywords|NoDisplay|X-Devin-Desktop-Manager)$/) reject()
      } else {
        if (key ~ /^Name(\[[^][]+\])?$/) next
        if (key !~ /^(Exec|Icon)$/) reject()
      }
    }
    END {
      if (desktop_sections != 1) reject()
      if (role == "main" && action_sections != 1) reject()
      if (role == "url" && action_sections != 0) reject()
      if (values["desktop" SUBSEP "Type"] != "Application") reject()
      if (values["desktop" SUBSEP "TryExec"] != command) reject()
      if (values["desktop" SUBSEP "Icon"] != "devin-desktop") reject()
      if (values["desktop" SUBSEP "StartupWMClass"] != "Devin") reject()
      if (values["desktop" SUBSEP "Keywords"] != "vscode;") reject()
      if (values["desktop" SUBSEP "X-Devin-Desktop-Manager"] != "true") reject()
      if (role == "main") {
        if (values["desktop" SUBSEP "Exec"] != quoted_command " %F") reject()
        if (values["desktop" SUBSEP "StartupNotify"] != "false") reject()
        if (!list_matches(values["desktop" SUBSEP "Categories"], "TextEditor;Development;IDE")) reject()
        if (!list_matches(values["desktop" SUBSEP "MimeType"], mime_workspace)) reject()
        if (!list_matches(values["desktop" SUBSEP "Actions"], "new-empty-window")) reject()
        if (("desktop" SUBSEP "NoDisplay") in values) reject()
        if (values["action" SUBSEP "Exec"] != quoted_command " --new-window %F") reject()
        if (values["action" SUBSEP "Icon"] != "devin-desktop") reject()
      } else {
        if (values["desktop" SUBSEP "Exec"] != quoted_command " --open-url %U") reject()
        if (values["desktop" SUBSEP "NoDisplay"] != "true") reject()
        if (values["desktop" SUBSEP "StartupNotify"] != "true") reject()
        if (!list_matches(values["desktop" SUBSEP "Categories"], "Utility;TextEditor;Development;IDE")) reject()
        if (!list_matches(values["desktop" SUBSEP "MimeType"], mime_devin ";" mime_windsurf)) reject()
        if (("desktop" SUBSEP "Actions") in values) reject()
      }
      exit invalid ? 1 : 0
    }
  ' "${path}"
}

legacy_expected_desktop_id() {
  case "$1" in
    "${MIME_DEVIN}"|"${MIME_WINDSURF}")
      printf '%s\n' "${LEGACY_URL_DESKTOP_ID}"
      ;;
    "${MIME_WORKSPACE}")
      printf '%s\n' "${LEGACY_MAIN_DESKTOP_ID}"
      ;;
    *) return 1 ;;
  esac
}

legacy_mime_record_is_manager_id() {
  case "$1" in
    "${MAIN_DESKTOP_ID}"|"${URL_DESKTOP_ID}"|\
      "${LEGACY_MAIN_DESKTOP_ID}"|"${LEGACY_URL_DESKTOP_ID}")
      return 0
      ;;
    *) return 1 ;;
  esac
}

legacy_reason_mime_key() {
  local mime_type="$1"

  if [[ "${mime_type}" =~ ^[A-Za-z0-9][A-Za-z0-9._+!-]*/[A-Za-z0-9][A-Za-z0-9._+!-]*$ ]]; then
    printf '%s\n' "${mime_type}"
  else
    printf 'unknown\n'
  fi
}

legacy_desktop_relative_path_is_available() {
  local directory="$1"
  local desktop_id="$2"
  local prefix="" remainder="${desktop_id}" segment

  if [[ -e "${directory}/${desktop_id}" ||
    -L "${directory}/${desktop_id}" ]]; then
    LEGACY_DESKTOP_CANDIDATE="${directory}/${desktop_id}"
    return 0
  fi
  while [[ "${remainder}" == *-* ]]; do
    segment="${remainder%%-*}"
    remainder="${remainder#*-}"
    if [[ -n "${prefix}" ]]; then
      prefix+="-"
    fi
    prefix+="${segment}"
    case "${prefix}" in
      ""|.|..) continue ;;
    esac
    if [[ -d "${directory}/${prefix}" ]] &&
      legacy_desktop_relative_path_is_available \
        "${directory}/${prefix}" "${remainder}"; then
      return 0
    fi
  done
  return 1
}

legacy_desktop_candidate_is_available() {
  local path="$1"

  [[ -f "${path}" ]] || return 1
  desktop-file-validate "${path}" >/dev/null 2>&1 || return 1
  awk '
    $0 == "[Desktop Entry]" { in_desktop = 1; next }
    /^\[/ { in_desktop = 0 }
    in_desktop && /^[[:space:]]*Type[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      type = value
    }
    in_desktop && /^[[:space:]]*Hidden[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      if (value == "true" || value == "1") hidden = 1
    }
    END { exit type == "Application" && !hidden ? 0 : 1 }
  ' "${path}"
}

legacy_desktop_id_is_available() {
  local desktop_id="$1"
  local data_directory
  local -a data_directories=() system_data_directories=()

  is_safe_desktop_id "${desktop_id}" || return 1
  data_directories=("${DATA_HOME}")
  IFS=':' read -r -a system_data_directories \
    <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for data_directory in "${system_data_directories[@]}"; do
    [[ "${data_directory}" == /* ]] || continue
    data_directories+=("${data_directory}")
  done
  for data_directory in "${data_directories[@]}"; do
    LEGACY_DESKTOP_CANDIDATE=""
    if legacy_desktop_relative_path_is_available \
      "${data_directory}/applications" "${desktop_id}"; then
      legacy_desktop_candidate_is_available "${LEGACY_DESKTOP_CANDIDATE}" &&
        return 0
      return 1
    fi
  done
  return 1
}

legacy_mimeapps_file_is_safe() {
  local file="$1"
  local section="" line mime_type value desktop_id expected reason_mime
  local record_has_expected record_fallback
  local -a desktop_ids=()
  local -A seen_records=()

  legacy_file_is_user_regular "${file}" || {
    LEGACY_REASON="default-provenance:unknown"
    LEGACY_OBSERVED="${file}"
    return 1
  }
  user_file_parent_is_safe "${file}" || {
    LEGACY_REASON="default-provenance:unknown"
    LEGACY_OBSERVED="${file}"
    return 1
  }
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" != *$'\r' ]] || {
      LEGACY_REASON="default-shape:unknown"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    case "${line}" in
      ""|'#'*|';'*) continue ;;
      '['*']') section="${line}"; continue ;;
    esac
    [[ "${line}" == *=* ]] || {
      LEGACY_REASON="default-shape:unknown"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    mime_type="${line%%=*}"
    value="${line#*=}"
    [[ -n "${section}" && -n "${mime_type}" ]] || {
      LEGACY_REASON="default-shape:unknown"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    case "${mime_type}" in
      "${MIME_DEVIN}"|"${MIME_WINDSURF}"|"${MIME_WORKSPACE}") ;;
      *)
        reason_mime="$(legacy_reason_mime_key "${mime_type}")"
        IFS=';' read -r -a desktop_ids <<<"${value}"
        for desktop_id in "${desktop_ids[@]}"; do
          [[ -n "${desktop_id}" ]] || continue
          is_safe_desktop_id "${desktop_id}" || {
            LEGACY_REASON="default-shape:${reason_mime}"
            LEGACY_OBSERVED="${desktop_id}"
            return 1
          }
          legacy_mime_record_is_manager_id "${desktop_id}" || continue
          LEGACY_REASON="default-provenance:${reason_mime}"
          LEGACY_OBSERVED="${file}"
          return 1
        done
        continue
        ;;
    esac
    [[ -z "${seen_records[${section}|${mime_type}]:-}" ]] || {
      LEGACY_REASON="default-provenance:${mime_type}"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    seen_records["${section}|${mime_type}"]=true
    [[ "${value}" != ';'* && "${value}" != *';;'* ]] || {
      LEGACY_REASON="default-provenance:${mime_type}"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    IFS=';' read -r -a desktop_ids <<<"${value}"
    expected="$(legacy_expected_desktop_id "${mime_type}")" || return 1
    record_has_expected=false
    record_fallback=""
    for desktop_id in "${desktop_ids[@]}"; do
      [[ -n "${desktop_id}" ]] || continue
      is_safe_desktop_id "${desktop_id}" || {
        LEGACY_REASON="default-shape:${mime_type}"
        LEGACY_OBSERVED="${desktop_id}"
        return 1
      }
      if legacy_mime_record_is_manager_id "${desktop_id}"; then
        if [[ "${desktop_id}" != "${expected}" ||
          ( "${section}" != "[Default Applications]" &&
            "${section}" != "[Added Associations]" ) ]]; then
          LEGACY_REASON="default-shape:${mime_type}"
          LEGACY_OBSERVED="${desktop_id}"
          return 1
        fi
        if [[ "${section}" == "[Default Applications]" ]]; then
          record_has_expected=true
        fi
      elif [[ "${section}" == "[Default Applications]" &&
        "${record_has_expected}" == "true" && -z "${record_fallback}" ]] &&
        legacy_desktop_id_is_available "${desktop_id}"; then
        record_fallback="${desktop_id}"
      fi
    done
    if [[ "${record_has_expected}" == "true" ]]; then
      case "${mime_type}" in
        "${MIME_DEVIN}")
          if [[ "${LEGACY_PROVENANCE_DEVIN}" != "true" ]]; then
            LEGACY_FALLBACK_DEVIN="${record_fallback}"
          fi
          LEGACY_PROVENANCE_DEVIN=true
          ;;
        "${MIME_WINDSURF}")
          if [[ "${LEGACY_PROVENANCE_WINDSURF}" != "true" ]]; then
            LEGACY_FALLBACK_WINDSURF="${record_fallback}"
          fi
          LEGACY_PROVENANCE_WINDSURF=true
          ;;
        "${MIME_WORKSPACE}")
          if [[ "${LEGACY_PROVENANCE_WORKSPACE}" != "true" ]]; then
            LEGACY_FALLBACK_WORKSPACE="${record_fallback}"
          fi
          LEGACY_PROVENANCE_WORKSPACE=true
          ;;
      esac
    fi
  done <"${file}"
}

legacy_desktop_specific_defaults_are_absent() {
  local file line mime_type value desktop_id reason_mime
  local -a candidates=() desktop_ids=()

  candidates=(
    "${CONFIG_HOME}"/*-mimeapps.list
    "${DATA_HOME}"/*-mimeapps.list
    "${DATA_HOME}/applications"/*-mimeapps.list
  )
  for file in "${candidates[@]}"; do
    [[ -e "${file}" || -L "${file}" ]] || continue
    [[ -f "${file}" && ! -L "${file}" ]] || {
      LEGACY_REASON="desktop-specific-default:unknown"
      LEGACY_OBSERVED="${file}"
      return 1
    }
    while IFS= read -r line || [[ -n "${line}" ]]; do
      case "${line}" in
        ""|'#'*|';'*) continue ;;
      esac
      [[ "${line}" == *=* ]] || continue
      mime_type="${line%%=*}"
      value="${line#*=}"
      IFS=';' read -r -a desktop_ids <<<"${value}"
      for desktop_id in "${desktop_ids[@]}"; do
        legacy_mime_record_is_manager_id "${desktop_id}" || continue
        reason_mime="$(legacy_reason_mime_key "${mime_type}")"
        LEGACY_REASON="desktop-specific-default:${reason_mime}"
        LEGACY_OBSERVED="${file}"
        return 1
      done
    done <"${file}"
  done
}

classify_initial_manager_defaults() {
  local file mime_type current expected provenance

  LEGACY_PROVENANCE_DEVIN=false
  LEGACY_PROVENANCE_WINDSURF=false
  LEGACY_PROVENANCE_WORKSPACE=false
  LEGACY_FALLBACK_DEVIN=""
  LEGACY_FALLBACK_WINDSURF=""
  LEGACY_FALLBACK_WORKSPACE=""
  LEGACY_CURRENT_DEVIN_OWNED=false
  LEGACY_CURRENT_WINDSURF_OWNED=false
  LEGACY_CURRENT_WORKSPACE_OWNED=false
  for file in \
    "${CONFIG_HOME}/mimeapps.list" \
    "${DATA_HOME}/applications/mimeapps.list" \
    "${DATA_HOME}/mimeapps.list"; do
    if [[ -e "${file}" || -L "${file}" ]]; then
      legacy_mimeapps_file_is_safe "${file}" || return 1
    fi
  done
  legacy_desktop_specific_defaults_are_absent || return 1

  for mime_type in \
    "${MIME_DEVIN}" \
    "${MIME_WINDSURF}" \
    "${MIME_WORKSPACE}"; do
    if ! current="$(query_default "${mime_type}")"; then
      LEGACY_REASON="default-query:${mime_type}"
      LEGACY_OBSERVED="${mime_type}"
      return 1
    fi
    is_safe_desktop_id "${current}" || {
      LEGACY_REASON="default-shape:${mime_type}"
      LEGACY_OBSERVED="${current}"
      return 1
    }
    expected="$(legacy_expected_desktop_id "${mime_type}")" || return 1
    case "${mime_type}" in
      "${MIME_DEVIN}") provenance="${LEGACY_PROVENANCE_DEVIN}" ;;
      "${MIME_WINDSURF}") provenance="${LEGACY_PROVENANCE_WINDSURF}" ;;
      "${MIME_WORKSPACE}") provenance="${LEGACY_PROVENANCE_WORKSPACE}" ;;
    esac
    if [[ "${current}" == "${expected}" ]]; then
      if [[ "${provenance}" != "true" ]]; then
        LEGACY_REASON="default-provenance:${mime_type}"
        LEGACY_OBSERVED="${current}"
        return 1
      fi
      case "${mime_type}" in
        "${MIME_DEVIN}")
          current="${LEGACY_FALLBACK_DEVIN}"
          LEGACY_CURRENT_DEVIN_OWNED=true
          ;;
        "${MIME_WINDSURF}")
          current="${LEGACY_FALLBACK_WINDSURF}"
          LEGACY_CURRENT_WINDSURF_OWNED=true
          ;;
        "${MIME_WORKSPACE}")
          current="${LEGACY_FALLBACK_WORKSPACE}"
          LEGACY_CURRENT_WORKSPACE_OWNED=true
          ;;
      esac
    elif legacy_mime_record_is_manager_id "${current}"; then
      LEGACY_REASON="default-shape:${mime_type}"
      LEGACY_OBSERVED="${current}"
      return 1
    fi
    case "${mime_type}" in
      "${MIME_DEVIN}") LEGACY_ORIGINAL_DEVIN="${current}" ;;
      "${MIME_WINDSURF}") LEGACY_ORIGINAL_WINDSURF="${current}" ;;
      "${MIME_WORKSPACE}") LEGACY_ORIGINAL_WORKSPACE="${current}" ;;
    esac
  done
}

initial_manager_integration_is_valid() {
  local path

  for path in \
    "${APP_COMMAND}" \
    "${LEGACY_MAIN_DESKTOP}" \
    "${LEGACY_URL_DESKTOP}" \
    "${LEGACY_ICON_FILE}" \
    "${LEGACY_MIME_FILE}"; do
    user_file_parent_is_safe "${path}" || {
      LEGACY_REASON="install-root"
      LEGACY_OBSERVED="$(dirname "${path}")"
      return 1
    }
  done
  if ! legacy_symlink_is_user_owned "${APP_COMMAND}" ||
    [[ "$(readlink "${APP_COMMAND}")" != "${CURRENT_LINK}/app/bin/devin-desktop" ]]; then
    LEGACY_REASON="app-link"
    LEGACY_OBSERVED="${APP_COMMAND}"
    return 1
  fi
  for path in "${MAIN_DESKTOP}" "${URL_DESKTOP}" "${ICON_FILE}" "${MIME_FILE}"; do
    [[ ! -e "${path}" && ! -L "${path}" ]] || {
      LEGACY_REASON="install-root"
      LEGACY_OBSERVED="${path}"
      return 1
    }
  done
  legacy_desktop_semantics_are_valid "${LEGACY_MAIN_DESKTOP}" main || {
    LEGACY_REASON="main-desktop"
    LEGACY_OBSERVED="${LEGACY_MAIN_DESKTOP}"
    return 1
  }
  legacy_desktop_semantics_are_valid "${LEGACY_URL_DESKTOP}" url || {
    LEGACY_REASON="url-desktop"
    LEGACY_OBSERVED="${LEGACY_URL_DESKTOP}"
    return 1
  }
  asset_matches_release "${LEGACY_ICON_FILE}" devin-desktop.png || {
    LEGACY_REASON="icon"
    LEGACY_OBSERVED="${LEGACY_ICON_FILE}"
    return 1
  }
  asset_matches_release "${LEGACY_MIME_FILE}" devin-desktop-workspace.xml || {
    LEGACY_REASON="mime"
    LEGACY_OBSERVED="${LEGACY_MIME_FILE}"
    return 1
  }
}

classify_state_less_legacy_integration() {
  local initial_reason initial_observed

  if [[ -e "${LEGACY_MAIN_DESKTOP}" || -L "${LEGACY_MAIN_DESKTOP}" ||
    -e "${LEGACY_URL_DESKTOP}" || -L "${LEGACY_URL_DESKTOP}" ]]; then
    if initial_manager_integration_is_valid; then
      classify_initial_manager_defaults ||
        classify_legacy_refusal \
          "${LEGACY_REASON:-default-provenance:unknown}" \
          "${LEGACY_OBSERVED}" || return 1
      LEGACY_CLASSIFICATION="initial-complete"
      LEGACY_REQUIRES_APP_STOP=true
      return 0
    fi

    initial_reason="${LEGACY_REASON:-install-root}"
    initial_observed="${LEGACY_OBSERVED}"
    if legacy_post_link_integration_is_recoverable &&
      legacy_post_link_defaults_are_unclaimed; then
      LEGACY_CLASSIFICATION="public-post-link"
      LEGACY_REASON=""
      LEGACY_OBSERVED=""
      LEGACY_REQUIRES_APP_STOP=true
      return 0
    fi
    classify_legacy_refusal "${initial_reason}" "${initial_observed}"
    return 1
  fi

  legacy_post_link_integration_is_recoverable ||
    classify_legacy_refusal install-root "${INSTALL_ROOT}" || return 1
  legacy_post_link_defaults_are_unclaimed ||
    classify_legacy_refusal default-shape:unknown "${INSTALL_ROOT}" || return 1
  LEGACY_CLASSIFICATION="public-post-link"
  LEGACY_REQUIRES_APP_STOP=true
}

classify_markerless_layout() {
  local sentinel="${INSTALL_ROOT}/${OWNERSHIP_SENTINEL_NAME}"

  reset_legacy_classification

  legacy_directory_is_user_owned "${INSTALL_ROOT}" ||
    classify_legacy_refusal install-root "${INSTALL_ROOT}" || return 1
  [[ ! -e "${sentinel}" && ! -L "${sentinel}" ]] ||
    classify_legacy_refusal install-root "${sentinel}" || return 1

  if [[ ! -e "${CURRENT_LINK}" && ! -L "${CURRENT_LINK}" &&
    ! -e "${PREVIOUS_LINK}" && ! -L "${PREVIOUS_LINK}" ]]; then
    legacy_install_root_is_valid false ||
      classify_legacy_refusal install-root "${INSTALL_ROOT}" || return 1
    legacy_cache_root_is_valid ||
      classify_legacy_refusal cache-root "${CACHE_ROOT}" || return 1
    legacy_pre_activation_state_root_is_valid ||
      classify_legacy_refusal state-root "${STATE_DIR}" || return 1
    legacy_pre_activation_integration_is_absent ||
      classify_legacy_refusal app-link "${APP_COMMAND}" || return 1
    LEGACY_CLASSIFICATION="public-pre-activation"
    return 0
  fi

  legacy_install_root_is_valid ||
    classify_legacy_refusal release-inventory "${RELEASES_DIR}" || return 1
  legacy_cache_root_is_valid ||
    classify_legacy_refusal cache-root "${CACHE_ROOT}" || return 1
  if [[ -e "${STATE_FILE}" || -L "${STATE_FILE}" ]]; then
    legacy_state_root_is_valid ||
      classify_legacy_refusal state-root "${STATE_DIR}" || return 1
    LEGACY_CLASSIFICATION="public-stateful"
    LEGACY_REQUIRES_APP_STOP=true
    return 0
  fi
  legacy_pre_activation_state_root_is_valid ||
    classify_legacy_refusal state-root "${STATE_DIR}" || return 1
  classify_state_less_legacy_integration
}

reclassify_interrupted_legacy_recovery() {
  [[ -z "${LEGACY_CLASSIFICATION}" ]] || return 0
  [[ ! -e "${STATE_FILE}" && ! -L "${STATE_FILE}" ]] || return 0
  [[ -e "${CURRENT_LINK}" || -L "${CURRENT_LINK}" ]] || return 0

  reset_legacy_classification
  if ! classify_state_less_legacy_integration; then
    die "interrupted legacy recovery could not be safely revalidated: conflict [${LEGACY_REASON:-install-root}] at $(preflight_escape "${LEGACY_OBSERVED:-${INSTALL_ROOT}}"); existing ownership metadata was preserved; no desktop files or associations were changed; inspect or move aside the conflicting path or association, then rerun devin-desktop-manager ${ACTIVE_COMMAND}"
  fi
  if [[ "${LEGACY_REQUIRES_APP_STOP}" == "true" ]]; then
    require_app_stopped
  fi
}

die_legacy_classification_refusal() {
  local reason="${LEGACY_REASON:-install-root}"
  local observed context="public ${LEGACY_MANAGER_VERSION} installation"

  observed="$(preflight_escape "${LEGACY_OBSERVED:-${INSTALL_ROOT}}")"
  if [[ ! -e "${STATE_FILE}" && ! -L "${STATE_FILE}" &&
    ( -e "${CURRENT_LINK}" || -L "${CURRENT_LINK}" ) ]]; then
    context="public ${LEGACY_MANAGER_VERSION} post-link installation"
  elif [[ ! -e "${CURRENT_LINK}" && ! -L "${CURRENT_LINK}" ]]; then
    context="public ${LEGACY_MANAGER_VERSION} pre-activation installation"
  fi
  die "${context} could not be safely verified; refusing ownership migration: conflict [${reason}] at ${observed}; ownership was not claimed; inspect or move aside the conflicting path or association, then rerun devin-desktop-manager ${ACTIVE_COMMAND}"
}

report_recoverable_legacy_installation() {
  printf 'recoverable Legacy Installation: %s\n' \
    "${LEGACY_CLASSIFICATION}" >&2
  printf '  Run devin-desktop-manager update to adopt it and continue updating.\n' >&2
  printf '  Or run devin-desktop-manager uninstall to remove the managed application.\n' >&2
  printf '  Lifecycle commands revalidate the installation under lock before claiming ownership.\n' >&2
}

upgrade_legacy_release_metadata() {
  local release_dir="$1"
  local metadata="${release_dir}/release.json"
  local temporary="${metadata}.new.$$"

  jq \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${RELEASE_METADATA_SCHEMA_VERSION}" '
    . + {
      schemaVersion: $schema_version,
      managerId: $manager_id
    }
  ' "${metadata}" >"${temporary}" || return 1
  chmod 0600 "${temporary}" || return 1
  mv -Tf -- "${temporary}" "${metadata}"
}

cleanup_install_temporaries() {
  local mode="${1:-owned}"
  local path release_dir

  cleanup_ownership_sentinel_temporaries "${INSTALL_ROOT}" || return 1

  if [[ -e "${RELEASES_DIR}" || -L "${RELEASES_DIR}" ]]; then
    [[ -d "${RELEASES_DIR}" && ! -L "${RELEASES_DIR}" ]] || return 1
    directory_can_be_listed "${RELEASES_DIR}" || return 1
    for release_dir in "${RELEASES_DIR}"/*; do
      [[ -e "${release_dir}" || -L "${release_dir}" ]] || continue
      [[ -d "${release_dir}" && ! -L "${release_dir}" ]] || return 1
      for path in "${release_dir}"/release.json.new.*; do
        [[ -e "${path}" || -L "${path}" ]] || continue
        if [[ "${mode}" == "legacy" ]]; then
          legacy_release_metadata_is_valid "${release_dir}" || return 1
        else
          release_directory_has_ownership_metadata "${release_dir}" || return 1
        fi
        migration_temporary_is_valid "${path}" "release.json.new" || return 1
        rm -f -- "${path}" || return 1
      done
    done
  fi

  for path in "${INSTALL_ROOT}"/.staging-*; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    legacy_staging_temporary_is_valid "${path}" || return 1
    rm -rf -- "${path}" || return 1
  done
  for path in "${INSTALL_ROOT}"/.integration-*; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    legacy_integration_temporary_is_valid "${path}" || return 1
    rm -rf -- "${path}" || return 1
  done
  for path in \
    "${INSTALL_ROOT}"/.current.new.* \
    "${INSTALL_ROOT}"/.previous.new.*; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    case "$(basename "${path}")" in
      .current.new.*)
        legacy_release_link_temporary_is_valid \
          "${path}" ".current.new" || return 1
        ;;
      .previous.new.*)
        legacy_release_link_temporary_is_valid \
          "${path}" ".previous.new" || return 1
        ;;
    esac
    rm -f -- "${path}" || return 1
  done
}

cleanup_legacy_migration_temporaries() {
  local path

  cleanup_install_temporaries legacy || return 1
  cleanup_ownership_sentinel_temporaries "${CACHE_ROOT}" || return 1
  cleanup_ownership_sentinel_temporaries "${STATE_DIR}" || return 1
  for path in "${STATE_FILE}.new."*; do
    [[ -e "${path}" || -L "${path}" ]] || continue
    migration_temporary_is_valid "${path}" "state.json.new" || return 1
    rm -f -- "${path}" || return 1
  done
}

fresh_markerless_install_root_is_valid() {
  local legacy_lock="${INSTALL_ROOT}/.manager.lock"
  local unexpected

  [[ "${LEGACY_LOCK_HELD}" == "true" ]] || return 1
  [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" &&
    -f "${legacy_lock}" && ! -L "${legacy_lock}" &&
    "${legacy_lock}" -ef /proc/self/fd/7 ]] || return 1
  unexpected="$({
    find "${INSTALL_ROOT}" -mindepth 1 -maxdepth 1 \
      ! -name '.manager.lock' \
      ! -name "${OWNERSHIP_SENTINEL_NAME}.new.*" \
      -print -quit
  })" || return 1
  [[ -z "${unexpected}" ]]
}

migrate_legacy_layout_if_needed() {
  local sentinel="${INSTALL_ROOT}/${OWNERSHIP_SENTINEL_NAME}"
  local release_dir
  local pre_activation=false
  local migration_description="public ${LEGACY_MANAGER_VERSION}"

  [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" ]] || return 0
  if fresh_markerless_install_root_is_valid; then
    cleanup_ownership_sentinel_temporaries "${INSTALL_ROOT}" ||
      die "could not safely recover an interrupted installation root ownership marker: ${INSTALL_ROOT}"
    write_ownership_sentinel "${INSTALL_ROOT}" ||
      die "could not mark the fresh installation root as manager-owned: ${INSTALL_ROOT}"
    return 0
  fi
  if root_contains_only_ownership_sentinel_temporaries "${INSTALL_ROOT}"; then
    cleanup_ownership_sentinel_temporaries "${INSTALL_ROOT}" ||
      die "could not safely recover an interrupted installation root ownership marker: ${INSTALL_ROOT}"
  fi
  if [[ -e "${sentinel}" || -L "${sentinel}" ]] ||
    directory_is_empty "${INSTALL_ROOT}"; then
    return 0
  fi

  if ! classify_markerless_layout; then
    die_legacy_classification_refusal
  fi
  case "${LEGACY_CLASSIFICATION}" in
    public-pre-activation) pre_activation=true ;;
    public-post-link|public-stateful) pre_activation=false ;;
    initial-complete)
      pre_activation=false
      migration_description="initial-manager"
      ;;
    *)
      die "unrecognized legacy installation profile; refusing ownership migration"
      ;;
  esac

  if [[ "${LEGACY_REQUIRES_APP_STOP}" == "true" ]]; then
    require_app_stopped
  fi

  info "migrating verified ${migration_description} installation to ownership schema ${OWNERSHIP_SCHEMA_VERSION}"
  cleanup_legacy_migration_temporaries ||
    die "could not clean an interrupted ownership migration"
  while IFS= read -r -d '' release_dir; do
    upgrade_legacy_release_metadata "${release_dir}" ||
      die "could not upgrade legacy release metadata: ${release_dir}"
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -print0)
  if [[ ! -e "${CACHE_ROOT}" && ! -L "${CACHE_ROOT}" ]]; then
    mkdir -p -- "${CACHE_ROOT}" ||
      die "could not recreate the legacy cache root"
    chmod 0700 "${CACHE_ROOT}" ||
      die "could not secure the legacy cache root"
  fi
  if [[ ! -e "${STATE_DIR}" && ! -L "${STATE_DIR}" ]]; then
    mkdir -p -- "${STATE_DIR}" ||
      die "could not recreate the legacy state root"
    chmod 0700 "${STATE_DIR}" ||
      die "could not secure the legacy state root"
  fi
  write_ownership_sentinel "${CACHE_ROOT}" ||
    die "could not mark the legacy cache as manager-owned"
  write_ownership_sentinel "${STATE_DIR}" ||
    die "could not mark the legacy state as manager-owned"
  write_ownership_sentinel "${INSTALL_ROOT}" ||
    die "could not mark the legacy installation as manager-owned"
  if [[ "${pre_activation}" == "false" ]]; then
    prune_releases ||
      die "could not prune superseded releases after ownership migration"
  fi
}

ensure_layout() {
  migrate_legacy_layout_if_needed
  reclassify_interrupted_legacy_recovery
  if owned_root_is_valid "${INSTALL_ROOT}"; then
    cleanup_install_temporaries ||
      die "could not safely recover interrupted installation temporaries"
  fi
  ensure_owned_root "${INSTALL_ROOT}" "installation root"
  [[ ! -L "${RELEASES_DIR}" ]] ||
    die "release directory must not be a symbolic link: ${RELEASES_DIR}"
  mkdir -p -- "${RELEASES_DIR}" "${BIN_DIR}"
  [[ -d "${RELEASES_DIR}" ]] ||
    die "release path is not a directory: ${RELEASES_DIR}"
  ensure_owned_root "${CACHE_ROOT}" "cache root"
  ensure_owned_root "${STATE_DIR}" "state root"
  chmod 0700 "${RELEASES_DIR}"
}

acquire_existing_legacy_lock() {
  local legacy_lock="$1"

  [[ -f "${legacy_lock}" && ! -L "${legacy_lock}" ]] ||
    die "legacy manager lock must be a non-symbolic regular file: ${legacy_lock}"

  if ! exec 7<"${legacy_lock}"; then
    die "could not open the legacy manager lock safely: ${legacy_lock}"
  fi
  validate_lock_descriptor_identity 7 "${legacy_lock}" "legacy manager lifecycle"
  flock -n 7 || die "another Devin Desktop manager operation is running (${ACTIVE_COMMAND}: legacy manager lifecycle lock is active); do not delete the lock file; rerun the same command after it exits"
  validate_lock_descriptor_identity 7 "${legacy_lock}" "legacy manager lifecycle"
  LEGACY_LOCK_HELD=true
}

acquire_legacy_lock_if_needed() {
  local legacy_lock="${INSTALL_ROOT}/.manager.lock"
  local sentinel="${INSTALL_ROOT}/${OWNERSHIP_SENTINEL_NAME}"
  local install_parent

  if [[ -e "${TRANSACTION_JOURNAL}" || -L "${TRANSACTION_JOURNAL}" ]]; then
    if [[ -e "${INSTALL_ROOT}" || -L "${INSTALL_ROOT}" ]]; then
      [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" ]] ||
        die "installation root is unsafe during transaction recovery: ${INSTALL_ROOT}"
      acquire_existing_legacy_lock "${legacy_lock}"
    fi
    return 0
  fi
  install_parent="$(dirname "${INSTALL_ROOT}")"

  if [[ ! -e "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" ]]; then
    mkdir -p -- "${install_parent}"
    mkdir -- "${INSTALL_ROOT}" 2>/dev/null || true
  fi
  [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" ]] || return 0
  if [[ -e "${sentinel}" || -L "${sentinel}" ]]; then
    owned_root_is_valid "${INSTALL_ROOT}" || return 0
    if [[ ! -e "${legacy_lock}" && ! -L "${legacy_lock}" ]]; then
      if ! (set -o noclobber; : >"${legacy_lock}") 2>/dev/null; then
        [[ -e "${legacy_lock}" || -L "${legacy_lock}" ]] ||
          die "could not create the public manager lock safely: ${legacy_lock}"
      fi
    fi
    acquire_existing_legacy_lock "${legacy_lock}"
    return 0
  fi
  if [[ ! -e "${legacy_lock}" && ! -L "${legacy_lock}" ]]; then
    if ! directory_is_empty "${INSTALL_ROOT}" &&
      ! {
        legacy_install_root_is_valid false false &&
          legacy_cache_root_is_valid &&
          legacy_pre_activation_state_root_is_valid &&
          legacy_pre_activation_integration_is_absent
      }; then
      return 0
    fi
    if ! (set -o noclobber; : >"${legacy_lock}") 2>/dev/null; then
      [[ -e "${legacy_lock}" || -L "${legacy_lock}" ]] ||
        die "could not create the public manager lock safely: ${legacy_lock}"
    fi
  fi
  acquire_existing_legacy_lock "${legacy_lock}"
}

acquire_lock() {
  local lock_links

  require_commands stat
  if [[ -n "${LIFECYCLE_LOCK_FD}" ]]; then
    validate_state_home_security
    validate_inherited_lock_descriptor 8 "${LOCK_FILE}" "manager lifecycle"
  else
    mkdir -p -- "${STATE_HOME}"
    validate_state_home_security
    if [[ ! -e "${LOCK_FILE}" && ! -L "${LOCK_FILE}" ]]; then
      (set -o noclobber; : >"${LOCK_FILE}") 2>/dev/null ||
        die "could not create the manager lock safely: ${LOCK_FILE}"
    fi
    [[ -f "${LOCK_FILE}" && ! -L "${LOCK_FILE}" ]] ||
      die "manager lock must be a non-symbolic regular file: ${LOCK_FILE}"
    lock_links="$(stat -c '%h' -- "${LOCK_FILE}")" ||
      die "could not inspect the manager lock: ${LOCK_FILE}"
    [[ "${lock_links}" == "1" ]] ||
      die "manager lock must not have hard links: ${LOCK_FILE}"
    exec 8<>"${LOCK_FILE}" || die "could not open the manager lock: ${LOCK_FILE}"
    validate_lock_descriptor_identity 8 "${LOCK_FILE}" "manager lifecycle"
    validate_inherited_lock_descriptor 8 "${LOCK_FILE}" "manager lifecycle"
  fi
  recover_transaction_partials
  recover_pending_transaction_discard
  if [[ -n "${LEGACY_LOCK_FD}" ]]; then
    validate_inherited_lock_descriptor 7 "${INSTALL_ROOT}/.manager.lock" \
      "legacy manager lifecycle"
    LEGACY_LOCK_HELD=true
  else
    acquire_legacy_lock_if_needed
  fi
  recover_pending_transaction
  recover_pending_uninstall_cleanup
  recover_pending_release_prune
  ensure_layout
}

release_link_target() {
  local link_path="$1"
  local target release_name

  [[ -L "${link_path}" ]] || return 1
  target="$(readlink "${link_path}")"
  [[ "${target}" == releases/* && "${target}" != *"/"*"/"* ]] || return 1
  release_name="${target#releases/}"
  is_safe_release_identifier "${release_name}" || return 1
  printf '%s\n' "${target}"
}

release_target() {
  local link_path="$1"
  local target

  target="$(release_link_target "${link_path}")" || return 1
  [[ -d "${INSTALL_ROOT}/${target}" ]] || return 1
  printf '%s\n' "${target}"
}

release_path() {
  local link_path="$1"
  local target

  target="$(release_target "${link_path}")" || return 1
  printf '%s\n' "${INSTALL_ROOT}/${target}"
}

release_label() {
  local release_dir="$1"

  if [[ -f "${release_dir}/release.json" ]]; then
    jq -r '"\(.windsurfVersion) (\(.build[0:12]))"' \
      "${release_dir}/release.json" 2>/dev/null || basename "${release_dir}"
  else
    basename "${release_dir}"
  fi
}

app_is_running() {
  local process_path executable

  for process_path in /proc/[0-9]*; do
    executable="$(readlink "${process_path}/exe" 2>/dev/null || true)"
    executable="${executable% (deleted)}"
    case "${executable}" in
      "${RELEASES_DIR}"/*/app/devin-desktop|\
        "${RELEASES_DIR}"/*/app/bin/devin-desktop|\
        "${INSTALL_ROOT}"/.release-prune-*/app/devin-desktop|\
        "${INSTALL_ROOT}"/.release-prune-*/app/bin/devin-desktop|\
        "${INSTALL_ROOT}".uninstall-*/releases/*/app/devin-desktop|\
        "${INSTALL_ROOT}".uninstall-*/releases/*/app/bin/devin-desktop) return 0 ;;
    esac
  done

  return 1
}

require_app_stopped() {
  if app_is_running; then
    die "Devin Desktop is running; close it before changing managed releases"
  fi
}

is_safe_release_identifier() {
  local value="$1"

  [[ "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]]
}

release_identifier() {
  local version="$1"
  local build="$2"
  local sha256="$3"
  local identifier

  identifier="${version:0:102}-${build:0:12}-${sha256:0:12}"
  is_safe_release_identifier "${identifier}" || return 1
  printf '%s\n' "${identifier}"
}

fetch_manifest() {
  local manifest manifest_file fetch_status
  local url sha256 version build product_version timestamp display_name
  local url_prefix url_path url_build url_filename expected_filename
  manifest_file="$(mktemp "${TMPDIR:-/tmp}/devin-desktop-manager.manifest.XXXXXXXX")" ||
    die "could not create a private manifest temporary"
  if curl_fetch_file "${MANIFEST_URL}" "${manifest_file}" \
    "${MANIFEST_MAX_BYTES}" 60; then
    :
  else
    fetch_status=$?
    rm -f -- "${manifest_file}"
    ((fetch_status != CURL_FETCH_SIZE_LIMIT_STATUS)) ||
      die "official manifest is empty or exceeds ${MANIFEST_MAX_BYTES} bytes"
    die "could not fetch the official stable manifest"
  fi
  manifest="$(cat -- "${manifest_file}")" || {
    rm -f -- "${manifest_file}"
    die "could not read the official stable manifest"
  }
  rm -f -- "${manifest_file}"

  ((${#manifest} > 0 && ${#manifest} <= MANIFEST_MAX_BYTES)) ||
    die "official manifest is empty or exceeds ${MANIFEST_MAX_BYTES} bytes"

  jq -e '
    (.url | type == "string") and
    (.sha256hash | type == "string") and
    (.windsurfVersion | type == "string") and
    (.version | type == "string") and
    (.productVersion | type == "string") and
    (.timestamp | type == "number") and
    (.displayName | type == "string")
  ' <<<"${manifest}" >/dev/null || die "official manifest is missing required fields"

  url="$(jq -r '.url' <<<"${manifest}")"
  sha256="$(jq -r '.sha256hash' <<<"${manifest}")"
  version="$(jq -r '.windsurfVersion' <<<"${manifest}")"
  build="$(jq -r '.version' <<<"${manifest}")"
  product_version="$(jq -r '.productVersion' <<<"${manifest}")"
  timestamp="$(jq -r '.timestamp' <<<"${manifest}")"
  display_name="$(jq -r '.displayName' <<<"${manifest}")"

  is_safe_release_identifier "${version}" ||
    die "official manifest returned an unsafe stable version identifier"
  is_safe_release_identifier "${build}" ||
    die "official manifest returned an unsafe build identifier"
  is_safe_release_identifier "${product_version}" ||
    die "official manifest returned an unsafe product version identifier"

  url_prefix="https://windsurf-stable.codeiumdata.com/linux-x64-deb/stable/"
  [[ "${url}" == "${url_prefix}"* ]] ||
    die "official manifest returned an unexpected artifact URL"
  url_path="${url#"${url_prefix}"}"
  [[ "${url_path}" == */* && "${url_path#*/}" != */* ]] ||
    die "official manifest returned an unexpected artifact path"
  url_build="${url_path%%/*}"
  url_filename="${url_path#*/}"
  expected_filename="Devin-linux-x64-${version}.deb"
  [[ "${url_build}" == "${build}" ]] ||
    die "artifact URL build does not match the manifest"
  [[ "${url_filename}" == "${expected_filename}" ]] ||
    die "artifact URL version does not match the manifest"
  [[ "${sha256}" =~ ^[0-9a-f]{64}$ ]] ||
    die "official manifest returned an invalid SHA-256"
  [[ "${timestamp}" =~ ^[0-9]+$ ]] ||
    die "official manifest returned an invalid timestamp"
  [[ -n "${display_name}" ]] ||
    die "official manifest returned an empty platform name"

  printf '%s\n' "${manifest}"
}

manifest_matches_current() {
  local manifest="$1"
  local current_dir expected_hash expected_url

  current_dir="$(release_path "${CURRENT_LINK}")" || return 1
  [[ -f "${current_dir}/release.json" ]] || return 1

  expected_hash="$(jq -r '.sha256hash' <<<"${manifest}")"
  expected_url="$(jq -r '.url' <<<"${manifest}")"

  [[ "$(jq -r '.sha256 // empty' "${current_dir}/release.json")" == "${expected_hash}" &&
    "$(jq -r '.artifactUrl // empty' "${current_dir}/release.json")" == "${expected_url}" ]]
}

reject_manifest_downgrade() {
  local manifest="$1"
  local current_dir current_timestamp manifest_timestamp

  current_dir="$(release_path "${CURRENT_LINK}")" || return 0
  [[ -f "${current_dir}/release.json" ]] ||
    die "active release metadata is missing"

  current_timestamp="$(jq -r '.releaseTimestamp // empty' "${current_dir}/release.json")"
  manifest_timestamp="$(jq -r '.timestamp' <<<"${manifest}")"
  [[ "${current_timestamp}" =~ ^[0-9]+$ ]] ||
    die "active release metadata has an invalid timestamp"

  if ((manifest_timestamp < current_timestamp)); then
    die "official manifest is older than the active release; refusing an automatic downgrade"
  fi
}

normalize_archive_member() {
  local member="$1"

  while [[ "${member}" == ./* ]]; do
    member="${member#./}"
  done
  member="${member%/}"
  printf '%s\n' "${member}"
}

validate_member_path() {
  local member="$1"

  [[ -n "${member}" && "${member}" != /* &&
    "${member}" != ".." && "${member}" != ../* &&
    "${member}" != */../* && "${member}" != */.. ]] ||
    die "archive contains an unsafe member path"
}

validate_deb() {
  local artifact="$1"
  local expected_version="$2"
  local debian_count=0 control_count=0 data_count=0
  local member normalized control_member="" data_member=""
  local control_text package_version normalized_version
  local members_file="${STAGING_PATH}/deb-members.txt"
  local control_members_file="${STAGING_PATH}/control-members.txt"
  local debian_version
  declare -A seen_members=()

  bsdtar -tf "${artifact}" >"${members_file}" ||
    die "download is not a readable Debian package"

  while IFS= read -r member; do
    normalized="$(normalize_archive_member "${member}")"
    validate_member_path "${normalized}"
    [[ -z "${seen_members["${normalized}"]+present}" ]] ||
      die "Debian package contains a duplicate member: ${normalized}"
    seen_members["${normalized}"]=1

    case "${normalized}" in
      debian-binary)
        ((debian_count += 1))
        ;;
      control.tar.*)
        ((control_count += 1))
        control_member="${member}"
        ;;
      data.tar.*)
        ((data_count += 1))
        data_member="${member}"
        ;;
      *)
        die "Debian package contains an unexpected member: ${normalized}"
        ;;
    esac
  done <"${members_file}"

  ((debian_count == 1 && control_count == 1 && data_count == 1)) ||
    die "download is not a supported Debian package"

  debian_version="$(bsdtar -xOf "${artifact}" \
    "$(awk '
      {
        value = $0
        sub(/^\.\//, "", value)
        if (value == "debian-binary") {
          print
          exit
        }
      }
    ' "${members_file}")")" ||
    die "could not inspect the Debian package version"
  [[ "${debian_version//$'\n'/}" == "2.0" ]] ||
    die "download uses an unsupported Debian package format"

  bsdtar -xOf "${artifact}" "${control_member}" |
    bsdtar -tf - >"${control_members_file}" ||
    die "could not inspect Debian package metadata"

  while IFS= read -r member; do
    normalized="$(normalize_archive_member "${member}")"
    [[ -n "${normalized}" ]] || continue
    validate_member_path "${normalized}"
  done <"${control_members_file}"

  (($(awk '
    {
      value = $0
      while (sub(/^\.\//, "", value)) {}
      sub(/\/$/, "", value)
      if (value == "control") count++
    }
    END { print count + 0 }
  ' "${control_members_file}") == 1)) ||
    die "Debian package metadata is missing or duplicated"

  control_text="$(
    bsdtar -xOf "${artifact}" "${control_member}" | bsdtar -xOf - ./control
  )" || die "could not read Debian package metadata"

  if [[ "$(grep -c '^Package:' <<<"${control_text}")" -ne 1 ]] ||
    ! grep -qx 'Package: devin-desktop' <<<"${control_text}"; then
    die "downloaded package identity is not devin-desktop"
  fi
  if [[ "$(grep -c '^Architecture:' <<<"${control_text}")" -ne 1 ]] ||
    ! grep -qx 'Architecture: amd64' <<<"${control_text}"; then
    die "downloaded package architecture is not amd64"
  fi
  [[ "$(grep -c '^Version:' <<<"${control_text}")" -eq 1 ]] ||
    die "downloaded package version metadata is missing or duplicated"

  package_version="$(awk -F ': ' '$1 == "Version" { print $2; exit }' <<<"${control_text}")"
  normalized_version="${package_version#*:}"
  case "${normalized_version}" in
    "${expected_version}"|"${expected_version}"-*) ;;
    *) die "downloaded package version does not match the manifest" ;;
  esac

  printf '%s\n' "${data_member}"
}

validate_archive_paths() {
  local artifact="$1"
  local data_member="$2"
  local member_list="$3"
  local verbose_list="${member_list}.verbose"
  local member normalized line link_target link_member resolved_target
  declare -A seen_members=()

  bsdtar -xOf "${artifact}" "${data_member}" | bsdtar -tf - >"${member_list}" ||
    die "could not inspect the application payload"

  while IFS= read -r member; do
    normalized="$(normalize_archive_member "${member}")"
    [[ -n "${normalized}" ]] || continue
    validate_member_path "${normalized}"
    [[ -z "${seen_members["${normalized}"]+present}" ]] ||
      die "application payload contains a duplicate path: ${normalized}"
    seen_members["${normalized}"]=1
  done <"${member_list}"

  bsdtar -xOf "${artifact}" "${data_member}" |
    LC_ALL=C bsdtar -tvf - >"${verbose_list}" ||
    die "could not inspect application payload link metadata"
  while IFS= read -r line; do
    case "${line:0:1}" in
      h)
        [[ "${line}" == *" link to "* ]] ||
          die "application payload contains malformed hard link metadata"
        link_target="${line##* link to }"
        normalized="$(normalize_archive_member "${link_target}")"
        validate_member_path "${normalized}"
        [[ -n "${seen_members["${normalized}"]+present}" ]] ||
          die "application payload hard link target is outside the payload"
        ;;
      l)
        [[ "${line}" == *" -> "* ]] ||
          die "application payload contains malformed symbolic link metadata"
        link_target="${line##* -> }"
        [[ "${link_target}" != /* ]] ||
          die "application payload contains a link that escapes its extraction root"
        link_member=""
        for member in "${!seen_members[@]}"; do
          if [[ "${line}" == *" ./${member} -> ${link_target}" ||
            "${line}" == *" ${member} -> ${link_target}" ]]; then
            link_member="${member}"
            break
          fi
        done
        [[ -n "${link_member}" ]] ||
          die "application payload contains ambiguous symbolic link metadata"
        resolved_target="$(
          readlink -m -- "/payload/$(dirname "${link_member}")/${link_target}"
        )"
        case "${resolved_target}" in
          /payload|/payload/*) ;;
          *) die "application payload contains a link that escapes its extraction root" ;;
        esac
        ;;
    esac
  done <"${verbose_list}"

  for member in \
    usr/share/devin-desktop/devin-desktop \
    usr/share/devin-desktop/bin/devin-desktop \
    usr/share/applications/devin-desktop.desktop \
    usr/share/applications/devin-desktop-url-handler.desktop \
    usr/share/pixmaps/devin-desktop.png \
    usr/share/mime/packages/devin-desktop-workspace.xml; do
    [[ -n "${seen_members["${member}"]+present}" ]] ||
      die "application payload is missing required path: ${member}"
  done
}

validate_extracted_links() {
  local root="$1"
  local link_path link_target resolved

  while IFS= read -r -d '' link_path; do
    link_target="$(readlink "${link_path}")"
    resolved="$(readlink -m -- "$(dirname "${link_path}")/${link_target}")"
    case "${resolved}" in
      "${root}"/*) ;;
      *) die "application payload contains a link that escapes its extraction root" ;;
    esac
  done < <(find "${root}" -type l -print0)
}

validate_release() {
  local release_dir="$1"
  local expected_build="${2:-}"
  local expected_product_version="${3:-}"
  local app_dir="${release_dir}/app"
  local version_text build_output architecture_output probe_status
  local -a version_output=()

  [[ -x "${app_dir}/devin-desktop" && ! -L "${app_dir}/devin-desktop" ]] ||
    die "release is missing the Devin Desktop executable"
  [[ -x "${app_dir}/bin/devin-desktop" && ! -L "${app_dir}/bin/devin-desktop" ]] ||
    die "release is missing the terminal launcher"
  [[ -f "${release_dir}/release.json" && ! -L "${release_dir}/release.json" ]] ||
    die "release is missing manager metadata"
  [[ -f "${release_dir}/integration/devin-desktop.png" &&
    ! -L "${release_dir}/integration/devin-desktop.png" ]] ||
    die "release is missing its integration icon"
  [[ -f "${release_dir}/integration/devin-desktop-workspace.xml" &&
    ! -L "${release_dir}/integration/devin-desktop-workspace.xml" ]] ||
    die "release is missing its MIME declaration"

  if ldd "${app_dir}/devin-desktop" 2>&1 | grep -q 'not found'; then
    die "release has missing runtime libraries"
  fi

  if version_text="$(
    timeout --signal=TERM --kill-after=5s 30s \
      "${app_dir}/bin/devin-desktop" --version
  )"; then
    :
  else
    probe_status=$?
    case "${probe_status}" in
      124|137) die "release version probe timed out" ;;
      *) die "release version probe failed" ;;
    esac
  fi
  mapfile -t version_output <<<"${version_text}"
  ((${#version_output[@]} >= 3)) ||
    die "release version probe returned incomplete output"

  build_output="${version_output[1]}"
  architecture_output="${version_output[2]}"
  case "${architecture_output}" in
    x64|x86_64|amd64) ;;
    *) die "release version probe returned an unexpected architecture" ;;
  esac
  if [[ -n "${expected_build}" && "${build_output}" != "${expected_build}" ]]; then
    die "release build does not match the official manifest"
  fi
  if [[ -n "${expected_product_version}" &&
    "${version_output[0]}" != "${expected_product_version}" ]]; then
    die "release product version does not match the official manifest"
  fi
}

write_release_metadata() {
  local destination="$1"
  local manifest="$2"
  local installed_at

  installed_at="$(date --utc +'%Y-%m-%dT%H:%M:%SZ')"
  jq -n \
    --arg managerId "${MANAGER_ID}" \
    --argjson schemaVersion "${RELEASE_METADATA_SCHEMA_VERSION}" \
    --arg windsurfVersion "$(jq -r '.windsurfVersion' <<<"${manifest}")" \
    --arg productVersion "$(jq -r '.productVersion' <<<"${manifest}")" \
    --arg build "$(jq -r '.version' <<<"${manifest}")" \
    --arg artifactUrl "$(jq -r '.url' <<<"${manifest}")" \
    --arg sha256 "$(jq -r '.sha256hash' <<<"${manifest}")" \
    --argjson releaseTimestamp "$(jq -r '.timestamp' <<<"${manifest}")" \
    --arg installedAt "${installed_at}" \
    '{
      schemaVersion: $schemaVersion,
      managerId: $managerId,
      windsurfVersion: $windsurfVersion,
      productVersion: $productVersion,
      build: $build,
      artifactUrl: $artifactUrl,
      sha256: $sha256,
      releaseTimestamp: $releaseTimestamp,
      installedAt: $installedAt
    }' >"${destination}"
  chmod 0600 "${destination}"
}

assemble_release() {
  local artifact="$1"
  local manifest="$2"
  local destination="$3"
  local data_member member_list app_source integration_source
  local build product_version

  STAGING_PATH="${INSTALL_ROOT}/.staging-$(basename "${destination}")-$$"
  mkdir -p -- "${STAGING_PATH}/root" "${STAGING_PATH}/release/integration"

  data_member="$(validate_deb "${artifact}" "$(jq -r '.windsurfVersion' <<<"${manifest}")")"
  member_list="${STAGING_PATH}/archive-members.txt"
  validate_archive_paths "${artifact}" "${data_member}" "${member_list}"

  bsdtar -xOf "${artifact}" "${data_member}" |
    bsdtar -xf - --no-same-owner -C "${STAGING_PATH}/root" ||
    die "could not extract the application payload"
  validate_extracted_links "${STAGING_PATH}/root"

  app_source="${STAGING_PATH}/root/usr/share/devin-desktop"
  integration_source="${STAGING_PATH}/root/usr/share"
  [[ -d "${app_source}" && ! -L "${app_source}" ]] ||
    die "application payload has an invalid application directory"

  mv -- "${app_source}" "${STAGING_PATH}/release/app"
  cp -- "${integration_source}/pixmaps/devin-desktop.png" \
    "${STAGING_PATH}/release/integration/devin-desktop.png"
  cp -- "${integration_source}/mime/packages/devin-desktop-workspace.xml" \
    "${STAGING_PATH}/release/integration/devin-desktop-workspace.xml"
  chmod 0644 \
    "${STAGING_PATH}/release/integration/devin-desktop.png" \
    "${STAGING_PATH}/release/integration/devin-desktop-workspace.xml"
  write_release_metadata "${STAGING_PATH}/release/release.json" "${manifest}"

  build="$(jq -r '.version' <<<"${manifest}")"
  product_version="$(jq -r '.productVersion' <<<"${manifest}")"
  validate_release "${STAGING_PATH}/release" "${build}" "${product_version}"

  mv -- "${STAGING_PATH}/release" "${destination}"
  rm -rf -- "${STAGING_PATH}"
  STAGING_PATH=""
}

set_managed_link() {
  local link_path="$1"
  local target="$2"
  local temporary

  temporary="${INSTALL_ROOT}/.$(basename "${link_path}").new.$$"
  rm -f -- "${temporary}"
  ln -s -- "${target}" "${temporary}"
  mv -Tf -- "${temporary}" "${link_path}"
}

state_is_valid() {
  [[ -f "${STATE_FILE}" && ! -L "${STATE_FILE}" ]] || return 1
  jq -e --argjson schema_version "${STATE_SCHEMA_VERSION}" '
    .schemaVersion == $schema_version and
    (.managerVersion | type == "string") and
    (.originalDefaults | type == "object") and
    (.managedFiles | type == "object")
  ' "${STATE_FILE}" >/dev/null 2>&1
}

validate_state_or_absent() {
  if [[ -e "${STATE_FILE}" || -L "${STATE_FILE}" ]]; then
    state_is_valid ||
      die "manager state is invalid or unsafe: ${STATE_FILE}"
  fi
}

managed_file_matches_state() {
  local key="$1"
  local path="$2"
  local expected_path expected_hash

  state_is_valid || return 1
  expected_path="$(jq -r --arg key "${key}" \
    '.managedFiles[$key].path // empty' "${STATE_FILE}")"
  expected_hash="$(jq -r --arg key "${key}" \
    '.managedFiles[$key].sha256 // empty' "${STATE_FILE}")"
  [[ "${expected_path}" == "${path}" && "${expected_hash}" =~ ^[0-9a-f]{64}$ ]] ||
    return 1
  [[ -f "${path}" && ! -L "${path}" ]] || return 1
  [[ "$(sha256sum "${path}" | awk '{print $1}')" == "${expected_hash}" ]]
}

ensure_regular_path_manageable() {
  local path="$1"
  local key="$2"
  local marker_allowed="${3:-false}"
  local release_asset="${4:-}"

  [[ -e "${path}" || -L "${path}" ]] || return 0
  [[ -f "${path}" && ! -L "${path}" ]] ||
    die "${path} exists and is not a manager-owned regular file"

  if state_is_valid; then
    managed_file_matches_state "${key}" "${path}" ||
      die "${path} was modified and cannot be safely replaced"
    return
  fi
  if [[ "${marker_allowed}" == "true" ]] &&
    grep -qx "${MANAGER_DESKTOP_MARKER}" "${path}"; then
    return 0
  fi
  if [[ -n "${release_asset}" ]] &&
    asset_matches_release "${path}" "${release_asset}"; then
    return 0
  fi

  die "${path} exists or was modified and cannot be safely replaced"
}

ensure_app_command_manageable() {
  [[ -e "${APP_COMMAND}" || -L "${APP_COMMAND}" ]] || return 0
  [[ -L "${APP_COMMAND}" ]] ||
    die "${APP_COMMAND} exists and is not a manager-owned symlink"
  [[ "$(readlink "${APP_COMMAND}")" == "${CURRENT_LINK}/app/bin/devin-desktop" ]] ||
    die "${APP_COMMAND} points outside the managed installation"
}

ensure_integration_manageable() {
  validate_state_or_absent
  ensure_app_command_manageable
  ensure_regular_path_manageable "${MAIN_DESKTOP}" mainDesktop true
  ensure_regular_path_manageable "${URL_DESKTOP}" urlDesktop true
  ensure_regular_path_manageable \
    "${ICON_FILE}" icon false devin-desktop.png
  ensure_regular_path_manageable \
    "${MIME_FILE}" mime false devin-desktop-workspace.xml
}

write_desktop_entries() {
  local main_destination="$1"
  local url_destination="$2"
  local escaped_command

  escaped_command="$(desktop_escape_command "${APP_COMMAND}")"

  cat >"${main_destination}" <<EOF
[Desktop Entry]
Name=Devin
Comment=Tomorrow's Editor, Today.
GenericName=Text Editor
Exec="${escaped_command}" %F
Icon=${ICON_NAME}
Type=Application
StartupNotify=false
StartupWMClass=Devin
Categories=TextEditor;Development;IDE;
MimeType=${MIME_WORKSPACE};
Actions=new-empty-window;
Keywords=vscode;
${MANAGER_DESKTOP_MARKER}

[Desktop Action new-empty-window]
Name=New Empty Window
Exec="${escaped_command}" --new-window %F
Icon=${ICON_NAME}
EOF

  cat >"${url_destination}" <<EOF
[Desktop Entry]
Name=Devin - URL Handler
Comment=Tomorrow's Editor, Today.
GenericName=Text Editor
Exec="${escaped_command}" --open-url %U
Icon=${ICON_NAME}
Type=Application
NoDisplay=true
StartupNotify=true
StartupWMClass=Devin
Categories=Utility;TextEditor;Development;IDE;
MimeType=${MIME_DEVIN};${MIME_WINDSURF};
Keywords=vscode;
${MANAGER_DESKTOP_MARKER}
EOF
  chmod 0644 "${main_destination}" "${url_destination}"
}

build_integration_stage() {
  local release_dir="$1"

  require_integration_commands
  ensure_integration_manageable
  [[ -f "${release_dir}/integration/devin-desktop.png" ]] ||
    die "release integration icon is missing"
  [[ -f "${release_dir}/integration/devin-desktop-workspace.xml" ]] ||
    die "release MIME declaration is missing"

  INTEGRATION_STAGE="${INSTALL_ROOT}/.integration-$$"
  mkdir -p "${INTEGRATION_STAGE}"
  write_desktop_entries \
    "${INTEGRATION_STAGE}/${MAIN_DESKTOP_ID}" \
    "${INTEGRATION_STAGE}/${URL_DESKTOP_ID}"
  cp -- "${release_dir}/integration/devin-desktop.png" \
    "${INTEGRATION_STAGE}/${ICON_NAME}.png"
  cp -- "${release_dir}/integration/devin-desktop-workspace.xml" \
    "${INTEGRATION_STAGE}/devin-desktop-manager-workspace.xml"
  chmod 0644 "${INTEGRATION_STAGE}/${ICON_NAME}.png" \
    "${INTEGRATION_STAGE}/devin-desktop-manager-workspace.xml"

  desktop-file-validate \
    "${INTEGRATION_STAGE}/${MAIN_DESKTOP_ID}" \
    "${INTEGRATION_STAGE}/${URL_DESKTOP_ID}"
}

atomic_copy() {
  local source="$1"
  local destination="$2"
  local mode="$3"
  local temporary="${destination}.new.$$"

  mkdir -p -- "$(dirname "${destination}")"
  rm -f -- "${temporary}"
  cp -- "${source}" "${temporary}"
  chmod "${mode}" "${temporary}"
  mv -Tf -- "${temporary}" "${destination}"
}

atomic_app_link() {
  local temporary="${APP_COMMAND}.new.$$"

  mkdir -p -- "${BIN_DIR}"
  rm -f -- "${temporary}"
  ln -s -- "${CURRENT_LINK}/app/bin/devin-desktop" "${temporary}"
  mv -Tf -- "${temporary}" "${APP_COMMAND}"
}

query_default() {
  local current status

  if current="$(xdg-mime query default "$1" 2>/dev/null)"; then
    printf '%s\n' "${current}"
    return 0
  else
    status=$?
  fi
  if [[ "${status}" -eq 4 && -z "${current}" &&
    "${KDE_SESSION_VERSION:-}" =~ ^[1-5]$ &&
    ("${XDG_CURRENT_DESKTOP:-}" == "KDE" ||
      -n "${KDE_FULL_SESSION:-}") ]]; then
    printf '\n'
    return 0
  fi
  return "${status}"
}

normalize_original_default() {
  local value="$1"

  case "${value}" in
    "${MAIN_DESKTOP_ID}"|"${URL_DESKTOP_ID}")
      printf '\n'
      ;;
    "${LEGACY_MAIN_DESKTOP_ID}"|"${LEGACY_URL_DESKTOP_ID}")
      if legacy_desktop_id_owned "${value}"; then
        printf '\n'
      else
        printf '%s\n' "${value}"
      fi
      ;;
    *)
      printf '%s\n' "${value}"
      ;;
  esac
}

original_default() {
  local mime_type="$1"
  local current

  if state_is_valid; then
    jq -r --arg mime "${mime_type}" \
      '.originalDefaults[$mime] // ""' "${STATE_FILE}"
    return
  fi

  current="$(query_default "${mime_type}")" || return 1
  normalize_original_default "${current}"
}

is_safe_desktop_id() {
  local value="$1"

  [[ -z "${value}" || "${value}" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*\.desktop$ ]]
}

register_one_association() {
  local mime_type="$1"
  local desktop_id="$2"
  local force="$3"
  local current

  current="$(query_default "${mime_type}")" || return 1
  if [[ "${force}" == "true" ]]; then
    xdg-mime default "${desktop_id}" "${mime_type}" || return 1
    return 0
  fi

  case "${current}" in
    ""|"${desktop_id}")
      xdg-mime default "${desktop_id}" "${mime_type}" || return 1
      ;;
    "${LEGACY_MAIN_DESKTOP_ID}"|"${LEGACY_URL_DESKTOP_ID}")
      if legacy_desktop_id_owned "${current}"; then
        xdg-mime default "${desktop_id}" "${mime_type}" || return 1
      else
        warn "leaving existing default for ${mime_type} unchanged: ${current}"
      fi
      ;;
    *)
      warn "leaving existing default for ${mime_type} unchanged: ${current}"
      ;;
  esac
}

register_associations() {
  local force="${1:-false}"

  register_one_association "${MIME_DEVIN}" "${URL_DESKTOP_ID}" "${force}" ||
    return 1
  record_user_configuration_results || return 1
  register_one_association "${MIME_WINDSURF}" "${URL_DESKTOP_ID}" "${force}" ||
    return 1
  record_user_configuration_results || return 1
  register_one_association "${MIME_WORKSPACE}" "${MAIN_DESKTOP_ID}" "${force}" ||
    return 1
  record_user_configuration_results
}

legacy_desktop_owned() {
  local path="$1"

  legacy_desktop_is_user_regular "${path}" &&
    grep -qx "${MANAGER_DESKTOP_MARKER}" "${path}"
}

legacy_desktop_id_owned() {
  local desktop_id="$1"

  case "${desktop_id}" in
    "${LEGACY_MAIN_DESKTOP_ID}")
      legacy_desktop_owned "${LEGACY_MAIN_DESKTOP}"
      ;;
    "${LEGACY_URL_DESKTOP_ID}")
      legacy_desktop_owned "${LEGACY_URL_DESKTOP}"
      ;;
    *)
      return 1
      ;;
  esac
}

asset_matches_release() {
  local path="$1"
  local release_name="$2"
  local release_dir path_hash release_hash

  legacy_file_is_user_regular "${path}" || return 1
  path_hash="$(sha256sum "${path}" 2>/dev/null | awk '{print $1}')" || return 1
  [[ "${path_hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
  for release_dir in \
    "$(release_path "${CURRENT_LINK}" 2>/dev/null || true)" \
    "$(release_path "${PREVIOUS_LINK}" 2>/dev/null || true)"; do
    [[ -n "${release_dir}" && -f "${release_dir}/integration/${release_name}" ]] ||
      continue
    release_hash="$(
      sha256sum "${release_dir}/integration/${release_name}" 2>/dev/null |
        awk '{print $1}'
    )" || return 1
    [[ "${release_hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
    if [[ "${path_hash}" == "${release_hash}" ]]; then
      return 0
    fi
  done
  return 1
}

remove_legacy_integration() {
  local legacy_assets_owned=false

  if legacy_desktop_owned "${LEGACY_MAIN_DESKTOP}" &&
    legacy_desktop_owned "${LEGACY_URL_DESKTOP}"; then
    legacy_assets_owned=true
  fi
  if legacy_desktop_owned "${LEGACY_MAIN_DESKTOP}"; then
    rm -f -- "${LEGACY_MAIN_DESKTOP}" || return 1
  fi
  if legacy_desktop_owned "${LEGACY_URL_DESKTOP}"; then
    rm -f -- "${LEGACY_URL_DESKTOP}" || return 1
  fi
  if [[ "${legacy_assets_owned}" == "true" ]] &&
    asset_matches_release "${LEGACY_ICON_FILE}" devin-desktop.png; then
    rm -f -- "${LEGACY_ICON_FILE}" || return 1
  fi
  if [[ "${legacy_assets_owned}" == "true" ]] &&
    asset_matches_release "${LEGACY_MIME_FILE}" devin-desktop-workspace.xml; then
    rm -f -- "${LEGACY_MIME_FILE}" || return 1
  fi
}

write_state() {
  local original_devin="$1"
  local original_windsurf="$2"
  local original_workspace="$3"
  local temporary="${STATE_FILE}.new.$$"
  local main_hash url_hash icon_hash mime_hash

  is_safe_desktop_id "${original_devin}" ||
    die "existing default for ${MIME_DEVIN} is unsafe"
  is_safe_desktop_id "${original_windsurf}" ||
    die "existing default for ${MIME_WINDSURF} is unsafe"
  is_safe_desktop_id "${original_workspace}" ||
    die "existing default for ${MIME_WORKSPACE} is unsafe"

  main_hash="$(sha256sum "${MAIN_DESKTOP}" | awk '{print $1}')"
  url_hash="$(sha256sum "${URL_DESKTOP}" | awk '{print $1}')"
  icon_hash="$(sha256sum "${ICON_FILE}" | awk '{print $1}')"
  mime_hash="$(sha256sum "${MIME_FILE}" | awk '{print $1}')"

  mkdir -p "${STATE_DIR}"
  jq -n \
    --arg managerVersion "${MANAGER_VERSION}" \
    --argjson schemaVersion "${STATE_SCHEMA_VERSION}" \
    --arg devin "${original_devin}" \
    --arg windsurf "${original_windsurf}" \
    --arg workspace "${original_workspace}" \
    --arg mainPath "${MAIN_DESKTOP}" \
    --arg mainHash "${main_hash}" \
    --arg urlPath "${URL_DESKTOP}" \
    --arg urlHash "${url_hash}" \
    --arg iconPath "${ICON_FILE}" \
    --arg iconHash "${icon_hash}" \
    --arg mimePath "${MIME_FILE}" \
    --arg mimeHash "${mime_hash}" \
    --arg commandPath "${APP_COMMAND}" \
    --arg commandTarget "${CURRENT_LINK}/app/bin/devin-desktop" \
    --arg mimeDevin "${MIME_DEVIN}" \
    --arg mimeWindsurf "${MIME_WINDSURF}" \
    --arg mimeWorkspace "${MIME_WORKSPACE}" \
    '{
      schemaVersion: $schemaVersion,
      managerVersion: $managerVersion,
      originalDefaults: {
        ($mimeDevin): $devin,
        ($mimeWindsurf): $windsurf,
        ($mimeWorkspace): $workspace
      },
      managedFiles: {
        mainDesktop: {path: $mainPath, sha256: $mainHash},
        urlDesktop: {path: $urlPath, sha256: $urlHash},
        icon: {path: $iconPath, sha256: $iconHash},
        mime: {path: $mimePath, sha256: $mimeHash}
      },
      appCommand: {path: $commandPath, target: $commandTarget}
    }' >"${temporary}"
  chmod 0600 "${temporary}"
  mv -Tf -- "${temporary}" "${STATE_FILE}"
}

refresh_desktop_caches() {
  local refreshed=false

  if [[ -d "${DATA_HOME}/applications" ]]; then
    update-desktop-database "${DATA_HOME}/applications" || return 1
    refreshed=true
  fi
  if [[ -d "${DATA_HOME}/mime" ]]; then
    update-mime-database "${DATA_HOME}/mime" || return 1
    refreshed=true
  fi
  if [[ "${refreshed}" == "true" ]] &&
    command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 --noincremental >/dev/null ||
      warn "KDE cache refresh failed; log out and back in if the launcher is stale"
  fi
}

install_integration_from_stage() {
  local original_devin original_windsurf original_workspace

  if [[ "${LEGACY_CLASSIFICATION}" == "initial-complete" ]]; then
    original_devin="${LEGACY_ORIGINAL_DEVIN}"
    original_windsurf="${LEGACY_ORIGINAL_WINDSURF}"
    original_workspace="${LEGACY_ORIGINAL_WORKSPACE}"
  else
    original_devin="$(original_default "${MIME_DEVIN}")" || return 1
    original_windsurf="$(original_default "${MIME_WINDSURF}")" || return 1
    original_workspace="$(original_default "${MIME_WORKSPACE}")" || return 1
  fi

  atomic_app_link || return 1
  atomic_copy "${INTEGRATION_STAGE}/${MAIN_DESKTOP_ID}" "${MAIN_DESKTOP}" 0644 ||
    return 1
  atomic_copy "${INTEGRATION_STAGE}/${URL_DESKTOP_ID}" "${URL_DESKTOP}" 0644 ||
    return 1
  atomic_copy "${INTEGRATION_STAGE}/${ICON_NAME}.png" "${ICON_FILE}" 0644 ||
    return 1
  atomic_copy "${INTEGRATION_STAGE}/devin-desktop-manager-workspace.xml" \
    "${MIME_FILE}" 0644 || return 1
  register_associations false || return 1
  if [[ "${LEGACY_CLASSIFICATION}" == "initial-complete" ]]; then
    remove_initial_manager_associations || return 1
    verify_initial_manager_association_result \
      "${MIME_DEVIN}" "${URL_DESKTOP_ID}" "${original_devin}" \
      "${LEGACY_CURRENT_DEVIN_OWNED}" || return 1
    verify_initial_manager_association_result \
      "${MIME_WINDSURF}" "${URL_DESKTOP_ID}" "${original_windsurf}" \
      "${LEGACY_CURRENT_WINDSURF_OWNED}" || return 1
    verify_initial_manager_association_result \
      "${MIME_WORKSPACE}" "${MAIN_DESKTOP_ID}" "${original_workspace}" \
      "${LEGACY_CURRENT_WORKSPACE_OWNED}" || return 1
  fi
  remove_legacy_integration || return 1
  refresh_desktop_caches || return 1
  write_state "${original_devin}" "${original_windsurf}" "${original_workspace}"
}

snapshot_path() {
  local source="$1"
  local name="$2"

  if [[ -e "${source}" || -L "${source}" ]]; then
    cp -a -- "${source}" "${TRANSACTION_BACKUP}/${name}" || return 1
  fi
}

backup_transaction() {
  local partial="${TRANSACTION_JOURNAL}.new.$$"

  TRANSACTION_BACKUP_READY=false
  [[ ! -e "${TRANSACTION_JOURNAL}" && ! -L "${TRANSACTION_JOURNAL}" ]] ||
    die "an unfinished manager transaction requires recovery"
  [[ ! -e "${TRANSACTION_DISCARD}" && ! -L "${TRANSACTION_DISCARD}" ]] ||
    die "an unfinished manager transaction discard requires cleanup"
  [[ ! -e "${partial}" && ! -L "${partial}" ]] ||
    die "temporary transaction path already exists: ${partial}"
  TRANSACTION_BACKUP="${partial}"
  if ! mkdir -p -- "${partial}"; then
    TRANSACTION_BACKUP=""
    return 1
  fi
  chmod 0700 "${TRANSACTION_BACKUP}"
  ownership_sentinel_content >"${TRANSACTION_BACKUP}/owner" || return 1
  chmod 0600 "${TRANSACTION_BACKUP}/owner" || return 1

  snapshot_path "${CURRENT_LINK}" current || return 1
  snapshot_path "${PREVIOUS_LINK}" previous || return 1
  snapshot_path "${APP_COMMAND}" app-command || return 1
  snapshot_path "${MANAGER_COMMAND}" manager-command || return 1
  snapshot_path "${MAIN_DESKTOP}" main-desktop || return 1
  snapshot_path "${URL_DESKTOP}" url-desktop || return 1
  snapshot_path "${ICON_FILE}" icon || return 1
  snapshot_path "${MIME_FILE}" mime || return 1
  snapshot_path "${STATE_FILE}" state || return 1
  snapshot_path "${STATE_DIR}/${OWNERSHIP_SENTINEL_NAME}" state-owner || return 1
  snapshot_path "${CACHE_ROOT}/${OWNERSHIP_SENTINEL_NAME}" cache-owner || return 1
  snapshot_path "${LEGACY_MAIN_DESKTOP}" legacy-main || return 1
  snapshot_path "${LEGACY_URL_DESKTOP}" legacy-url || return 1
  snapshot_path "${LEGACY_ICON_FILE}" legacy-icon || return 1
  snapshot_path "${LEGACY_MIME_FILE}" legacy-mime || return 1
  snapshot_path "${CONFIG_HOME}/mimeapps.list" config-mimeapps || return 1
  snapshot_path "${DATA_HOME}/applications/mimeapps.list" applications-mimeapps ||
    return 1
  snapshot_path "${DATA_HOME}/mimeapps.list" data-mimeapps || return 1
  record_preserved_transaction_snapshot "${APP_COMMAND}" app-command || return 1
  record_preserved_transaction_snapshot \
    "${MANAGER_COMMAND}" manager-command || return 1
  record_preserved_transaction_snapshot "${MAIN_DESKTOP}" main-desktop ||
    return 1
  record_preserved_transaction_snapshot "${URL_DESKTOP}" url-desktop || return 1
  record_preserved_transaction_snapshot "${ICON_FILE}" icon || return 1
  record_preserved_transaction_snapshot "${MIME_FILE}" mime || return 1
  record_preserved_transaction_snapshot \
    "${LEGACY_MAIN_DESKTOP}" legacy-main || return 1
  record_preserved_transaction_snapshot \
    "${LEGACY_URL_DESKTOP}" legacy-url || return 1
  record_preserved_transaction_snapshot "${LEGACY_ICON_FILE}" legacy-icon ||
    return 1
  record_preserved_transaction_snapshot "${LEGACY_MIME_FILE}" legacy-mime ||
    return 1
  mv -T -- "${partial}" "${TRANSACTION_JOURNAL}"
  TRANSACTION_BACKUP="${TRANSACTION_JOURNAL}"
  TRANSACTION_BACKUP_READY=true
}

recover_transaction_partials() {
  local partial name pid

  for partial in "${TRANSACTION_JOURNAL}".new.*; do
    [[ -e "${partial}" || -L "${partial}" ]] || continue
    name="$(basename "${partial}")"
    pid="${name##*.new.}"
    if ! [[ "${pid}" =~ ^[0-9]+$ &&
      -d "${partial}" && ! -L "${partial}" &&
      "$(stat -c '%u' -- "${partial}" 2>/dev/null)" == "${EUID}" ]] ||
      ! transaction_directory_is_valid "${partial}"; then
      die "unfinished transaction temporary is unsafe: ${partial}"
    fi
    info "removing an orphaned transaction temporary"
    rm -rf -- "${partial}" ||
      die "could not remove orphaned transaction temporary: ${partial}"
  done
}

transaction_created_path_is_manager_owned() {
  local destination="$1"
  local name="$2"

  case "${name}" in
    current|previous)
      release_target "${destination}" >/dev/null
      ;;
    app-command)
      [[ -L "${destination}" &&
        "$(readlink "${destination}")" == \
          "${CURRENT_LINK}/app/bin/devin-desktop" ]]
      ;;
    main-desktop)
      if state_is_valid; then
        managed_file_matches_state mainDesktop "${destination}"
      else
        legacy_desktop_owned "${destination}"
      fi
      ;;
    url-desktop)
      if state_is_valid; then
        managed_file_matches_state urlDesktop "${destination}"
      else
        legacy_desktop_owned "${destination}"
      fi
      ;;
    legacy-main|legacy-url)
      legacy_desktop_owned "${destination}"
      ;;
    icon)
      if state_is_valid; then
        managed_file_matches_state icon "${destination}"
      else
        asset_matches_release "${destination}" devin-desktop.png
      fi
      ;;
    mime)
      if state_is_valid; then
        managed_file_matches_state mime "${destination}"
      else
        asset_matches_release \
          "${destination}" devin-desktop-workspace.xml
      fi
      ;;
    legacy-icon)
      asset_matches_release "${destination}" devin-desktop.png
      ;;
    legacy-mime)
      asset_matches_release \
        "${destination}" devin-desktop-workspace.xml
      ;;
    state)
      state_is_valid
      ;;
    state-owner)
      [[ "${destination}" == "${STATE_DIR}/${OWNERSHIP_SENTINEL_NAME}" ]] &&
        owned_root_is_valid "${STATE_DIR}"
      ;;
    cache-owner)
      [[ "${destination}" == "${CACHE_ROOT}/${OWNERSHIP_SENTINEL_NAME}" ]] &&
        owned_root_is_valid "${CACHE_ROOT}"
      ;;
    *)
      return 1
      ;;
  esac
}

record_preserved_transaction_snapshot() {
  local path="$1"
  local name="$2"
  local preserved="${TRANSACTION_BACKUP}/preserved"
  local marker="${preserved}/${name}"

  [[ -e "${path}" || -L "${path}" ]] || return 0
  transaction_created_path_is_manager_owned "${path}" "${name}" && return 0
  mkdir -p -- "${preserved}" || return 1
  chmod 0700 "${preserved}" || return 1
  : >"${marker}" || return 1
  chmod 0600 "${marker}"
}

record_user_configuration_result() {
  local path="$1"
  local name="$2"
  local results="${TRANSACTION_BACKUP}/results"
  local result="${results}/${name}.result"
  local temporary="${result}.new.$$"
  local hash proof

  mkdir -p -- "${results}" || return 1
  chmod 0700 "${results}" || return 1
  rm -f -- "${temporary}" || return 1
  if [[ -e "${path}" || -L "${path}" ]]; then
    [[ -f "${path}" && ! -L "${path}" ]] || return 1
    hash="$(sha256sum "${path}" | awk '{print $1}')" || return 1
    [[ "${hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
    proof="sha256 ${hash}"
  else
    proof="absent"
  fi
  if ! printf '%s\n' "${proof}" >"${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${result}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
}

record_user_configuration_results() {
  [[ -n "${TRANSACTION_BACKUP}" ]] || return 0

  record_user_configuration_result \
    "${CONFIG_HOME}/mimeapps.list" config-mimeapps || return 1
  record_user_configuration_result \
    "${DATA_HOME}/applications/mimeapps.list" applications-mimeapps || return 1
  record_user_configuration_result \
    "${DATA_HOME}/mimeapps.list" data-mimeapps
}

record_user_configuration_path_result() {
  local path="$1"

  [[ -n "${TRANSACTION_BACKUP}" ]] || return 0
  case "${path}" in
    "${CONFIG_HOME}/mimeapps.list")
      record_user_configuration_result "${path}" config-mimeapps
      ;;
    "${DATA_HOME}/applications/mimeapps.list")
      record_user_configuration_result "${path}" applications-mimeapps
      ;;
    "${DATA_HOME}/mimeapps.list")
      record_user_configuration_result "${path}" data-mimeapps
      ;;
    *)
      return 1
      ;;
  esac
}

durable_user_configuration_matches_recorded_result() {
  local destination="$1"
  local name="$2"
  local results="${TRANSACTION_BACKUP}/results"
  local result_file="${results}/${name}.result"
  local hash_file="${results}/${name}.sha256"
  local absent_file="${results}/${name}.absent"
  local proof expected_hash current_hash

  if [[ -e "${result_file}" || -L "${result_file}" ]]; then
    [[ -f "${result_file}" && ! -L "${result_file}" ]] || return 1
    proof="$(cat "${result_file}")" || return 1
    case "${proof}" in
      absent)
        [[ ! -e "${destination}" && ! -L "${destination}" ]]
        ;;
      "sha256 "*)
        expected_hash="${proof#sha256 }"
        [[ "${expected_hash}" =~ ^[0-9a-f]{64}$ &&
          -f "${destination}" && ! -L "${destination}" ]] || return 1
        current_hash="$(sha256sum "${destination}" | awk '{print $1}')" ||
          return 1
        [[ "${current_hash}" == "${expected_hash}" ]]
        ;;
      *)
        return 1
        ;;
    esac
  elif [[ -e "${hash_file}" || -L "${hash_file}" ]]; then
    [[ -f "${hash_file}" && ! -L "${hash_file}" &&
      ! -e "${absent_file}" && ! -L "${absent_file}" &&
      -f "${destination}" && ! -L "${destination}" ]] || return 1
    expected_hash="$(cat "${hash_file}")"
    [[ "${expected_hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
    current_hash="$(sha256sum "${destination}" | awk '{print $1}')" || return 1
    [[ "${current_hash}" == "${expected_hash}" ]]
  elif [[ -e "${absent_file}" || -L "${absent_file}" ]]; then
    [[ -f "${absent_file}" && ! -L "${absent_file}" &&
      ! -s "${absent_file}" &&
      ! -e "${destination}" && ! -L "${destination}" ]]
  else
    return 1
  fi
}

restore_path() {
  local destination="$1"
  local name="$2"
  local snapshot="${TRANSACTION_BACKUP}/${name}"
  local preserved="${TRANSACTION_BACKUP}/preserved/${name}"
  local parent temporary

  if [[ -e "${snapshot}" || -L "${snapshot}" ]]; then
    if [[ "${TRANSACTION_DURABLE_RECOVERY}" == "true" ]]; then
      if [[ -e "${preserved}" || -L "${preserved}" ]]; then
        [[ -f "${preserved}" && ! -L "${preserved}" &&
          ! -s "${preserved}" ]] || return 1
        return 0
      fi
      case "${name}" in
        config-mimeapps|applications-mimeapps|data-mimeapps)
          durable_user_configuration_matches_recorded_result \
            "${destination}" "${name}" || {
              [[ -f "${snapshot}" && ! -L "${snapshot}" &&
                -f "${destination}" && ! -L "${destination}" ]] || return 1
              cmp -s -- "${snapshot}" "${destination}" || return 1
              return 0
            }
          ;;
      esac
    fi
    parent="$(dirname "${destination}")"
    mkdir -p -- "${parent}" || return 1
    RESTORE_TEMP_ROOT="$(
      mktemp -d -- "${parent}/.devin-desktop-manager-restore.XXXXXXXX"
    )" || return 1
    temporary="${RESTORE_TEMP_ROOT}/payload"
    cp -a -- "${snapshot}" "${temporary}" || {
      rm -rf -- "${RESTORE_TEMP_ROOT}" || true
      RESTORE_TEMP_ROOT=""
      return 1
    }
    mv -Tf -- "${temporary}" "${destination}" || {
      rm -rf -- "${RESTORE_TEMP_ROOT}" || true
      RESTORE_TEMP_ROOT=""
      return 1
    }
    rmdir -- "${RESTORE_TEMP_ROOT}" || return 1
    RESTORE_TEMP_ROOT=""
  elif [[ -e "${destination}" || -L "${destination}" ]]; then
    case "${name}" in
      config-mimeapps|applications-mimeapps|data-mimeapps)
        if durable_user_configuration_matches_recorded_result \
          "${destination}" "${name}"; then
          rm -rf -- "${destination}" || return 1
          return 0
        fi
        ;;
    esac
    transaction_created_path_is_manager_owned "${destination}" "${name}" ||
      return 1
    rm -rf -- "${destination}" || return 1
  fi
}

transaction_directory_is_valid() {
  local root="$1"

  [[ -d "${root}" && ! -L "${root}" &&
    -f "${root}/owner" &&
    ! -L "${root}/owner" ]] || return 1
  [[ "$(cat "${root}/owner")" == "$(ownership_sentinel_content)" ]]
}

transaction_journal_is_valid() {
  transaction_directory_is_valid "${TRANSACTION_BACKUP}"
}

manager_install_root_is_valid() {
  local root="$1"
  local releases="${root}/releases"
  local current="${root}/current"
  local previous="${root}/previous"
  local entry name target release_dir
  local saw_releases=false saw_current=false saw_lock=false

  owned_root_is_valid "${root}" || return 1
  directory_can_be_listed "${root}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      "${OWNERSHIP_SENTINEL_NAME}") ;;
      releases)
        [[ -d "${entry}" && ! -L "${entry}" ]] || return 1
        saw_releases=true
        ;;
      current)
        [[ -L "${entry}" ]] || return 1
        saw_current=true
        ;;
      previous)
        [[ -L "${entry}" ]] || return 1
        ;;
      .manager.lock)
        [[ -f "${entry}" && ! -L "${entry}" ]] || return 1
        saw_lock=true
        ;;
      *) return 1 ;;
    esac
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -print0)
  [[ "${saw_releases}" == "true" && "${saw_current}" == "true" &&
    "${saw_lock}" == "true" ]] || return 1
  directory_can_be_listed "${releases}" || return 1

  for entry in "${current}" "${previous}"; do
    [[ -e "${entry}" || -L "${entry}" ]] || continue
    [[ -L "${entry}" ]] || return 1
    target="$(readlink "${entry}")"
    [[ "${target}" == releases/* && "${target}" != *"/"*"/"* ]] ||
      return 1
    is_safe_release_identifier "${target#releases/}" || return 1
    [[ -d "${root}/${target}" && ! -L "${root}/${target}" ]] || return 1
  done
  while IFS= read -r -d '' release_dir; do
    release_directory_is_owned "${release_dir}" || return 1
  done < <(find "${releases}" -mindepth 1 -maxdepth 1 -print0)
}

empty_manager_install_root_is_valid() {
  local root="$1"
  local releases="${root}/releases"
  local legacy_lock="${root}/.manager.lock"
  local entry name

  owned_root_is_valid "${root}" || return 1
  [[ -d "${releases}" && ! -L "${releases}" &&
    -f "${legacy_lock}" && ! -L "${legacy_lock}" ]] || return 1
  directory_is_empty "${releases}" || return 1
  directory_can_be_listed "${root}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      "${OWNERSHIP_SENTINEL_NAME}"|releases|.manager.lock) ;;
      *) return 1 ;;
    esac
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -print0)
  [[ ! -e "${root}/current" && ! -L "${root}/current" &&
    ! -e "${root}/previous" && ! -L "${root}/previous" ]]
}

pre_activation_manager_install_root_is_valid() {
  local root="$1"
  local releases="${root}/releases"
  local legacy_lock="${root}/.manager.lock"
  local entry name release_dir
  local saw_release=false

  owned_root_is_valid "${root}" || return 1
  [[ -d "${releases}" && ! -L "${releases}" &&
    -f "${legacy_lock}" && ! -L "${legacy_lock}" ]] || return 1
  directory_can_be_listed "${root}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    case "${name}" in
      "${OWNERSHIP_SENTINEL_NAME}"|releases|.manager.lock) ;;
      *) return 1 ;;
    esac
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -print0)
  [[ ! -e "${root}/current" && ! -L "${root}/current" &&
    ! -e "${root}/previous" && ! -L "${root}/previous" ]] || return 1
  directory_can_be_listed "${releases}" || return 1
  while IFS= read -r -d '' release_dir; do
    release_directory_is_owned "${release_dir}" || return 1
    saw_release=true
  done < <(find "${releases}" -mindepth 1 -maxdepth 1 -print0)
  [[ "${saw_release}" == "true" ]]
}

restore_staged_install_root() {
  local recorded="" device="" inode=""
  local record="${TRANSACTION_BACKUP}/staged-install-root"

  if [[ -e "${record}" || -L "${record}" ]]; then
    [[ -f "${record}" && ! -L "${record}" ]] || return 1
    jq -e '
      type == "object" and
      (keys | sort) == ["device", "inode", "stagedInstallRoot"] and
      (.stagedInstallRoot | type == "string") and
      (.device | type == "string") and
      (.device | test("^[0-9]+$")) and
      (.inode | type == "string") and
      (.inode | test("^[0-9]+$"))
    ' "${record}" >/dev/null 2>&1 || return 1
    recorded="$(jq -r '.stagedInstallRoot' "${record}")"
    device="$(jq -r '.device' "${record}")"
    inode="$(jq -r '.inode' "${record}")"
    validate_staged_install_root_path "${recorded}" || return 1
    if [[ ! -e "${recorded}" && ! -L "${recorded}" ]]; then
      [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" ]] || return 1
      [[ "$(stat -c '%d %i' -- "${INSTALL_ROOT}" 2>/dev/null)" == \
        "${device} ${inode}" ]] || return 1
      manager_install_root_is_valid "${INSTALL_ROOT}" ||
        empty_manager_install_root_is_valid "${INSTALL_ROOT}" ||
        pre_activation_manager_install_root_is_valid "${INSTALL_ROOT}" || return 1
      return 0
    fi
    [[ -d "${recorded}" && ! -L "${recorded}" ]] || return 1
    staged_install_root_identity_matches \
      "${recorded}" "${device}" "${inode}" || return 1
    if [[ "${LEGACY_LOCK_HELD}" != "true" ]]; then
      acquire_existing_legacy_lock "${recorded}/.manager.lock"
      staged_install_root_identity_matches \
        "${recorded}" "${device}" "${inode}" || return 1
    fi
    if [[ -e "${INSTALL_ROOT}" || -L "${INSTALL_ROOT}" ]]; then
      restore_staged_install_pair "${recorded}" || return 1
    else
      owned_root_is_valid "${recorded}" || return 1
      manager_install_root_is_valid "${recorded}" ||
        empty_manager_install_root_is_valid "${recorded}" ||
        pre_activation_manager_install_root_is_valid "${recorded}" || return 1
      mv -T -- "${recorded}" "${INSTALL_ROOT}" || return 1
    fi
  elif [[ -n "${STAGED_INSTALL_ROOT}" ]] &&
    [[ -e "${STAGED_INSTALL_ROOT}" || -L "${STAGED_INSTALL_ROOT}" ]]; then
    discard_unrecorded_staged_install_root "${STAGED_INSTALL_ROOT}" || return 1
  fi
  STAGED_INSTALL_ROOT=""
}

restore_transaction() {
  local failed=0

  transaction_journal_is_valid || return 1
  TRANSACTION_RESTORING=true
  if ! restore_staged_install_root; then
    TRANSACTION_RESTORING=false
    return 1
  fi
  restore_path "${ICON_FILE}" icon || failed=1
  restore_path "${MIME_FILE}" mime || failed=1
  restore_path "${LEGACY_ICON_FILE}" legacy-icon || failed=1
  restore_path "${LEGACY_MIME_FILE}" legacy-mime || failed=1
  restore_path "${CURRENT_LINK}" current || failed=1
  restore_path "${PREVIOUS_LINK}" previous || failed=1
  restore_path "${APP_COMMAND}" app-command || failed=1
  restore_path "${MANAGER_COMMAND}" manager-command || failed=1
  restore_path "${MAIN_DESKTOP}" main-desktop || failed=1
  restore_path "${URL_DESKTOP}" url-desktop || failed=1
  restore_path "${STATE_DIR}/${OWNERSHIP_SENTINEL_NAME}" state-owner || failed=1
  restore_path "${CACHE_ROOT}/${OWNERSHIP_SENTINEL_NAME}" cache-owner || failed=1
  restore_path "${STATE_FILE}" state || failed=1
  restore_path "${LEGACY_MAIN_DESKTOP}" legacy-main || failed=1
  restore_path "${LEGACY_URL_DESKTOP}" legacy-url || failed=1
  restore_path "${CONFIG_HOME}/mimeapps.list" config-mimeapps || failed=1
  restore_path "${DATA_HOME}/applications/mimeapps.list" applications-mimeapps ||
    failed=1
  restore_path "${DATA_HOME}/mimeapps.list" data-mimeapps || failed=1

  if command -v update-desktop-database >/dev/null 2>&1 &&
    command -v update-mime-database >/dev/null 2>&1; then
    update-desktop-database "${DATA_HOME}/applications" >/dev/null 2>&1 || true
    update-mime-database "${DATA_HOME}/mime" >/dev/null 2>&1 || true
  fi
  TRANSACTION_RESTORING=false
  ((failed == 0)) || return 1
  discard_transaction
}

discard_transaction() {
  if [[ -n "${TRANSACTION_BACKUP}" ]]; then
    if [[ "${TRANSACTION_BACKUP}" == "${TRANSACTION_JOURNAL}" ]]; then
      [[ ! -e "${TRANSACTION_DISCARD}" &&
        ! -L "${TRANSACTION_DISCARD}" ]] || return 1
      TRANSACTION_DISCARDING=true
      if ! mv -T -- "${TRANSACTION_JOURNAL}" "${TRANSACTION_DISCARD}"; then
        TRANSACTION_DISCARDING=false
        return 1
      fi
      TRANSACTION_BACKUP=""
      TRANSACTION_BACKUP_READY=false
      if ! rm -rf -- "${TRANSACTION_DISCARD}"; then
        warn "committed transaction discard will be finished on the next manager mutation"
      fi
      TRANSACTION_DISCARDING=false
    else
      rm -rf -- "${TRANSACTION_BACKUP}" || return 1
      TRANSACTION_BACKUP=""
      TRANSACTION_BACKUP_READY=false
    fi
  fi
  if [[ -n "${INTEGRATION_STAGE}" ]]; then
    rm -rf -- "${INTEGRATION_STAGE}" || return 1
  fi
  INTEGRATION_STAGE=""
}

recover_pending_transaction_discard() {
  [[ ! -e "${TRANSACTION_DISCARD}" &&
    ! -L "${TRANSACTION_DISCARD}" ]] && return 0
  transaction_directory_is_valid "${TRANSACTION_DISCARD}" ||
    die "unfinished transaction discard is unsafe: ${TRANSACTION_DISCARD}"
  info "finishing an interrupted transaction discard"
  rm -rf -- "${TRANSACTION_DISCARD}" ||
    die "could not finish transaction discard: ${TRANSACTION_DISCARD}"
}

recover_pending_transaction() {
  [[ ! -e "${TRANSACTION_JOURNAL}" && ! -L "${TRANSACTION_JOURNAL}" ]] ||
    {
      TRANSACTION_BACKUP="${TRANSACTION_JOURNAL}"
      TRANSACTION_BACKUP_READY=true
      TRANSACTION_DURABLE_RECOVERY=true
      warn "recovering an unfinished manager transaction"
      if ! restore_transaction; then
        TRANSACTION_DURABLE_RECOVERY=false
        die "unfinished transaction recovery failed; preserved at ${TRANSACTION_JOURNAL}"
      fi
      TRANSACTION_DURABLE_RECOVERY=false
    }
}

uninstall_cleanup_record_fields() {
  local record="$1"

  jq -er --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${OWNERSHIP_SCHEMA_VERSION}" '
      select(
        .schemaVersion == $schema_version and
        .managerId == $manager_id and
        (.stagedInstallRoot | type == "string") and
        (.device | type == "string") and
        (.device | test("^[0-9]+$")) and
        (.inode | type == "string") and
        (.inode | test("^[0-9]+$"))
      )
      | [.stagedInstallRoot, .device, .inode]
      | @tsv
    ' "${record}" 2>/dev/null
}

recover_cleanup_record_temporaries() {
  local record="$1"
  local validator="$2"
  local temporary suffix
  shift 2

  for temporary in "${record}.new."*; do
    [[ -e "${temporary}" || -L "${temporary}" ]] || continue
    suffix="${temporary##*.new.}"
    if ! [[ "${suffix}" =~ ^[0-9]+$ &&
      -f "${temporary}" && ! -L "${temporary}" &&
      "$(stat -c '%u' -- "${temporary}" 2>/dev/null)" == "${EUID}" ]] ||
      ! "${validator}" "${temporary}" "$@" >/dev/null; then
      return 1
    fi
    rm -f -- "${temporary}" || return 1
  done
}

validate_staged_install_root_path() {
  local path="$1"
  local suffix

  [[ "${path}" == "${INSTALL_ROOT}.uninstall-"* ]] || return 1
  suffix="${path#"${INSTALL_ROOT}.uninstall-"}"
  [[ "${suffix}" =~ ^[0-9]+$ ]]
}

staged_install_root_identity() {
  local staged_root="$1"
  local identity

  validate_staged_install_root_path "${staged_root}" || return 1
  [[ -d "${staged_root}" && ! -L "${staged_root}" ]] || return 1
  identity="$(stat -c '%d %i' -- "${staged_root}" 2>/dev/null)" || return 1
  [[ "${identity}" =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  printf '%s\n' "${identity}"
}

staged_install_root_identity_matches() {
  local staged_root="$1"
  local device="$2"
  local inode="$3"
  local identity

  identity="$(staged_install_root_identity "${staged_root}")" || return 1
  [[ "${identity}" == "${device} ${inode}" ]]
}

uninstall_cleanup_record_temporary_matches() {
  local record="$1"
  local expected_root="$2"
  local expected_device="$3"
  local expected_inode="$4"
  local fields staged_root device inode

  fields="$(uninstall_cleanup_record_fields "${record}")" || return 1
  IFS=$'\t' read -r staged_root device inode <<<"${fields}"
  [[ "${staged_root}" == "${expected_root}" &&
    "${device}" == "${expected_device}" &&
    "${inode}" == "${expected_inode}" ]] || return 1
  validate_staged_install_root_path "${staged_root}" || return 1
  owned_root_is_valid "${staged_root}" || return 1
  staged_install_root_identity_matches \
    "${staged_root}" "${device}" "${inode}"
}

uninstall_cleanup_record_matches_root() {
  local expected_root="$1"
  local fields recorded_root device inode

  fields="$(
    uninstall_cleanup_record_fields "${UNINSTALL_CLEANUP_RECORD}"
  )" || return 1
  IFS=$'\t' read -r recorded_root device inode <<<"${fields}"
  [[ "${recorded_root}" == "${expected_root}" ]] || return 1
  owned_root_is_valid "${recorded_root}" || return 1
  staged_install_root_identity_matches \
    "${recorded_root}" "${device}" "${inode}"
}

uninstall_cleanup_proof_is_valid() {
  [[ -f "${UNINSTALL_CLEANUP_PROOF}" &&
    ! -L "${UNINSTALL_CLEANUP_PROOF}" ]] || return 1
  [[ "$(cat "${UNINSTALL_CLEANUP_PROOF}")" == \
    "$(ownership_sentinel_content)" ]]
}

write_uninstall_cleanup_record() {
  local staged_root="$1"
  local temporary="${UNINSTALL_CLEANUP_RECORD}.new.$$"
  local identity device inode

  validate_staged_install_root_path "${staged_root}" || return 1
  owned_root_is_valid "${staged_root}" || return 1
  identity="$(staged_install_root_identity "${staged_root}")" || return 1
  read -r device inode <<<"${identity}"
  recover_cleanup_record_temporaries \
    "${UNINSTALL_CLEANUP_RECORD}" \
    uninstall_cleanup_record_temporary_matches \
    "${staged_root}" "${device}" "${inode}" || return 1
  [[ ! -e "${UNINSTALL_CLEANUP_RECORD}" &&
    ! -L "${UNINSTALL_CLEANUP_RECORD}" &&
    ! -e "${UNINSTALL_CLEANUP_PROOF}" &&
    ! -L "${UNINSTALL_CLEANUP_PROOF}" ]] || return 1
  [[ ! -e "${temporary}" && ! -L "${temporary}" ]] || return 1
  if ! jq -n \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${OWNERSHIP_SCHEMA_VERSION}" \
    --arg staged_root "${staged_root}" \
    --arg device "${device}" \
    --arg inode "${inode}" \
    '{schemaVersion: $schema_version, managerId: $manager_id, stagedInstallRoot: $staged_root, device: $device, inode: $inode}' \
    >"${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${UNINSTALL_CLEANUP_RECORD}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
}

finish_recorded_uninstall_cleanup() {
  local interrupted="$1"
  local fields staged_root device inode
  local sentinel

  [[ -f "${UNINSTALL_CLEANUP_RECORD}" &&
    ! -L "${UNINSTALL_CLEANUP_RECORD}" ]] ||
    die "unfinished uninstall cleanup record is invalid: ${UNINSTALL_CLEANUP_RECORD}"
  fields="$(
    uninstall_cleanup_record_fields "${UNINSTALL_CLEANUP_RECORD}"
  )" ||
    die "unfinished uninstall cleanup record is invalid: ${UNINSTALL_CLEANUP_RECORD}"
  IFS=$'\t' read -r staged_root device inode <<<"${fields}"
  validate_staged_install_root_path "${staged_root}" ||
    die "unfinished uninstall cleanup path is unsafe: ${staged_root}"
  if [[ -e "${UNINSTALL_CLEANUP_PROOF}" ||
    -L "${UNINSTALL_CLEANUP_PROOF}" ]]; then
    uninstall_cleanup_proof_is_valid ||
      die "unfinished uninstall cleanup proof is invalid: ${UNINSTALL_CLEANUP_PROOF}"
  fi

  if [[ ! -e "${staged_root}" && ! -L "${staged_root}" ]]; then
    if manager_install_root_is_valid "${INSTALL_ROOT}" ||
      empty_manager_install_root_is_valid "${INSTALL_ROOT}" ||
      pre_activation_manager_install_root_is_valid "${INSTALL_ROOT}"; then
      :
    else
      remove_legacy_lock_bridge ||
        die "unfinished uninstall legacy lock bridge is unsafe: ${INSTALL_ROOT}"
    fi
    rm -f -- "${UNINSTALL_CLEANUP_PROOF}" ||
      die "could not remove uninstall cleanup proof"
    rm -f -- "${UNINSTALL_CLEANUP_RECORD}" ||
      die "could not remove uninstall cleanup record"
    return 0
  fi

  [[ -d "${staged_root}" && ! -L "${staged_root}" ]] ||
    die "unfinished uninstall cleanup root is unsafe: ${staged_root}"
  staged_install_root_identity_matches \
    "${staged_root}" "${device}" "${inode}" ||
    die "unfinished uninstall cleanup root identity does not match: ${staged_root}"
  if [[ -e "${INSTALL_ROOT}" || -L "${INSTALL_ROOT}" ]]; then
    legacy_public_lock_bridge_is_valid ||
      die "unfinished uninstall legacy lock bridge is unsafe: ${INSTALL_ROOT}"
  fi
  sentinel="${staged_root}/${OWNERSHIP_SENTINEL_NAME}"

  if [[ -e "${sentinel}" || -L "${sentinel}" ]]; then
    owned_root_is_valid "${staged_root}" ||
      die "unfinished uninstall cleanup root is not manager-owned: ${staged_root}"
    if [[ ! -e "${UNINSTALL_CLEANUP_PROOF}" &&
      ! -L "${UNINSTALL_CLEANUP_PROOF}" ]]; then
      publish_cleanup_proof "${sentinel}" "${UNINSTALL_CLEANUP_PROOF}" ||
        die "could not preserve uninstall cleanup proof"
    fi
    uninstall_cleanup_proof_is_valid ||
      die "unfinished uninstall cleanup proof is invalid: ${UNINSTALL_CLEANUP_PROOF}"
    remove_directory_entries_except "${staged_root}" "${sentinel}" ||
      die "could not empty uninstall cleanup root safely: ${staged_root}"
    owned_root_is_valid "${staged_root}" ||
      die "unfinished uninstall cleanup ownership proof changed: ${staged_root}"
    staged_install_root_identity_matches \
      "${staged_root}" "${device}" "${inode}" ||
      die "unfinished uninstall cleanup root identity changed: ${staged_root}"
    rm -f -- "${sentinel}" ||
      die "could not remove uninstall cleanup ownership proof: ${sentinel}"
  else
    uninstall_cleanup_proof_is_valid ||
      die "unfinished uninstall cleanup root lost its ownership proof: ${staged_root}"
    directory_is_empty "${staged_root}" ||
      die "unfinished uninstall cleanup root contains unverified data: ${staged_root}"
  fi

  directory_is_empty "${staged_root}" ||
    die "unfinished uninstall cleanup root could not be emptied: ${staged_root}"
  staged_install_root_identity_matches \
    "${staged_root}" "${device}" "${inode}" ||
    die "unfinished uninstall cleanup root identity changed: ${staged_root}"
  if [[ "${interrupted}" == "true" ]]; then
    info "finishing an interrupted uninstall cleanup"
  fi
  rmdir -- "${staged_root}" ||
    die "could not finish uninstall cleanup: ${staged_root}"
  remove_legacy_lock_bridge ||
    die "could not remove uninstall legacy lock bridge: ${INSTALL_ROOT}"
  rm -f -- "${UNINSTALL_CLEANUP_PROOF}" ||
    die "could not remove uninstall cleanup proof"
  rm -f -- "${UNINSTALL_CLEANUP_RECORD}" ||
    die "could not remove uninstall cleanup record"
}

recover_pending_uninstall_cleanup() {
  [[ ! -e "${UNINSTALL_CLEANUP_RECORD}" &&
    ! -L "${UNINSTALL_CLEANUP_RECORD}" ]] && return 0
  require_app_stopped
  finish_recorded_uninstall_cleanup true
}

release_directory_identity() {
  local release_dir="$1"
  local identity

  [[ -d "${release_dir}" && ! -L "${release_dir}" ]] || return 1
  identity="$(stat -c '%d %i' -- "${release_dir}" 2>/dev/null)" || return 1
  [[ "${identity}" =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  printf '%s\n' "${identity}"
}

release_directory_identity_matches() {
  local release_dir="$1"
  local device="$2"
  local inode="$3"
  local identity

  identity="$(release_directory_identity "${release_dir}")" || return 1
  [[ "${identity}" == "${device} ${inode}" ]]
}

release_prune_quarantine_name() {
  local release_name="$1"
  local device="$2"
  local inode="$3"

  is_safe_release_identifier "${release_name}" || return 1
  [[ "${device}" =~ ^[0-9]+$ && "${inode}" =~ ^[0-9]+$ ]] || return 1
  printf '.release-prune-%s-%s-%s\n' "${release_name}" "${device}" "${inode}"
}

release_prune_cleanup_record_fields() {
  local record="$1"

  jq -er \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${OWNERSHIP_SCHEMA_VERSION}" '
      select(
        type == "object" and
        (keys | sort) == [
          "device",
          "inode",
          "managerId",
          "metadataSha256",
          "quarantineName",
          "releaseName",
          "schemaVersion"
        ] and
        .schemaVersion == $schema_version and
        .managerId == $manager_id and
        (.releaseName | type == "string") and
        (.quarantineName | type == "string") and
        (.device | type == "string") and
        (.device | test("^[0-9]+$")) and
        (.inode | type == "string") and
        (.inode | test("^[0-9]+$")) and
        (.metadataSha256 | type == "string") and
        (.metadataSha256 | test("^[0-9a-f]{64}$"))
      )
      | [
          .releaseName,
          .quarantineName,
          .device,
          .inode,
          .metadataSha256
        ]
      | @tsv
    ' "${record}" 2>/dev/null
}

release_prune_cleanup_record_temporary_matches() {
  local record="$1"
  local expected_release_name="$2"
  local expected_quarantine_name="$3"
  local expected_device="$4"
  local expected_inode="$5"
  local expected_metadata_sha256="$6"
  local fields release_name quarantine_name device inode metadata_sha256
  local derived_quarantine

  fields="$(release_prune_cleanup_record_fields "${record}")" || return 1
  IFS=$'\t' read -r \
    release_name quarantine_name device inode metadata_sha256 <<<"${fields}"
  [[ "${release_name}" == "${expected_release_name}" &&
    "${quarantine_name}" == "${expected_quarantine_name}" &&
    "${device}" == "${expected_device}" &&
    "${inode}" == "${expected_inode}" &&
    "${metadata_sha256}" == "${expected_metadata_sha256}" ]] || return 1
  derived_quarantine="$(
    release_prune_quarantine_name "${release_name}" "${device}" "${inode}"
  )" || return 1
  [[ "${quarantine_name}" == "${derived_quarantine}" ]]
}

write_release_prune_cleanup_record() {
  local release_name="$1"
  local device="$2"
  local inode="$3"
  local metadata_sha256="$4"
  local quarantine_name
  local temporary="${RELEASE_PRUNE_CLEANUP_RECORD}.new.$$"

  quarantine_name="$(
    release_prune_quarantine_name "${release_name}" "${device}" "${inode}"
  )" || return 1
  [[ "${metadata_sha256}" =~ ^[0-9a-f]{64}$ ]] || return 1
  recover_cleanup_record_temporaries \
    "${RELEASE_PRUNE_CLEANUP_RECORD}" \
    release_prune_cleanup_record_temporary_matches \
    "${release_name}" "${quarantine_name}" "${device}" "${inode}" \
    "${metadata_sha256}" || return 1
  [[ ! -e "${RELEASE_PRUNE_CLEANUP_RECORD}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_RECORD}" &&
    ! -e "${RELEASE_PRUNE_CLEANUP_PROOF}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_PROOF}" ]] || return 1
  [[ ! -e "${temporary}" && ! -L "${temporary}" ]] || return 1
  if ! jq -n \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${OWNERSHIP_SCHEMA_VERSION}" \
    --arg release_name "${release_name}" \
    --arg quarantine_name "${quarantine_name}" \
    --arg device "${device}" \
    --arg inode "${inode}" \
    --arg metadata_sha256 "${metadata_sha256}" \
    '{schemaVersion: $schema_version, managerId: $manager_id,
      releaseName: $release_name, quarantineName: $quarantine_name,
      device: $device, inode: $inode, metadataSha256: $metadata_sha256}' \
    >"${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${RELEASE_PRUNE_CLEANUP_RECORD}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
}

release_prune_cleanup_proof_is_valid() {
  local expected_sha256="$1"

  [[ -f "${RELEASE_PRUNE_CLEANUP_PROOF}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_PROOF}" ]] || return 1
  [[ "$(sha256sum "${RELEASE_PRUNE_CLEANUP_PROOF}" | awk '{print $1}')" == \
    "${expected_sha256}" ]]
}

release_metadata_matches_hash() {
  local release_dir="$1"
  local expected_sha256="$2"
  local metadata="${release_dir}/release.json"

  [[ -f "${metadata}" && ! -L "${metadata}" ]] || return 1
  [[ "$(sha256sum "${metadata}" | awk '{print $1}')" == \
    "${expected_sha256}" ]]
}

finish_recorded_release_prune() {
  local interrupted="$1"
  local fields release_name quarantine_name device inode metadata_sha256
  local expected_quarantine release_dir quarantine_dir relative
  local current_target previous_target metadata

  [[ -f "${RELEASE_PRUNE_CLEANUP_RECORD}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_RECORD}" ]] ||
    die "unfinished release prune record is invalid: ${RELEASE_PRUNE_CLEANUP_RECORD}"
  fields="$(
    release_prune_cleanup_record_fields "${RELEASE_PRUNE_CLEANUP_RECORD}"
  )" ||
    die "unfinished release prune record is invalid: ${RELEASE_PRUNE_CLEANUP_RECORD}"
  IFS=$'\t' read -r \
    release_name quarantine_name device inode metadata_sha256 <<<"${fields}"
  is_safe_release_identifier "${release_name}" ||
    die "unfinished release prune path is unsafe: ${release_name}"
  expected_quarantine="$(
    release_prune_quarantine_name "${release_name}" "${device}" "${inode}"
  )" || die "unfinished release prune identity is invalid"
  [[ "${quarantine_name}" == "${expected_quarantine}" ]] ||
    die "unfinished release prune quarantine is invalid: ${quarantine_name}"
  owned_root_is_valid "${INSTALL_ROOT}" ||
    die "unfinished release prune installation root is not manager-owned: ${INSTALL_ROOT}"
  [[ -d "${RELEASES_DIR}" && ! -L "${RELEASES_DIR}" ]] ||
    die "unfinished release prune directory is unsafe: ${RELEASES_DIR}"

  release_dir="${RELEASES_DIR}/${release_name}"
  quarantine_dir="${INSTALL_ROOT}/${quarantine_name}"
  metadata="${quarantine_dir}/release.json"
  relative="releases/${release_name}"
  current_target="$(release_link_target "${CURRENT_LINK}" || true)"
  previous_target="$(release_link_target "${PREVIOUS_LINK}" || true)"
  [[ "${relative}" != "${current_target}" &&
    "${relative}" != "${previous_target}" ]] ||
    die "unfinished release prune targets an active release: ${release_dir}"

  if [[ -e "${quarantine_dir}" || -L "${quarantine_dir}" ]]; then
    release_directory_identity_matches \
      "${quarantine_dir}" "${device}" "${inode}" ||
      die "unfinished release prune quarantine identity does not match: ${quarantine_dir}"
  elif [[ -e "${release_dir}" || -L "${release_dir}" ]]; then
    release_directory_identity_matches \
      "${release_dir}" "${device}" "${inode}" ||
      die "unfinished release prune directory identity does not match: ${release_dir}"
    release_directory_is_owned "${release_dir}" ||
      die "unfinished release prune directory is not a fully valid manager release: ${release_dir}"
    release_metadata_matches_hash "${release_dir}" "${metadata_sha256}" ||
      die "unfinished release prune metadata does not match: ${release_dir}"
    mv -Tn -- "${release_dir}" "${quarantine_dir}" ||
      die "could not quarantine release for pruning: ${release_dir}"
    [[ ! -e "${release_dir}" && ! -L "${release_dir}" ]] ||
      die "could not quarantine release for pruning: ${release_dir}"
    release_directory_identity_matches \
      "${quarantine_dir}" "${device}" "${inode}" ||
      die "quarantined release identity does not match: ${quarantine_dir}"
  else
    if [[ -e "${RELEASE_PRUNE_CLEANUP_PROOF}" ||
      -L "${RELEASE_PRUNE_CLEANUP_PROOF}" ]]; then
      release_prune_cleanup_proof_is_valid "${metadata_sha256}" ||
        die "unfinished release prune proof is invalid: ${RELEASE_PRUNE_CLEANUP_PROOF}"
      rm -f -- "${RELEASE_PRUNE_CLEANUP_PROOF}" ||
        die "could not remove release prune cleanup proof"
    fi
    rm -f -- "${RELEASE_PRUNE_CLEANUP_RECORD}" ||
      die "could not remove release prune cleanup record"
    return 0
  fi

  release_directory_identity_matches \
    "${quarantine_dir}" "${device}" "${inode}" ||
    die "unfinished release prune quarantine identity does not match: ${quarantine_dir}"
  if [[ ! -e "${RELEASE_PRUNE_CLEANUP_PROOF}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_PROOF}" ]]; then
    release_directory_is_owned_at_name \
      "${quarantine_dir}" "${release_name}" ||
      die "unfinished release prune quarantine is not a fully valid manager release: ${quarantine_dir}"
    release_metadata_matches_hash "${quarantine_dir}" "${metadata_sha256}" ||
      die "unfinished release prune metadata does not match: ${quarantine_dir}"
    publish_cleanup_proof "${metadata}" "${RELEASE_PRUNE_CLEANUP_PROOF}" ||
      die "could not preserve release prune cleanup proof"
  fi
  release_prune_cleanup_proof_is_valid "${metadata_sha256}" ||
    die "unfinished release prune proof is invalid: ${RELEASE_PRUNE_CLEANUP_PROOF}"
  if [[ "${interrupted}" == "true" ]]; then
    info "finishing an interrupted release prune"
  fi
  if [[ -e "${metadata}" || -L "${metadata}" ]]; then
    release_metadata_matches_hash "${quarantine_dir}" "${metadata_sha256}" ||
      die "unfinished release prune metadata changed: ${quarantine_dir}"
    remove_directory_entries_except "${quarantine_dir}" "${metadata}" ||
      die "could not empty release prune quarantine safely: ${quarantine_dir}"
    release_directory_identity_matches \
      "${quarantine_dir}" "${device}" "${inode}" ||
      die "unfinished release prune quarantine identity changed: ${quarantine_dir}"
    release_metadata_matches_hash "${quarantine_dir}" "${metadata_sha256}" ||
      die "unfinished release prune metadata changed: ${quarantine_dir}"
    rm -f -- "${metadata}" ||
      die "could not remove release prune metadata proof: ${metadata}"
  else
    directory_is_empty "${quarantine_dir}" ||
      die "unfinished release prune quarantine contains unverified data: ${quarantine_dir}"
  fi
  directory_is_empty "${quarantine_dir}" ||
    die "unfinished release prune quarantine could not be emptied: ${quarantine_dir}"
  release_directory_identity_matches \
    "${quarantine_dir}" "${device}" "${inode}" ||
    die "unfinished release prune quarantine identity changed: ${quarantine_dir}"
  rmdir -- "${quarantine_dir}" ||
    die "could not finish release prune: ${quarantine_dir}"
  rm -f -- "${RELEASE_PRUNE_CLEANUP_PROOF}" ||
    die "could not remove release prune cleanup proof"
  rm -f -- "${RELEASE_PRUNE_CLEANUP_RECORD}" ||
    die "could not remove release prune cleanup record"
}

recover_pending_release_prune() {
  [[ ! -e "${RELEASE_PRUNE_CLEANUP_RECORD}" &&
    ! -L "${RELEASE_PRUNE_CLEANUP_RECORD}" ]] && return 0
  require_app_stopped
  validate_linked_releases false
  finish_recorded_release_prune true
}

release_directory_has_ownership_metadata() {
  local release_dir="$1"

  [[ -d "${release_dir}" && ! -L "${release_dir}" &&
    -f "${release_dir}/release.json" &&
    ! -L "${release_dir}/release.json" ]] || return 1
  jq -e \
    --arg manager_id "${MANAGER_ID}" \
    --argjson schema_version "${RELEASE_METADATA_SCHEMA_VERSION}" '
    type == "object" and
    .schemaVersion == $schema_version and
    .managerId == $manager_id and
    (.windsurfVersion | type == "string") and
    (.build | type == "string") and
    (.sha256 | type == "string") and
    (.sha256 | test("^[0-9a-f]{64}$"))
  ' "${release_dir}/release.json" >/dev/null 2>&1
}

release_directory_is_owned_at_name() {
  local release_dir="$1"
  local release_name="$2"

  release_directory_has_ownership_metadata "${release_dir}" || return 1
  legacy_release_metadata_is_valid "${release_dir}" "${release_name}"
}

release_directory_is_owned() {
  local release_dir="$1"

  release_directory_is_owned_at_name \
    "${release_dir}" "$(basename "${release_dir}")"
}

validate_release_inventory_ownership() {
  local release_dir

  while IFS= read -r -d '' release_dir; do
    release_directory_has_ownership_metadata "${release_dir}" ||
      die "unowned release directory requires manual review: ${release_dir}"
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -print0)
}

validate_retained_or_reused_release() {
  local release_dir="$1"

  [[ -n "${release_dir}" ]] || return 0
  release_directory_is_owned "${release_dir}" ||
    die "retained or reused release is invalid: ${release_dir}"
}

validate_linked_releases() {
  local validate_ownership="${1:-true}"
  local current_dir previous_dir

  current_dir=""
  if [[ -e "${CURRENT_LINK}" || -L "${CURRENT_LINK}" ]]; then
    current_dir="$(release_path "${CURRENT_LINK}")" ||
      die "current release link is invalid: ${CURRENT_LINK}"
  fi
  previous_dir=""
  if [[ -e "${PREVIOUS_LINK}" || -L "${PREVIOUS_LINK}" ]]; then
    previous_dir="$(release_path "${PREVIOUS_LINK}")" ||
      die "previous release link is invalid: ${PREVIOUS_LINK}"
  fi
  [[ -n "${current_dir}" || -z "${previous_dir}" ]] ||
    die "previous release link exists without a current release: ${PREVIOUS_LINK}"
  [[ "${validate_ownership}" == "true" ]] || return 0
  validate_retained_or_reused_release "${current_dir}"
  if [[ "${previous_dir}" != "${current_dir}" ]]; then
    validate_retained_or_reused_release "${previous_dir}"
  fi
}

validate_releases_prunable_after_activation() {
  local destination="$1"
  local future_current future_previous release_dir relative

  future_current="releases/$(basename "${destination}")"
  future_previous="$(release_link_target "${CURRENT_LINK}" || true)"
  while IFS= read -r -d '' release_dir; do
    relative="releases/$(basename "${release_dir}")"
    if [[ "${relative}" != "${future_current}" &&
      "${relative}" != "${future_previous}" ]]; then
      release_directory_is_owned "${release_dir}" ||
        die "refusing to activate while an unowned release would be pruned: ${release_dir}"
    fi
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -print0)
}

prune_releases() {
  local current_target previous_target release_dir release_name relative
  local identity device inode quarantine_name quarantine_dir metadata_sha256

  current_target="$(release_link_target "${CURRENT_LINK}" || true)"
  previous_target="$(release_link_target "${PREVIOUS_LINK}" || true)"

  while IFS= read -r -d '' release_dir; do
    release_name="$(basename "${release_dir}")"
    relative="releases/${release_name}"
    if [[ "${relative}" != "${current_target}" && "${relative}" != "${previous_target}" ]]; then
      release_directory_is_owned "${release_dir}" ||
        die "refusing to prune an unowned release directory: ${release_dir}"
      info "removing superseded release ${release_name}"
      identity="$(release_directory_identity "${release_dir}")" || return 1
      read -r device inode <<<"${identity}"
      quarantine_name="$(
        release_prune_quarantine_name "${release_name}" "${device}" "${inode}"
      )" || return 1
      quarantine_dir="${INSTALL_ROOT}/${quarantine_name}"
      [[ ! -e "${quarantine_dir}" && ! -L "${quarantine_dir}" ]] ||
        die "release prune quarantine already exists: ${quarantine_dir}"
      metadata_sha256="$(
        sha256sum "${release_dir}/release.json" | awk '{print $1}'
      )" || return 1
      [[ "${metadata_sha256}" =~ ^[0-9a-f]{64}$ ]] || return 1
      write_release_prune_cleanup_record \
        "${release_name}" "${device}" "${inode}" "${metadata_sha256}" || return 1
      finish_recorded_release_prune false
    fi
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -print0)
}

activate_release() {
  local destination="$1"
  local old_target new_target

  old_target="$(release_target "${CURRENT_LINK}" || true)"
  new_target="releases/$(basename "${destination}")"

  if [[ -n "${old_target}" && "${old_target}" != "${new_target}" ]]; then
    set_managed_link "${PREVIOUS_LINK}" "${old_target}"
  fi
  set_managed_link "${CURRENT_LINK}" "${new_target}"
}

download_release() {
  local manifest="$1"
  local url sha256 version build release_id destination artifact partial actual_sha

  url="$(jq -r '.url' <<<"${manifest}")"
  sha256="$(jq -r '.sha256hash' <<<"${manifest}")"
  version="$(jq -r '.windsurfVersion' <<<"${manifest}")"
  build="$(jq -r '.version' <<<"${manifest}")"
  release_id="$(release_identifier "${version}" "${build}" "${sha256}")"
  destination="${RELEASES_DIR}/${release_id}"
  artifact="${CACHE_ROOT}/Devin-linux-x64-${release_id}.deb"
  partial="${artifact}.part"

  if [[ -d "${destination}" ]]; then
    if [[ -f "${destination}/release.json" &&
      "$(jq -r '.sha256 // empty' "${destination}/release.json")" == "${sha256}" ]]; then
      validate_release "${destination}" "${build}" \
        "$(jq -r '.productVersion' <<<"${manifest}")"
      printf '%s\n' "${destination}"
      return
    fi
    die "existing release directory does not match the official manifest: ${destination}"
  fi

  if [[ -f "${artifact}" ]]; then
    actual_sha="$(sha256sum "${artifact}" | awk '{print $1}')"
    if [[ "${actual_sha}" != "${sha256}" ]]; then
      warn "discarding a cached artifact with the wrong checksum"
      rm -f -- "${artifact}"
    fi
  fi

  if [[ ! -f "${artifact}" ]]; then
    info "downloading official Devin Desktop ${version}"
    if [[ -f "${partial}" ]]; then
      curl_fetch_file "${url}" "${partial}" 2147483648 7200 true true ||
        die "download failed; the partial file was kept for retry"
    else
      curl_fetch_file "${url}" "${partial}" 2147483648 7200 false true ||
        die "download failed; the partial file was kept for retry"
    fi
    mv -- "${partial}" "${artifact}"
  fi

  actual_sha="$(sha256sum "${artifact}" | awk '{print $1}')"
  if [[ "${actual_sha}" != "${sha256}" ]]; then
    rm -f -- "${artifact}" "${partial}"
    die "downloaded artifact failed the official SHA-256 check"
  fi

  info "verified official SHA-256 ${sha256}"
  assemble_release "${artifact}" "${manifest}" "${destination}"
  rm -f -- "${artifact}" "${partial}"
  printf '%s\n' "${destination}"
}

command_status() {
  local current_dir previous_dir

  require_commands jq readlink

  if current_dir="$(release_path "${CURRENT_LINK}")"; then
    printf 'Current:  %s\n' "$(release_label "${current_dir}")"
    printf 'Location: %s\n' "${current_dir}/app"
  else
    printf 'Current:  not installed\n'
  fi

  if previous_dir="$(release_path "${PREVIOUS_LINK}")"; then
    printf 'Previous: %s\n' "$(release_label "${previous_dir}")"
  else
    printf 'Previous: none\n'
  fi
}

command_check() {
  local manifest latest current_dir

  require_manifest_commands
  require_commands readlink
  ensure_supported_architecture
  manifest="$(fetch_manifest)"
  latest="$(jq -r '"\(.windsurfVersion) (\(.version[0:12]))"' <<<"${manifest}")"

  if manifest_matches_current "${manifest}"; then
    printf 'Current: %s\nLatest:  %s\nStatus:  up to date\n' "${latest}" "${latest}"
  elif current_dir="$(release_path "${CURRENT_LINK}")"; then
    printf 'Current: %s\nLatest:  %s\nStatus:  update available\n' \
      "$(release_label "${current_dir}")" "${latest}"
  else
    printf 'Current: not installed\nLatest:  %s\nStatus:  ready to install\n' "${latest}"
  fi
}

activate_with_integration() {
  local destination="$1"

  build_integration_stage "${destination}"
  backup_transaction

  if ! (
    activate_release "${destination}" || exit 1
    install_integration_from_stage || exit 1
  ); then
    warn "activation failed; restoring the previous release and desktop state"
    restore_transaction
    exit 1
  fi

  discard_transaction
}

command_update() {
  local manifest destination

  require_mutation_commands
  require_integration_commands
  ensure_supported_architecture
  ensure_user_namespaces
  acquire_lock
  require_app_stopped
  validate_release_inventory_ownership
  validate_linked_releases false
  manifest="$(fetch_manifest)"

  if manifest_matches_current "${manifest}"; then
    info "the active release already matches the official stable manifest"
    destination="$(release_path "${CURRENT_LINK}")"
    validate_release \
      "${destination}" \
      "$(jq -r '.version' <<<"${manifest}")" \
      "$(jq -r '.productVersion' <<<"${manifest}")"
    validate_linked_releases
    activate_with_integration "${destination}"
    command_status
    return
  fi

  reject_manifest_downgrade "${manifest}"
  validate_retained_or_reused_release \
    "$(release_path "${CURRENT_LINK}" 2>/dev/null || true)"
  destination="$(download_release "${manifest}")"
  validate_retained_or_reused_release "${destination}"
  validate_releases_prunable_after_activation "${destination}"
  activate_with_integration "${destination}"

  prune_releases
  info "official Devin Desktop installation is active"
  command_status
}

command_rollback() {
  local current_target previous_target previous_path
  local current_path metadata_build metadata_product

  require_release_commands
  require_commands flock unshare
  require_integration_commands
  ensure_supported_architecture
  ensure_user_namespaces
  acquire_lock
  require_app_stopped

  current_target="$(release_target "${CURRENT_LINK}")" ||
    die "no active release is installed"
  previous_target="$(release_target "${PREVIOUS_LINK}")" ||
    die "no previous release is available"
  current_path="${INSTALL_ROOT}/${current_target}"
  previous_path="${INSTALL_ROOT}/${previous_target}"
  validate_retained_or_reused_release "${current_path}"
  metadata_build="$(jq -r '.build // empty' "${previous_path}/release.json")"
  metadata_product="$(jq -r '.productVersion // empty' "${previous_path}/release.json")"
  validate_release "${previous_path}" "${metadata_build}" "${metadata_product}"
  validate_retained_or_reused_release "${previous_path}"
  build_integration_stage "${previous_path}"
  backup_transaction

  if ! (
    set_managed_link "${CURRENT_LINK}" "${previous_target}" || exit 1
    set_managed_link "${PREVIOUS_LINK}" "${current_target}" || exit 1
    install_integration_from_stage || exit 1
  ); then
    warn "rollback failed; restoring the prior release and desktop state"
    restore_transaction
    exit 1
  fi

  discard_transaction
  info "rollback complete"
  command_status
}

command_set_defaults() {
  require_commands jq sha256sum readlink flock
  require_integration_commands
  ensure_supported_architecture
  acquire_lock
  release_path "${CURRENT_LINK}" >/dev/null ||
    die "no active release is installed"
  ensure_integration_manageable
  state_is_valid ||
    die "desktop integration state is missing; run update first"

  backup_transaction
  if ! (
    register_associations true || exit 1
    refresh_desktop_caches || exit 1
  ); then
    warn "could not set defaults; restoring the previous desktop state"
    restore_transaction
    exit 1
  fi
  discard_transaction
  info "Devin Desktop is now the default for its URL schemes and workspace files"
}

command_doctor() {
  local current_dir metadata_build metadata_product command_target
  local handler
  local recoverable_legacy=false
  local -a failures=()
  local -a warnings=()

  require_release_commands
  require_integration_commands
  ensure_supported_architecture
  ensure_user_namespaces

  if [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" &&
    ! -e "${INSTALL_ROOT}/${OWNERSHIP_SENTINEL_NAME}" &&
    ! -L "${INSTALL_ROOT}/${OWNERSHIP_SENTINEL_NAME}" ]]; then
    if classify_markerless_layout; then
      if [[ "${LEGACY_CLASSIFICATION}" == "public-pre-activation" ]]; then
        report_recoverable_legacy_installation
        return 1
      fi
      recoverable_legacy=true
    else
      die_legacy_classification_refusal
    fi
  fi

  current_dir="$(release_path "${CURRENT_LINK}")" ||
    die "no active release is installed"
  metadata_build="$(jq -r '.build // empty' "${current_dir}/release.json")"
  metadata_product="$(jq -r '.productVersion // empty' "${current_dir}/release.json")"
  validate_release "${current_dir}" "${metadata_build}" "${metadata_product}"

  if [[ "${recoverable_legacy}" == "true" ]]; then
    report_recoverable_legacy_installation
    return 1
  fi

  [[ -L "${APP_COMMAND}" ]] || failures+=("terminal command is not a symlink")
  command_target="$(readlink -f "${APP_COMMAND}" 2>/dev/null || true)"
  [[ "${command_target}" == "${current_dir}/app/bin/devin-desktop" ]] ||
    failures+=("terminal command does not resolve through the current release")

  desktop-file-validate "${MAIN_DESKTOP}" >/dev/null 2>&1 ||
    failures+=("main desktop entry is invalid")
  desktop-file-validate "${URL_DESKTOP}" >/dev/null 2>&1 ||
    failures+=("URL desktop entry is invalid")
  managed_file_matches_state mainDesktop "${MAIN_DESKTOP}" ||
    failures+=("main desktop entry differs from manager state")
  managed_file_matches_state urlDesktop "${URL_DESKTOP}" ||
    failures+=("URL desktop entry differs from manager state")
  managed_file_matches_state icon "${ICON_FILE}" ||
    failures+=("application icon differs from manager state")
  managed_file_matches_state mime "${MIME_FILE}" ||
    failures+=("workspace MIME declaration differs from manager state")
  [[ "$(stat -c '%a' "${STATE_FILE}" 2>/dev/null || true)" == "600" ]] ||
    failures+=("manager state permissions are not 0600")

  handler="$(query_default "${MIME_DEVIN}")" || return 1
  [[ "${handler}" == "${URL_DESKTOP_ID}" ]] ||
    warnings+=("Devin URL default is ${handler:-unset}; run set-defaults to change it")
  handler="$(query_default "${MIME_WINDSURF}")" || return 1
  [[ "${handler}" == "${URL_DESKTOP_ID}" ]] ||
    warnings+=("Windsurf URL default is ${handler:-unset}; run set-defaults to change it")
  handler="$(query_default "${MIME_WORKSPACE}")" || return 1
  [[ "${handler}" == "${MAIN_DESKTOP_ID}" ]] ||
    warnings+=("workspace default is ${handler:-unset}; run set-defaults to change it")

  if ! command -v kbuildsycoca6 >/dev/null 2>&1; then
    warnings+=("KDE cache utility is not installed; this is expected on non-KDE desktops")
  fi

  if ((${#failures[@]} > 0)); then
    printf 'Installation problems:\n' >&2
    printf '  - %s\n' "${failures[@]}" >&2
    exit 1
  fi

  printf 'Healthy: %s\n' "$(release_label "${current_dir}")"
  printf 'Command: %s\n' "${APP_COMMAND}"
  printf 'Launcher: %s\n' "${MAIN_DESKTOP}"
  printf 'Sandbox: unprivileged user namespaces available\n'
  if ((${#warnings[@]} > 0)); then
    printf 'Warnings:\n' >&2
    for handler in "${warnings[@]}"; do
      printf '  - %s\n' "${handler}" >&2
    done
  fi
}

user_directory_ancestry_is_safe() {
  local directory="$1"
  local owner permissions special_mode group_mode other_mode
  local direct_parent=true

  [[ "${directory}" == /* ]] || return 1
  while :; do
    [[ -d "${directory}" && ! -L "${directory}" ]] || return 1
    owner="$(stat -c '%u' -- "${directory}" 2>/dev/null)" || return 1
    if [[ "${direct_parent}" == "true" ]]; then
      [[ "${owner}" == "${EUID}" ]] || return 1
    else
      [[ "${owner}" == 0 || "${owner}" == "${EUID}" ]] || return 1
    fi
    permissions="$(stat -c '%a' -- "${directory}" 2>/dev/null)" || return 1
    [[ "${permissions}" =~ ^[0-7]{3,4}$ ]] || return 1
    if ((${#permissions} == 4)); then
      special_mode="${permissions:0:1}"
    else
      special_mode=0
    fi
    permissions="${permissions: -3}"
    group_mode="${permissions:1:1}"
    other_mode="${permissions:2:1}"
    if (((group_mode & 2) != 0 || (other_mode & 2) != 0)); then
      [[ "${direct_parent}" != "true" ]] || return 1
      (((special_mode & 1) == 1)) || return 1
    fi
    [[ "${directory}" != / ]] || break
    directory="$(dirname "${directory}")"
    direct_parent=false
  done
}

user_file_parent_is_safe() {
  user_directory_ancestry_is_safe "$(dirname "$1")"
}

mimeapps_temporary_is_safe() {
  local temporary="$1"

  [[ -f "${temporary}" && ! -L "${temporary}" &&
    "$(stat -c '%u:%h' -- "${temporary}" 2>/dev/null)" == "${EUID}:1" ]]
}

rewrite_mimeapps_without_handler() {
  local file="$1"
  local mime_type="$2"
  local desktop_id="$3"
  local temporary

  [[ -e "${file}" || -L "${file}" ]] || return 0
  legacy_file_is_user_regular "${file}" || return 1
  user_file_parent_is_safe "${file}" || return 1
  temporary="$(mktemp -- "${file}.new.XXXXXXXX")" || return 1
  if ! mimeapps_temporary_is_safe "${temporary}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
  if ! awk -v mime="${mime_type}" -v remove_id="${desktop_id}" '
    /^\[/ { section = $0 }
    (section == "[Default Applications]" ||
      section == "[Added Associations]") && index($0, mime "=") == 1 {
      value = substr($0, length(mime) + 2)
      count = split(value, entries, ";")
      output = ""
      for (entry_index = 1; entry_index <= count; entry_index++) {
        if (entries[entry_index] != "" && entries[entry_index] != remove_id) {
          output = output entries[entry_index] ";"
        }
      }
      if (output != "") {
        print mime "=" output
      }
      next
    }
    { print }
  ' "${file}" >"${temporary}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
  if cmp -s -- "${file}" "${temporary}"; then
    rm -f -- "${temporary}" || return 1
    return 0
  fi
  if ! cp --attributes-only --preserve=all -- "${file}" "${temporary}" ||
    ! chmod --reference="${file}" "${temporary}" ||
    ! mimeapps_temporary_is_safe "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${file}"; then
    rm -f -- "${temporary}" || true
    return 1
  fi
  record_user_configuration_path_result "${file}"
}

remove_initial_manager_associations() {
  remove_handler_from_user_defaults \
    "${MIME_DEVIN}" "${LEGACY_URL_DESKTOP_ID}" || return 1
  remove_handler_from_user_defaults \
    "${MIME_WINDSURF}" "${LEGACY_URL_DESKTOP_ID}" || return 1
  remove_handler_from_user_defaults \
    "${MIME_WORKSPACE}" "${LEGACY_MAIN_DESKTOP_ID}"
}

association_matches() {
  local mime_type="$1"
  local expected="$2"
  local current

  current="$(query_default "${mime_type}")" || return 1
  [[ "${current}" == "${expected}" ]]
}

verify_association_result() {
  local mime_type="$1"
  local manager_desktop_id="$2"
  local original="$3"

  association_matches "${mime_type}" "${original:-${manager_desktop_id}}"
}

verify_initial_manager_association_result() {
  local mime_type="$1"
  local manager_desktop_id="$2"
  local original="$3"
  local current_was_owned="$4"

  if [[ "${current_was_owned}" == "true" ]]; then
    association_matches "${mime_type}" "${manager_desktop_id}"
  else
    verify_association_result \
      "${mime_type}" "${manager_desktop_id}" "${original}"
  fi
}

initial_manager_original_default_matches() {
  local mime_type="$1"
  local original="$2"
  local current

  current="$(query_default "${mime_type}")" || return 1
  is_safe_desktop_id "${current}" || return 1
  if [[ -n "${original}" ]]; then
    [[ "${current}" == "${original}" ]]
    return
  fi
  if legacy_mime_record_is_manager_id "${current}"; then
    return 1
  fi
  return 0
}

verify_initial_manager_original_defaults() {
  initial_manager_original_default_matches \
    "${MIME_DEVIN}" "${LEGACY_ORIGINAL_DEVIN}" &&
    initial_manager_original_default_matches \
      "${MIME_WINDSURF}" "${LEGACY_ORIGINAL_WINDSURF}" &&
    initial_manager_original_default_matches \
      "${MIME_WORKSPACE}" "${LEGACY_ORIGINAL_WORKSPACE}"
}

remove_handler_from_user_defaults() {
  local mime_type="$1"
  local desktop_id="$2"
  local file

  for file in \
    "${CONFIG_HOME}/mimeapps.list" \
    "${DATA_HOME}/applications/mimeapps.list" \
    "${DATA_HOME}/mimeapps.list"; do
    rewrite_mimeapps_without_handler "${file}" "${mime_type}" "${desktop_id}" ||
      return 1
  done
}

restore_one_association() {
  local mime_type="$1"
  local desktop_id="$2"
  local original="$3"
  local current

  current="$(query_default "${mime_type}")" || return 1
  if [[ "${current}" == "${desktop_id}" ]] ||
    legacy_desktop_id_owned "${current}"; then
    remove_handler_from_user_defaults "${mime_type}" "${desktop_id}" || return 1
    if [[ "${current}" != "${desktop_id}" ]]; then
      remove_handler_from_user_defaults "${mime_type}" "${current}" || return 1
    fi
    if [[ -n "${original}" ]]; then
      xdg-mime default "${original}" "${mime_type}" || return 1
      record_user_configuration_results || return 1
    fi
  else
    remove_handler_from_user_defaults "${mime_type}" "${desktop_id}" || return 1
    warn "leaving user-selected default for ${mime_type} unchanged: ${current:-unset}"
  fi
}

restore_associations() {
  local original_devin="" original_windsurf="" original_workspace=""

  if state_is_valid; then
    original_devin="$(jq -r --arg mime "${MIME_DEVIN}" \
      '.originalDefaults[$mime] // ""' "${STATE_FILE}")"
    original_windsurf="$(jq -r --arg mime "${MIME_WINDSURF}" \
      '.originalDefaults[$mime] // ""' "${STATE_FILE}")"
    original_workspace="$(jq -r --arg mime "${MIME_WORKSPACE}" \
      '.originalDefaults[$mime] // ""' "${STATE_FILE}")"
  fi

  restore_one_association "${MIME_DEVIN}" "${URL_DESKTOP_ID}" "${original_devin}" ||
    return 1
  record_user_configuration_results || return 1
  restore_one_association "${MIME_WINDSURF}" "${URL_DESKTOP_ID}" "${original_windsurf}" ||
    return 1
  record_user_configuration_results || return 1
  restore_one_association "${MIME_WORKSPACE}" "${MAIN_DESKTOP_ID}" "${original_workspace}" ||
    return 1
  record_user_configuration_results
}

remove_managed_regular_file() {
  local path="$1"
  local key="$2"
  local marker_allowed="${3:-false}"
  local release_asset="${4:-}"

  [[ -e "${path}" || -L "${path}" ]] || return 0
  if state_is_valid; then
    if managed_file_matches_state "${key}" "${path}"; then
      rm -f -- "${path}" || return 1
    else
      warn "leaving modified or non-manager-owned path in place: ${path}"
    fi
  elif [[ "${marker_allowed}" == "true" && -f "${path}" && ! -L "${path}" ]] &&
    grep -qx "${MANAGER_DESKTOP_MARKER}" "${path}"; then
    rm -f -- "${path}" || return 1
  elif [[ -n "${release_asset}" ]] &&
    asset_matches_release "${path}" "${release_asset}"; then
    rm -f -- "${path}" || return 1
  else
    warn "leaving modified or non-manager-owned path in place: ${path}"
  fi
}

remove_manager_command_if_owned() {
  [[ -e "${MANAGER_COMMAND}" || -L "${MANAGER_COMMAND}" ]] || return 0

  if [[ -L "${MANAGER_COMMAND}" ]]; then
    case "$(readlink -f "${MANAGER_COMMAND}" 2>/dev/null || true)" in
      "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)")
        rm -f -- "${MANAGER_COMMAND}" || return 1
        return 0
        ;;
    esac
  elif [[ -f "${MANAGER_COMMAND}" ]] &&
    grep -Fqx "readonly MANAGER_ID=\"${MANAGER_ID}\"" \
      "${MANAGER_COMMAND}"; then
    rm -f -- "${MANAGER_COMMAND}" || return 1
    return 0
  fi

  warn "leaving non-manager-owned command in place: ${MANAGER_COMMAND}"
}

legacy_lock_bridge_is_valid() {
  local staged_root="$1"
  local public_lock="${INSTALL_ROOT}/.manager.lock"
  local staged_lock="${staged_root}/.manager.lock"

  legacy_public_lock_bridge_is_valid || return 1
  [[ -f "${staged_lock}" && ! -L "${staged_lock}" &&
    "${public_lock}" -ef "${staged_lock}" ]]
}

legacy_public_lock_bridge_is_valid() {
  local public_lock="${INSTALL_ROOT}/.manager.lock"

  [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" &&
    -f "${public_lock}" && ! -L "${public_lock}" &&
    "${public_lock}" -ef /proc/self/fd/7 ]] || return 1
  directory_contains_only_entry "${INSTALL_ROOT}" "${public_lock}"
}

staged_install_pair_is_valid() {
  local staged_root="$1"
  local public_lock="${INSTALL_ROOT}/.manager.lock"
  local staged_lock="${staged_root}/.manager.lock"
  local root entry name target release_dir
  local sentinel="" releases="" current="" previous=""
  declare -A paths=()

  [[ -d "${INSTALL_ROOT}" && ! -L "${INSTALL_ROOT}" &&
    -d "${staged_root}" && ! -L "${staged_root}" &&
    -f "${public_lock}" && ! -L "${public_lock}" &&
    -f "${staged_lock}" && ! -L "${staged_lock}" &&
    "${public_lock}" -ef "${staged_lock}" &&
    "${public_lock}" -ef /proc/self/fd/7 ]] || return 1

  for root in "${INSTALL_ROOT}" "${staged_root}"; do
    directory_can_be_listed "${root}" || return 1
    while IFS= read -r -d '' entry; do
      name="$(basename "${entry}")"
      case "${name}" in
        .manager.lock)
          ;;
        "${OWNERSHIP_SENTINEL_NAME}"|releases|current|previous)
          [[ -z "${paths[${name}]+present}" ]] || return 1
          paths["${name}"]="${entry}"
          ;;
        *)
          return 1
          ;;
      esac
    done < <(find "${root}" -mindepth 1 -maxdepth 1 -print0)
  done

  sentinel="${paths[${OWNERSHIP_SENTINEL_NAME}]:-}"
  releases="${paths[releases]:-}"
  current="${paths[current]:-}"
  previous="${paths[previous]:-}"
  [[ -n "${sentinel}" && -f "${sentinel}" && ! -L "${sentinel}" &&
    "$(cat "${sentinel}")" == "$(ownership_sentinel_content)" &&
    -n "${releases}" && -d "${releases}" && ! -L "${releases}" ]] ||
    return 1
  [[ -n "${current}" || -z "${previous}" ]] || return 1

  for entry in "${current}" "${previous}"; do
    [[ -n "${entry}" ]] || continue
    [[ -L "${entry}" ]] || return 1
    target="$(readlink "${entry}")"
    [[ "${target}" == releases/* && "${target}" != *"/"*"/"* ]] ||
      return 1
    is_safe_release_identifier "${target#releases/}" || return 1
    [[ -d "${releases}/${target#releases/}" &&
      ! -L "${releases}/${target#releases/}" ]] || return 1
  done
  directory_can_be_listed "${releases}" || return 1
  while IFS= read -r -d '' release_dir; do
    release_directory_is_owned "${release_dir}" || return 1
  done < <(find "${releases}" -mindepth 1 -maxdepth 1 -print0)
}

restore_staged_install_pair() {
  local staged_root="$1"
  local staged_lock="${staged_root}/.manager.lock"
  local entry name destination

  staged_install_pair_is_valid "${staged_root}" || return 1
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    [[ "${name}" != ".manager.lock" ]] || continue
    destination="${INSTALL_ROOT}/${name}"
    [[ ! -e "${destination}" && ! -L "${destination}" ]] || return 1
    mv -T -- "${entry}" "${destination}" || return 1
  done < <(find "${staged_root}" -mindepth 1 -maxdepth 1 -print0)
  staged_install_pair_is_valid "${staged_root}" || return 1
  rm -f -- "${staged_lock}" || return 1
  rmdir -- "${staged_root}" || return 1
  manager_install_root_is_valid "${INSTALL_ROOT}" ||
    empty_manager_install_root_is_valid "${INSTALL_ROOT}" ||
    pre_activation_manager_install_root_is_valid "${INSTALL_ROOT}"
}

discard_unrecorded_staged_install_root() {
  local staged_root="$1"
  local staged_lock="${staged_root}/.manager.lock"
  local public_lock="${INSTALL_ROOT}/.manager.lock"

  validate_staged_install_root_path "${staged_root}" || return 1
  [[ -d "${staged_root}" && ! -L "${staged_root}" ]] || return 1
  manager_install_root_is_valid "${INSTALL_ROOT}" ||
    empty_manager_install_root_is_valid "${INSTALL_ROOT}" ||
    pre_activation_manager_install_root_is_valid "${INSTALL_ROOT}" || return 1
  if directory_is_empty "${staged_root}"; then
    rmdir -- "${staged_root}"
    return
  fi
  [[ -f "${staged_lock}" && ! -L "${staged_lock}" &&
    -f "${public_lock}" && ! -L "${public_lock}" &&
    "${staged_lock}" -ef "${public_lock}" &&
    "${public_lock}" -ef /proc/self/fd/7 ]] || return 1
  directory_contains_only_entry "${staged_root}" "${staged_lock}" || return 1
  rm -f -- "${staged_lock}" || return 1
  rmdir -- "${staged_root}"
}

create_legacy_lock_bridge() {
  local staged_root="$1"
  local public_lock="${INSTALL_ROOT}/.manager.lock"
  local staged_lock="${staged_root}/.manager.lock"

  if ! mkdir -- "${staged_root}" ||
    ! ln -- "${public_lock}" "${staged_lock}"; then
    rm -f -- "${staged_lock}" || true
    rmdir -- "${staged_root}" 2>/dev/null || true
    return 1
  fi
  [[ -f "${staged_lock}" && ! -L "${staged_lock}" &&
    "${staged_lock}" -ef "${public_lock}" &&
    "${public_lock}" -ef /proc/self/fd/7 ]] || return 1
  directory_contains_only_entry "${staged_root}" "${staged_lock}"
}

remove_legacy_lock_bridge() {
  local public_lock="${INSTALL_ROOT}/.manager.lock"

  [[ -e "${INSTALL_ROOT}" || -L "${INSTALL_ROOT}" ]] || return 0
  legacy_public_lock_bridge_is_valid || return 1
  rm -f -- "${public_lock}" || return 1
  rmdir -- "${INSTALL_ROOT}"
}

stage_install_root_for_uninstall() {
  local identity device inode
  local record temporary entry name destination

  STAGED_INSTALL_ROOT="${INSTALL_ROOT}.uninstall-$$"
  [[ ! -e "${STAGED_INSTALL_ROOT}" && ! -L "${STAGED_INSTALL_ROOT}" ]] ||
    return 1
  manager_install_root_is_valid "${INSTALL_ROOT}" ||
    empty_manager_install_root_is_valid "${INSTALL_ROOT}" ||
    pre_activation_manager_install_root_is_valid "${INSTALL_ROOT}" || return 1
  create_legacy_lock_bridge "${STAGED_INSTALL_ROOT}" || return 1
  identity="$(stat -c '%d %i' -- "${STAGED_INSTALL_ROOT}" 2>/dev/null)" ||
    return 1
  [[ "${identity}" =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  read -r device inode <<<"${identity}"
  record="${TRANSACTION_BACKUP}/staged-install-root"
  temporary="${record}.new.$$"
  [[ ! -e "${record}" && ! -L "${record}" &&
    ! -e "${temporary}" && ! -L "${temporary}" ]] || return 1
  if ! jq -n \
    --arg staged_root "${STAGED_INSTALL_ROOT}" \
    --arg device "${device}" \
    --arg inode "${inode}" \
    '{stagedInstallRoot: $staged_root, device: $device, inode: $inode}' \
    >"${temporary}" ||
    ! chmod 0600 "${temporary}" ||
    ! mv -Tf -- "${temporary}" "${record}"; then
    rm -f -- "${temporary}" || true
    discard_unrecorded_staged_install_root "${STAGED_INSTALL_ROOT}" || true
    return 1
  fi
  while IFS= read -r -d '' entry; do
    name="$(basename "${entry}")"
    [[ "${name}" != ".manager.lock" ]] || continue
    destination="${STAGED_INSTALL_ROOT}/${name}"
    [[ ! -e "${destination}" && ! -L "${destination}" ]] || return 1
    mv -T -- "${entry}" "${destination}" || return 1
  done < <(find "${INSTALL_ROOT}" -mindepth 1 -maxdepth 1 -print0)
  legacy_lock_bridge_is_valid "${STAGED_INSTALL_ROOT}" || return 1
  manager_install_root_is_valid "${STAGED_INSTALL_ROOT}" ||
    empty_manager_install_root_is_valid "${STAGED_INSTALL_ROOT}" ||
    pre_activation_manager_install_root_is_valid "${STAGED_INSTALL_ROOT}" ||
    return 1
  staged_install_root_identity_matches \
    "${STAGED_INSTALL_ROOT}" "${device}" "${inode}" || return 1
}

perform_uninstall() {
  restore_associations || return 1
  if [[ "${LEGACY_CLASSIFICATION}" == "initial-complete" ]]; then
    remove_initial_manager_associations || return 1
    verify_initial_manager_original_defaults || return 1
  fi

  if [[ -L "${APP_COMMAND}" &&
    "$(readlink "${APP_COMMAND}")" == "${CURRENT_LINK}/app/bin/devin-desktop" ]]; then
    rm -f -- "${APP_COMMAND}" || return 1
  elif [[ -e "${APP_COMMAND}" || -L "${APP_COMMAND}" ]]; then
    warn "leaving non-manager-owned command in place: ${APP_COMMAND}"
  fi

  remove_managed_regular_file "${MAIN_DESKTOP}" mainDesktop true || return 1
  remove_managed_regular_file "${URL_DESKTOP}" urlDesktop true || return 1
  remove_managed_regular_file \
    "${ICON_FILE}" icon false devin-desktop.png || return 1
  remove_managed_regular_file \
    "${MIME_FILE}" mime false devin-desktop-workspace.xml || return 1
  remove_legacy_integration || return 1
  refresh_desktop_caches || return 1
  stage_install_root_for_uninstall || return 1
  rm -rf -- "${CACHE_ROOT}" "${STATE_DIR}" || return 1
}

command_uninstall() {
  local answer="${1:-}"

  require_commands jq sha256sum readlink flock awk mktemp find
  require_integration_commands

  if [[ "${answer}" != "--yes" ]]; then
    if [[ ! -t 0 ]]; then
      die "uninstall requires an interactive terminal; use make uninstall-yes for prompt-free automation"
    fi
    printf 'Remove the managed Devin Desktop application and manager? [y/N] ' >&2
    if ! IFS= read -r answer; then
      answer=""
    fi
    while [[ "${answer}" == [[:space:]]* ]]; do answer="${answer:1}"; done
    while [[ "${answer}" == *[[:space:]] ]]; do answer="${answer:0:${#answer}-1}"; done
    [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]] || {
      info "uninstall cancelled"
      return
    }
  fi

  if [[ -n "${PUBLICATION_LOCK_FD}" ]]; then
    validate_inherited_lock_descriptor 9 "${PUBLICATION_LOCK}" "manager publication"
  else
    acquire_publication_lock
  fi
  acquire_lock
  require_app_stopped
  validate_state_or_absent
  validate_release_inventory_ownership
  validate_linked_releases

  backup_transaction
  if ! perform_uninstall; then
    warn "uninstall failed; restoring manager-owned files and desktop defaults"
    restore_transaction ||
      die "uninstall recovery failed; preserved at ${TRANSACTION_JOURNAL}"
    exit 1
  fi
  local staged_root="${STAGED_INSTALL_ROOT}"
  if ! write_uninstall_cleanup_record "${staged_root}"; then
    warn "uninstall cleanup could not be made durable; restoring the installation"
    restore_transaction ||
      die "uninstall recovery failed; preserved at ${TRANSACTION_JOURNAL}"
    exit 1
  fi
  discard_transaction ||
    die "uninstall was not durably committed; transaction journal preserved at ${TRANSACTION_JOURNAL}; recovery is required before another installation change"
  if [[ -n "${staged_root}" ]] &&
    ! uninstall_cleanup_record_matches_root "${staged_root}"; then
    warn "uninstall completed, but the old release data identity changed; cleanup record preserved at ${UNINSTALL_CLEANUP_RECORD}"
  elif [[ -n "${staged_root}" ]]; then
    finish_recorded_uninstall_cleanup false
  fi
  STAGED_INSTALL_ROOT=""
  if ! remove_manager_command_if_owned; then
    warn "could not remove the manager command; remove it manually: ${MANAGER_COMMAND}"
  fi
  info "managed application removed; Devin CLI and user configuration were preserved"
}

main() {
  local command_name
  local profile

  while (($# > 0)); do
    case "$1" in
      --publication-lock-fd)
        (($# >= 2)) || usage_die "--publication-lock-fd requires descriptor 9"
        [[ "$2" == 9 ]] || usage_die "--publication-lock-fd must be descriptor 9"
        PUBLICATION_LOCK_FD=9
        shift 2
        ;;
      --lifecycle-lock-fd)
        (($# >= 2)) || usage_die "--lifecycle-lock-fd requires descriptor 8"
        [[ "$2" == 8 ]] || usage_die "--lifecycle-lock-fd must be descriptor 8"
        LIFECYCLE_LOCK_FD=8
        shift 2
        ;;
      --legacy-lock-fd)
        (($# >= 2)) || usage_die "--legacy-lock-fd requires descriptor 7"
        [[ "$2" == 7 ]] || usage_die "--legacy-lock-fd must be descriptor 7"
        LEGACY_LOCK_FD=7
        shift 2
        ;;
      --*) break ;;
      *) break ;;
    esac
  done
  if [[ -n "${PUBLICATION_LOCK_FD}${LIFECYCLE_LOCK_FD}${LEGACY_LOCK_FD}" &&
    ( -z "${PUBLICATION_LOCK_FD}" || -z "${LIFECYCLE_LOCK_FD}" ) ]]; then
    usage_die "publication and lifecycle lock descriptors must be supplied together"
  fi
  command_name="${1:-help}"
  ACTIVE_COMMAND="${command_name}"

  case "${command_name}" in
    help|-h|--help)
      (($# <= 1)) || usage_die "help does not accept arguments"
      usage
      return
      ;;
    version|-V|--version)
      (($# == 1)) || usage_die "version does not accept arguments"
      printf 'devin-desktop-manager %s\n' "${MANAGER_VERSION}"
      return
      ;;
    internal-preflight)
      if (($# != 3)) || [[ "${2:-}" != "1" ]]; then
        usage_die "usage: devin-desktop-manager internal-preflight 1 COMMAND"
      fi
      if ! preflight_collect "${3}"; then
        usage_die "internal-preflight has an unknown command profile: ${3}"
      fi
      preflight_emit_protocol
      ((${#PREFLIGHT_KEYS[@]} == 0)) && return 0
      return 1
      ;;
  esac

  case "${command_name}" in
    install|update|status|check|rollback|set-defaults|doctor)
      (($# == 1)) || usage_die "${command_name} does not accept arguments"
      ;;
    uninstall)
      (($# <= 2)) || usage_die "uninstall accepts only --yes"
      [[ $# == 1 || "${2:-}" == "--yes" ]] ||
        usage_die "uninstall accepts only --yes"
      ;;
    uninstall-yes)
      (($# == 1)) || usage_die "uninstall-yes does not accept arguments"
      ;;
    *)
      usage >&2
      usage_die "unknown command: ${command_name}"
      ;;
  esac

  case "${command_name}" in
    install) profile=update ;;
    uninstall)
      if [[ "${2:-}" == "--yes" ]]; then
        profile=uninstall-yes
      else
        profile=uninstall
      fi
      ;;
    *) profile="${command_name}" ;;
  esac
  if ! run_public_preflight "${profile}"; then
    exit 1
  fi
  case "${profile}" in
    check|update)
      prepare_network_environment ||
        die "network trust configuration changed during preflight"
      ;;
    *) sanitize_network_environment ;;
  esac
  validate_environment
  ensure_not_root
  if [[ -n "${PUBLICATION_LOCK_FD}" && "${command_name}" != uninstall &&
    "${command_name}" != uninstall-yes ]]; then
    validate_lock_parent_security "${BIN_DIR}" "manager publication"
    validate_inherited_lock_descriptor 9 "${PUBLICATION_LOCK}" "manager publication"
  fi

  case "${command_name}" in
    install|update)
      shift
      command_update
      ;;
    status)
      shift
      command_status
      ;;
    check)
      shift
      command_check
      ;;
    rollback)
      shift
      command_rollback
      ;;
    set-defaults)
      shift
      command_set_defaults
      ;;
    doctor)
      shift
      command_doctor
      ;;
    uninstall)
      shift
      command_uninstall "${1:-}"
      ;;
    uninstall-yes)
      command_uninstall --yes
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
