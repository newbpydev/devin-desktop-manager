#!/usr/bin/env bash

set -Eeuo pipefail
export LC_ALL=C

while read -r _ _ function_name; do
  unset -f "${function_name}" 2>/dev/null || true
done < <(declare -F)

((BASH_VERSINFO[0] > 4 ||
  (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))) || {
  printf 'check-coverage: Bash 4.4 or newer is required\n' >&2
  exit 1
}

usage() {
  printf 'Usage: check-coverage RESULTSET MINIMUM_PERCENT\n' >&2
  exit 2
}

main() {
  local resultset="${1:-}"
  local minimum="${2:-}"
  local stats covered relevant percentage script_dir expected started now identity

  (($# == 2)) || usage
  script_dir="${BASH_SOURCE[0]%/*}"
  [[ "${script_dir}" != "${BASH_SOURCE[0]}" ]] || script_dir=.
  script_dir="$(CDPATH='' cd -P -- "${script_dir}" && pwd -P)"
  "${script_dir}/preflight" check-coverage
  [[ -f "${resultset}" ]] ||
    {
      printf 'check-coverage: result set is missing: %s\n' "${resultset}" >&2
      exit 1
    }
  if [[ ! "${minimum}" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    ! awk -v value="${minimum}" 'BEGIN { exit !(value >= 0 && value <= 100) }'; then
    printf 'check-coverage: minimum must be between 0 and 100\n' >&2
    exit 2
  fi

  stats="$(
    jq -er '
      [
        .[]?.coverage? | .[]? |
        if type == "array" then .[]
        elif type == "object" and (.lines? | type) == "array" then .lines[]
        else empty
        end |
        select(. != null)
      ] as $lines
      | ($lines | length) as $relevant
      | ($lines | map(select(. > 0)) | length) as $covered
      | select($relevant > 0)
      | [$covered, $relevant] | @tsv
    ' "${resultset}" 2>/dev/null
  )" ||
    {
      printf 'check-coverage: result set contains no relevant lines\n' >&2
      exit 1
    }
  IFS=$'\t' read -r covered relevant <<<"${stats}"
  expected="${COVERAGE_COMMAND_NAME:-bats-suite}"
  started="${COVERAGE_STARTED_AT:-}"
  identity="$(jq -er --arg expected "${expected}" '
    select(type == "object")
    | (keys | select(length == 1 and .[0] == $expected))
    | .[0]
  ' "${resultset}" 2>/dev/null)" || {
    printf 'check-coverage: result set has the wrong command identity: expected %s\n' \
      "${expected}" >&2
    exit 1
  }
  if [[ -n "${started}" ]]; then
    [[ "${started}" =~ ^[0-9]+$ ]] || usage
    now="$(date +%s)"
    jq -e --arg command "${identity}" --argjson started "${started}" \
      --argjson now "${now}" '
      .[$command].timestamp | type == "number" and . >= $started and . <= ($now + 1)
    ' "${resultset}" >/dev/null 2>&1 || {
      printf 'check-coverage: result set is stale for command %s\n' "${expected}" >&2
      exit 1
    }
  fi
  percentage="$(awk -v covered="${covered}" -v relevant="${relevant}" \
    'BEGIN { printf "%.2f", covered * 100 / relevant }')"

  if ! awk -v covered="${covered}" -v relevant="${relevant}" \
    -v required="${minimum}" \
    'BEGIN { exit !(covered * 100 >= required * relevant) }'; then
    printf 'check-coverage: %s%% is below required %.2f%% (%s/%s)\n' \
      "${percentage}" "${minimum}" "${covered}" "${relevant}" >&2
    exit 1
  fi

  printf 'Coverage: %s%% (%s/%s), required %.2f%%\n' \
    "${percentage}" "${covered}" "${relevant}" "${minimum}"
}

main "$@"
